o;\r\n  font-variant-numeric: tabular-nums;\r\n  color: var(--cl-text-muted);\r\n  white-space: nowrap;\r\n}\r\n.chat-list-previewDur.is-accent{\r\n  color: var(--cl-primary, #25d366);\r\n}\r\n\r\n/* Mini cartão de contato no preview da lista */\r\n.chat-list-previewLine--contact {\r\n  gap: 6px;\r\n}\r\n.chat-list-previewContact {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 6px;\r\n  min-width: 0;\r\n  flex: 1 1 auto;\r\n}\r\n.chat-list-previewContactAvatar {\r\n  width: 20px;\r\n  height: 20px;\r\n  border-radius: 50%;\r\n  object-fit: cover;\r\n  flex-shrink: 0;\r\n}\r\n.chat-list-previewContactInitials {\r\n  width: 20px;\r\n  height: 20px;\r\n  border-radius: 50%;\r\n  flex-shrink: 0;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  font-size: 10px;\r\n  font-weight: 600;\r\n  color: #fff;\r\n  background: linear-gradient(145deg, #5a6572 0%, #374151 80%);\r\n  line-height: 1;\r\n}\r\n.chat-list-previewContactText {\r\n  min-width: 0;\r\n  overflow: hidden;\r\n  text-overflow: ellipsis;\r\n  white-space: nowrap;\r\n  font-weight: 500;\r\n}\r\n\r\n.chat-list-row-mid {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: flex-start;\r\n  gap: var(--cl-space-2);\r\n}\r\n\r\n.chat-list-midLeft{\r\n  display:flex;\r\n  align-items:center;\r\n  gap:10px;\r\n  min-width:0;\r\n  flex:1;\r\n}\r\n\r\n/* Prévia + indicador (bolinha) na mesma linha, bolinha à direita do texto */\r\n.chat-list-preview-line {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 8px;\r\n  min-width: 0;\r\n  flex: 1;\r\n}\r\n\r\n.chat-list-preview {\r\n  font-size: var(--cl-font-size-sm);\r\n  color: var(--cl-text-muted);\r\n  font-weight: 400;\r\n  letter-spacing: 0.01em;\r\n  white-space: nowrap;\r\n  overflow: hidden;\r\n  text-overflow: ellipsis;\r\n  min-width: 0;\r\n  flex: 1;\r\n  opacity: 0.5;\r\n  line-height: 1.35;\r\n}\r\n\r\n.chat-list-thumb{\r\n  width:44px;\r\n  height:44px;\r\n  border-radius:10px;\r\n  overflow:hidden;\r\n  flex-shrink:0;\r\n  background: rgba(0,0,0,.08);\r\n  position:relative;\r\n}\r\n\r\n.chat-list-thumb-media{\r\n  width:100%;\r\n  height:100%;\r\n  object-fit:cover;\r\n  display:block;\r\n}\r\n\r\n.chat-list-thumb.is-video::after{\r\n  content:\"\";\r\n  position:absolute;\r\n  inset:0;\r\n  background: linear-gradient(180deg, rgba(0,0,0,0.05), rgba(0,0,0,0.25));\r\n  pointer-events:none;\r\n}\r\n\r\n.chat-list-thumb-play{\r\n  position:absolute;\r\n  left:50%;\r\n  top:50%;\r\n  transform:translate(-50%,-50%);\r\n  width:18px;\r\n  height:18px;\r\n  border-radius:999px;\r\n  background: rgba(0,0,0,.45);\r\n  color:#fff;\r\n  font-size:10px;\r\n  display:flex;\r\n  align-items:center;\r\n  justify-content:center;\r\n  pointer-events:none;\r\n}\r\n\r\n/* -----------------------------------------------------------------------\r\n   12) UNREAD BADGE\r\n----------------------------------------------------------------------- */\r\n\r\n.chat-list-unread {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  min-width: 20px;\r\n  height: 20px;\r\n  padding: 0 5px;\r\n  border-radius: var(--cl-radius-full);\r\n  background: var(--cl-chip-active);\r\n  color: #fff;\r\n  font-size: 11px;\r\n  font-weight: 500;\r\n  flex-shrink: 0;\r\n}\r\n\r\n.chat-list-row .chat-list-unread {\r\n  display: none !important;\r\n}\r\n\r\n.chat-list-atendimento-dot {\r\n  display: block;\r\n  width: 7px;\r\n  height: 7px;\r\n  border-radius: 50%;\r\n  background: #22c55e;\r\n  border: 1px solid rgba(255, 255, 255, 0.75);\r\n  flex-shrink: 0;\r\n  align-self: center;\r\n  pointer-events: none;\r\n  opacity: 0.92;\r\n  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.35);\r\n}\r\n\r\n[data-theme=\"dark\"] .chat-list-atendimento-dot {\r\n  border-color: rgba(255, 255, 255, 0.45);\r\n  background: #4ade80;\r\n  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.2);\r\n}\r\n\r\n/* Na fila “precisa responder”: ponto laranja (óbvio vs verde) + pulso suave */\r\n.chat-list-row.chat-list-row--atendimento-alerta .chat-list-atendimento-dot {\r\n  background: linear-gradient(165deg, #fb923c 0%, #ea580c 100%);\r\n  border-color: rgba(255, 255, 255, 0.55);\r\n  animation: chat-list-atendimento-dot-alert 2s ease-in-out infinite;\r\n}\r\n\r\n[data-theme=\"dark\"] .chat-list-row.chat-list-row--atendimento-alerta .chat-list-atendimento-dot {\r\n  border-color: rgba(25, 22, 18, 0.75);\r\n}\r\n\r\n@keyframes chat-list-atendimento-dot-alert {\r\n  0%,\r\n  100% {\r\n    transform: scale(1);\r\n    opacity: 1;\r\n  }\r\n  50% {\r\n    transform: scale(1.14);\r\n    opacity: 0.82;\r\n  }\r\n}\r\n\r\n@media (prefers-reduced-motion: reduce) {\r\n  .chat-list-row.chat-list-row--atendimento-alerta .chat-list-atendimento-dot {\r\n    animation: none !important;\r\n    transform: none !important;\r\n    opacity: 1 !important;\r\n  }\r\n}\r\n\r\n/* Ponto de notificação (nova mensagem não lida) */\r\n.chat-list-unread-dot {\r\n  display: inline-block;\r\n  width: 8px;\r\n  height: 8px;\r\n  border-radius: 50%;\r\n  background: var(--cl-chip-active, #25d366);\r\n  flex-shrink: 0;\r\n  margin-right: 6px;\r\n  margin-top: 1px;\r\n}\r\n\r\n/* Linha com mensagens não lidas (igual WhatsApp: destaque visual) */\r\n.chat-list-row.has-unread .chat-list-title {\r\n  font-weight: 600;\r\n}\r\n.chat-list-row.has-unread .chat-list-preview {\r\n  font-weight: 400;\r\n  opacity: 0.5;\r\n}\r\n\r\n/* -----------------------------------------------------------------------\r\n   13) TAG MINI\r\n----------------------------------------------------------------------- */\r\n\r\n.chat-list-tag-mini {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  height: 18px;\r\n  padding: 0 6px;\r\n  border-radius: var(--cl-radius-xs);\r\n  font-size: 10px;\r\n  font-weight: 500;\r\n  background: var(--cl-beige-200) !important;\r\n  color: var(--cl-text-secondary) !important;\r\n  max-width: 90px;\r\n  white-space: nowrap;\r\n  overflow: hidden;\r\n  text-overflow: ellipsis;\r\n  flex-shrink: 0;\r\n}\r\n\r\n.chat-list-tag-mini--colored {\r\n  background: transparent !important;\r\n  color: #fff !important;\r\n  max-width: 120px;\r\n}\r\n\r\n.chat-list-badge-grupo {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  height: 18px;\r\n  padding: 0 6px;\r\n  border-radius: var(--cl-radius-xs);\r\n  font-size: 10px;\r\n  font-weight: 600;\r\n  background: var(--cl-primary, #25d366) !important;\r\n  color: #fff !important;\r\n  flex-shrink: 0;\r\n}\r\n\r\n.chat-list-badge-sem-conversa {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  height: 18px;\r\n  padding: 0 6px;\r\n  border-radius: var(--cl-radius-xs);\r\n  font-size: 10px;\r\n  font-weight: 500;\r\n  background: var(--ds-surface-3);\r\n  color: var(--cl-text-muted);\r\n  flex-shrink: 0;\r\n}\r\n\r\n/* -----------------------------------------------------------------------\r\n   14) STATUS PILL\r\n----------------------------------------------------------------------- */\r\n\r\n.chat-list-status {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  gap: 3px;\r\n  min-height: 20px;\r\n  height: auto;\r\n  padding: 3px 9px;\r\n  border-radius: 999px;\r\n  font-size: 10px;\r\n  font-weight: 600;\r\n  letter-spacing: -0.02em;\r\n  white-space: nowrap;\r\n  line-height: 1.15;\r\n  border: 1px solid transparent;\r\n  max-width: none;\r\n  overflow: visible;\r\n  text-overflow: clip;\r\n}\r\n\r\n.chat-list-status-hud-prefix {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  flex-shrink: 0;\r\n  line-height: 1;\r\n}\r\n\r\n.chat-list-status-hud-text {\r\n  position: relative;\r\n  z-index: 1;\r\n  flex-shrink: 0;\r\n  min-width: 0;\r\n  overflow: visible;\r\n  text-overflow: clip;\r\n  white-space: nowrap;\r\n}\r\n\r\n/* Prefixo “Aberta” — só anima em desktop (hover:none = estático) */\r\n.chat-list-status-hud-prefix--aberta {\r\n  color: #00ff88;\r\n  font-size: 6px;\r\n  line-height: 1;\r\n  margin-right: 3px;\r\n  font-weight: 700;\r\n  opacity: 1;\r\n}\r\n\r\n.chat-list-status-hud-prefix--check {\r\n  color: #94a3b8;\r\n  font-size: 10px;\r\n  font-weight: 700;\r\n}\r\n\r\n.chat-list-status-hud-prefix--session {\r\n  color: #a5b4fc;\r\n  font-size: 9px;\r\n  font-weight: 700;\r\n}\r\n\r\n.chat-list-status-hud-prefix--dispatch {\r\n  color: #fbbf24;\r\n  font-size: 10px;\r\n}\r\n\r\n.chat-list-status-hud-prefix--cursor {\r\n  color: #c4b5fd;\r\n  font-weight: 700;\r\n  animation: chatListHudCursorBlink 0.92s steps(1, end) infinite;\r\n}\r\n\r\n/* Varredura diagonal — só ::after do badge (background-position) */\r\n@keyframes scan {\r\n  0% {\r\n    background-position: -120% 15%;\r\n  }\r\n  100% {\r\n    background-position: 220% 85%;\r\n  }\r\n}\r\n\r\n@keyframes chatListStaffBadgeGridPulse {\r\n  0%,\r\n  100% {\r\n    opacity: 0.07;\r\n  }\r\n  50% {\r\n    opacity: 0.14;\r\n  }\r\n}\r\n\r\n@keyframes chatListStaffIconHalo {\r\n  0%,\r\n  100% {\r\n    text-shadow:\r\n      0 0 3px rgba(3, 105, 161, 0.45),\r\n      0 0 8px rgba(0, 229, 255, 0.15);\r\n    filter: brightness(1);\r\n  }\r\n  50% {\r\n    text-shadow:\r\n      0 0 6px rgba(0, 229, 255, 0.75),\r\n      0 0 14px rgba(0, 229, 255, 0.35);\r\n    filter: brightness(1.2);\r\n  }\r\n}\r\n\r\n/* Aberta — bruma clara no ::after do badge (só desktop) */\r\n@keyframes chatListHudAbertaTechSweep {\r\n  0% {\r\n    background-position: 120% 50%;\r\n  }\r\n  100% {\r\n    background-position: -120% 50%;\r\n  }\r\n}\r\n\r\n@keyframes chatListAbertaPrefixSoftBlink {\r\n  0%,\r\n  100% {\r\n    opacity: 0.5;\r\n  }\r\n  50% {\r\n    opacity: 1;\r\n  }\r\n}\r\n\r\n@keyframes chatListStaffIconRadar {\r\n  0%,\r\n  100% {\r\n    opacity: 0.4;\r\n  }\r\n  50% {\r\n    opacity: 1;\r\n  }\r\n}\r\n\r\n.chat-list-status.open.chat-list-status--hud-open {\r\n  position: relative;\r\n  overflow: hidden;\r\n  justify-content: flex-start;\r\n  font-family: ui-monospace, \"SFMono-Regular\", Menlo, Monaco, Consolas, \"Libera