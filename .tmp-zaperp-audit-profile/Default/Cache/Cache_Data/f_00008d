============\r\n   RESPONSIVIDADE MOBILE — estilo WhatsApp Mobile\r\n   Cabeçalho position:fixed + --wa-mobile-header-h (JS). Só .wa-messages rola.\r\n   Avatar compacto (32px); .wa-header--atendMobile: 2 linhas — identidade+⋯ | setor+Transf./Enc.\r\n========================================================= */\r\n\r\n@media (max-width: 640px) {\r\n  /*\r\n   * Teclado aberto: encolhe o shell à área visível (evita faixa branca entre header e composer).\r\n   * Mensagens em flex:1 — não altura fixa que deixava o histórico “flutuando” acima.\r\n   */\r\n  .atendimento-layout.conversation-open .atendimento-chat-area:has(.wa-shell.wa-keyboard-visible) {\r\n    height: 100%;\r\n    max-height: none;\r\n    min-height: 0;\r\n    overflow: hidden;\r\n  }\r\n\r\n  .wa-shell.wa-keyboard-visible {\r\n    height: 100%;\r\n    max-height: none;\r\n    min-height: 0;\r\n    overflow: hidden;\r\n    padding-bottom: 0;\r\n    box-sizing: border-box;\r\n  }\r\n\r\n  .wa-shell.wa-keyboard-visible .wa-composerStack {\r\n    position: fixed;\r\n    left: 0;\r\n    right: 0;\r\n    bottom: var(--wa-keyboard-inset, 0px);\r\n    z-index: 36;\r\n    flex-shrink: 0;\r\n    margin: 0;\r\n    box-sizing: border-box;\r\n  }\r\n\r\n  .wa-shell.wa-keyboard-visible .wa-composerStack .wa-footer {\r\n    padding: 6px 12px 2px !important;\r\n    padding-left: calc(12px + env(safe-area-inset-left, 0)) !important;\r\n    padding-right: calc(12px + env(safe-area-inset-right, 0)) !important;\r\n  }\r\n\r\n  main.main-content--crm .wa-shell.wa-keyboard-visible .wa-composerStack .wa-footer {\r\n    padding-bottom: 2px !important;\r\n  }\r\n\r\n  .wa-shell.wa-keyboard-visible .wa-messages {\r\n    position: fixed;\r\n    left: 0;\r\n    right: 0;\r\n    top: calc(var(--wa-vv-top, 0px) + var(--wa-mobile-header-h, 92px));\r\n    bottom: calc(var(--wa-keyboard-inset, 0px) + var(--wa-composer-stack-h, 64px));\r\n    z-index: 1;\r\n    flex: none;\r\n    min-height: 0;\r\n    height: auto !important;\r\n    max