ex;\r\n  flex-direction: column;\r\n  height: 100%;\r\n  min-height: 0;\r\n  flex: 1 1 0%;\r\n  background: var(--wa-bg);\r\n  position: relative;\r\n  overflow: hidden;\r\n  overflow-x: hidden;\r\n  width: 100%;\r\n  max-width: 100%;\r\n}\r\n\r\n/* Cabeçalho no topo da coluna; no mobile ver @media (sticky + sem avatar) */\r\n.wa-shell .wa-header {\r\n  order: 1;\r\n  flex: 0 0 auto;\r\n  min-height: 72px;\r\n}\r\n\r\n@media (max-width: 640px) {\r\n  .wa-shell .wa-header {\r\n    min-height: 0;\r\n  }\r\n}\r\n\r\n.wa-shell .wa-messages {\r\n  order: 2;\r\n  flex: 1 1 0%;\r\n  min-height: 0;\r\n}\r\n\r\n.wa-shell .wa-composerStack {\r\n  order: 3;\r\n  flex: 0 0 auto;\r\n  display: flex;\r\n  flex-direction: column;\r\n  min-width: 0;\r\n  width: 100%;\r\n  position: relative;\r\n}\r\n\r\n.wa-shell .wa-composerStack .wa-footer {\r\n  flex: 0 0 auto;\r\n}\r\n\r\n/* =========================================================\r\n   HEADER — Compacto, fundo neutro, ações em ícones circulares translúcidos\r\n========================================================= */\r\n\r\n.wa-header {\r\n  height: auto;\r\n  min-height: 72px;\r\n  padding: 14px 14px;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  background:\r\n    linear-gradient(180deg, var(--wa-glass-surface) 0%, var(--wa-header-bg) 100%);\r\n  border-bottom: 1px solid color-mix(in srgb, var(--wa-panel-border) 84%, transparent);\r\n  box-shadow: var(--wa-header-shadow);\r\n  backdrop-filter: blur(14px);\r\n  flex-shrink: 0;\r\n  flex: 0 0 auto;\r\n  gap: 12px;\r\n  min-width: 0;\r\n  overflow: visible;\r\n  position: relative;\r\n  z-index: 10;\r\n}\r\n\r\n[data-theme=\"dark\"] .wa-header {\r\n  background: #12151f;\r\n  backdrop-filter: none;\r\n}\r\n\r\n/* Botão Voltar — visível só no mobile */\r\n.wa-header-back {\r\n  display: none;\r\n  align-items: center;\r\n  justify-content: center;\r\n  width: 40px;\r\n  height: 40px;\r\n  flex-shrink: 0;\r\n  border: none;\r\n  background: transparent;\r\n  color: var(--wa-text);\r\n  cursor: pointer;\r\n  border-radius: var(--wa-radius-sm);\r\n  padding: 0;\r\n}\r\n.wa-header-back:hover {\r\n  background: var(--ds-hover);\r\n}\r\n\r\n.wa-header-left {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 12px;\r\n  min-width: 0;\r\n  flex: 1;\r\n}\r\n\r\n.wa-avatarWrap {\r\n  flex-shrink: 0;\r\n}\r\n\r\n.wa-avatarButton {\r\n  display: block;\r\n  padding: 0;\r\n  margin: 0;\r\n  border: none;\r\n  background: transparent;\r\n  border-radius: 50%;\r\n  line-height: 0;\r\n  flex-shrink: 0;\r\n  -webkit-tap-highlight-color: transparent;\r\n}\r\n\r\n.wa-avatarButton:not(:disabled) {\r\n  cursor: zoom-in;\r\n}\r\n\r\n.wa-avatarButton:disabled {\r\n  cursor: default;\r\n  pointer-events: none;\r\n}\r\n\r\n.wa-avatar {\r\n  width: 40px;\r\n  height: 40px;\r\n  border-radius: 50%;\r\n  background: linear-gradient(145deg, #e9edef 0%, #d1d7db 100%);\r\n  color: var(--wa-text);\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  font-weight: 600;\r\n  font-size: 15px;\r\n  overflow: hidden;\r\n  border: 1px solid color-mix(in srgb, var(--wa-panel-border) 80%, transparent);\r\n  box-shadow:\r\n    0 1px 2px rgba(15, 23, 42, 0.08),\r\n    0 0 0 3px color-mix(in srgb, var(--wa-panel) 68%, transparent);\r\n}\r\n\r\n.wa-avatar-img {\r\n  width: 100%;\r\n  height: 100%;\r\n  object-fit: cover;\r\n}\r\n\r\n.wa-header-info {\r\n  min-width: 0;\r\n  display: flex;\r\n  flex-direction: column;\r\n  justify-content: center;\r\n  gap: 2px;\r\n}\r\n\r\n.wa-header-titleBlock {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 4px;\r\n  min-width: 0;\r\n}\r\n\r\n/* Bloco: primeira linha = status (pill); segunda = setor (aberta/fechada) */\r\n.wa-header-metaBlock {\r\n  display: flex;\r\n  flex-direction: column;\r\n  align-items: flex-start;\r\n  gap: 4px;\r\n  min-width: 0;\r\n  width: 100%;\r\n}\r\n\r\n.wa-header-titleRow {\r\n  display: flex;\r\n  align-items: center;\r\n  min-width: 0;\r\n  width: 100%;\r\n}\r\n\r\n.wa-header-nameRow {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 8px;\r\n  flex-wrap: wrap;\r\n  min-width: 0;\r\n}\r\n\r\n.wa-header-name {\r\n  font-size: 14px;\r\n  font-weight: 650;\r\n  color: var(--wa-text);\r\n  line-height: 1.3;\r\n  white-space: nowrap;\r\n  overflow: hidden;\r\n  text-overflow: ellipsis;\r\n  max-width: 320px;\r\n  letter-spacing: 0;\r\n  flex: 1 1 auto;\r\n  min-width: 0;\r\n}\r\n\r\n.wa-header-searchNameBtn {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  width: 30px;\r\n  height: 30px;\r\n  min-width: 30px;\r\n  margin-left: 6px;\r\n  padding: 0;\r\n  border: none;\r\n  border-radius: 999px;\r\n  background: transparent;\r\n  color: var(--wa-text-muted);\r\n  cursor: pointer;\r\n  transition: background var(--ds-transition), color var(--ds-transition), transform 0.15s ease;\r\n}\r\n\r\n.wa-header-searchNameBtn:hover:not(:disabled),\r\n.wa-header-searchNameBtn:focus-visible {\r\n  background: color-mix(in srgb, var(--wa-green) 9%, var(--wa-panel));\r\n  color: var(--wa-text);\r\n  outline: none;\r\n}\r\n\r\n.wa-header-searchNameBtn:active:not(:disabled) {\r\n  transform: scale(0.96);\r\n}\r\n\r\n.wa-header-searchNameBtn:disabled {\r\n  opacity: 0.45;\r\n  cursor: not-allowed;\r\n}\r\n\r\n/* Linha secundária: status + setor (CRM) */\r\n.wa-header-metaStrip {\r\n  display: flex;\r\n  align-items: center;\r\n  flex-wrap: wrap;\r\n  gap: 6px 8px;\r\n  min-width: 0;\r\n  /* Altura mínima + respiro vertical: evita cortar bordas do pill com overflow-y do strip */\r\n  min-height: 30px;\r\n  padding-top: 3px;\r\n  padding-bottom: 3px;\r\n  box-sizing: border-box;\r\n}\r\n\r\n.wa-header-metaSep {\r\n  width: 4px;\r\n  height: 4px;\r\n  border-radius: 50%;\r\n  background: var(--wa-text-muted);\r\n  opacity: 0.45;\r\n  flex-shrink: 0;\r\n}\r\n\r\n.wa-header-metaItem {\r\n  font-size: 12px;\r\n  line-height: 1.25;\r\n  color: var(--wa-text-muted);\r\n  min-width: 0;\r\n  overflow: hidden;\r\n  text-overflow: ellipsis;\r\n  white-space: nowrap;\r\n  max-width: min(100%, 240px);\r\n}\r\n\r\n.wa-header-whatsappInstance {\r\n  color: var(--wa-accent);\r\n  font-weight: 700;\r\n}\r\n\r\n/* Desktop: status em uma linha; largura máx. só limita o strip (scroll), não “esprema” o pill */\r\n@media (min-width: 641px) {\r\n  .wa-status-pill--meta {\r\n    max-width: none;\r\n    flex-shrink: 0;\r\n    overflow: visible;\r\n    text-overflow: clip;\r\n    white-space: nowrap;\r\n  }\r\n}\r\n@media (min-width: 1025px) {\r\n  .wa-status-pill--meta {\r\n    max-width: none;\r\n    flex-shrink: 0;\r\n    overflow: visible;\r\n    text-overflow: clip;\r\n    white-space: nowrap;\r\n  }\r\n}\r\n\r\n/* Setor (departamento) + botão Transferir — discreto */\r\n.wa-header-setorRow {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 8px;\r\n  flex-wrap: wrap;\r\n  margin-top: 1px;\r\n}\r\n\r\n/* Linha dedicada de setor — divisor full-width (nome/ações | setor) */\r\n@media (min-width: 641px) {\r\n  .wa-header.wa-header--setorBelow {\r\n    display: grid;\r\n    grid-template-columns: auto minmax(0, 1fr) auto;\r\n    grid-template-rows: auto auto;\r\n    align-items: center;\r\n    column-gap: 12px;\r\n    row-gap: 0;\r\n    min-height: 0;\r\n    padding: 10px 14px 6px;\r\n  }\r\n\r\n  .wa-shell .wa-header.wa-header--setorBelow {\r\n    min-height: 0;\r\n  }\r\n\r\n  .wa-header.wa-header--setorBelow .wa-header-back {\r\n    grid-column: 1;\r\n    grid-row: 1;\r\n  }\r\n\r\n  .wa-header.wa-header--setorBelow .wa-header-left {\r\n    grid-column: 2;\r\n    grid-row: 1;\r\n    min-width: 0;\r\n    align-self: center;\r\n  }\r\n\r\n  .wa-header.wa-header--setorBelow .wa-header-right {\r\n    grid-column: 3;\r\n    grid-row: 1;\r\n    align-self: center;\r\n  }\r\n\r\n  .wa-header.wa-header--setorBelow > .wa-header-setorRow {\r\n    grid-column: 1 / -1;\r\n    grid-row: 2;\r\n    display: flex;\r\n    align-items: center;\r\n    gap: 6px;\r\n    flex-wrap: wrap;\r\n    width: auto;\r\n    min-height: 28px;\r\n    margin: 6px -14px 0;\r\n    padding: 5px 14px 0;\r\n    border-top: 1px solid color-mix(in srgb, var(--wa-panel-border) 72%, transparent);\r\n    box-sizing: border-box;\r\n  }\r\n\r\n  [data-theme=\"dark\"] .wa-header.wa-header--setorBelow > .wa-header-setorRow {\r\n    border-top-color: rgba(255, 255, 255, 0.12);\r\n  }\r\n\r\n  .wa-header.wa-header--setorBelow .wa-header-setorLabel {\r\n    font-size: 11px;\r\n    font-weight: 500;\r\n    color: var(--wa-text-muted);\r\n    flex-shrink: 0;\r\n    line-height: 1.2;\r\n  }\r\n\r\n  .wa-header.wa-header--setorBelow .wa-header-setorRow .wa-header-metaItem,\r\n  .wa-header.wa-header--setorBelow .wa-header-setorRow .wa-header-setorBtn {\r\n    font-size: 11px;\r\n    line-height: 1.2;\r\n  }\r\n\r\n  .wa-header.wa-header--setorBelow .wa-header-setorRow .wa-header-setorBtn {\r\n    padding: 2px 8px;\r\n  }\r\n\r\n  .wa-header.wa-header--setorBelow .wa-header-setorRow:has(.wa-header-setorBtn) .wa-header-metaItem.wa-muted {\r\n    display: inline;\r\n  }\r\n}\r\n\r\n.wa-header-setor {\r\n  font-size: 12px;\r\n  color: var(--wa-text-muted);\r\n}\r\n\r\n.wa-header-setorBtn {\r\n  font-size: 12px;\r\n  padding: 3px 9px;\r\n  border-radius: 999px;\r\n  border: 1px solid color-mix(in srgb, var(--wa-panel-border) 80%, transparent);\r\n  background: color-mix(in srgb, var(--wa-panel) 82%, transparent);\r\n  color: var(--wa-text-muted);\r\n  cursor: pointer;\r\n  box-shadow: inset 0 1px 0 color-mix(in srgb, #ffffff 18%, transparent);\r\n  transition: background var(--ds-transition), color var(--ds-transition), border-color var(--ds-transition);\r\n}\r\n\r\n.wa-header-setorBtn:hover {\r\n  background: color-mix(in srgb, var(--wa-green) 9%, var(--wa-panel));\r\n  border-color: color-mix(in srgb, var(--wa-green) 28%, var(--wa-panel-border));\r\n  color: var(--wa-text);\r\n}\r\n\r\n/* Indicador \"digitando...\" com reticências animadas */\r\n.wa-header-typingRow {\r\n  margin-top: 2px;\r\n  min-height: 16px;\r\n}\r\n\r\n.wa-typing-dots {\r\n  font-size: 12px;\r\n  color: var(--wa-text-muted);\r\n}\r\n\r\n.wa-typing-dots-inner {\r\n  display: inline;\r\n}\r\n\r\n.wa-typing-dots-inner .wa-typing-dot {\r\n  animation: wa-typing-blink 1.2s ease-in-out infinite;\r\n}\r\n\r\n.wa-typing-dots-inner .wa-typing-dot:nth-child(2) { animation-delay: 0.2s; }\r\n.wa-typing-dots-inner .wa-typing-dot:nth-child(3) { animation-delay: 0.4s; }\r\n\r\n@keyframes wa-typing-blink {\r\n  0%, 60%, 100% { opacity: 0.35; }\r\n  30% { opacity: 1; }\r\n}\r\n\r\n/* ---- Animações premium (WhatsApp+ / inovadoras) ---- */\r\n@keyframes wa-panelAppear {\r\n  from { opacity: 0; transform: translateY(-6px); }\r\n  to { opacity: 1; transform: translateY(0); }\r\n}\r\n\r\n@keyframes wa-sheetSlideUp {\r\n  from {\r\n    opacity: 0;\r\n    transform: translateY(14px);\r\n  }\r\n  to {\r\n    opacity: 1;\r\n    transform: translateY(0);\r\n  }\r\n}\r\n@keyframes wa-overlayFade {\r\n  from { opacity: 0; }\r\n  to { opacity: 1; }\r\n}\r\n@keyframes wa-modalScale {\r\n  from { opacity: 0; transform: scale(0.96); }\r\n  to { opacity: 1; transform: scale(1); }\r\n}\r\n@keyframes wa-popIn {\r\n  from { opacity: 0; transform: scale(0.92); }\r\n  to { opacity: 1; transform: scale(1); }\r\n}\r\n@keyframes wa-dayPillFade {\r\n  from { opacity: 0; transform: translateY(4px); }\r\n  to { opacity: 1; transform: translateY(0); }\r\n}\r\n@keyframes wa-replyBarSlide {\r\n  from { opacity: 0; transform: translateY(6px); }\r\n  to { opacity: 1; transform: translateY(0); }\r\n}\r\n@keyframes wa-dropOverlayFade {\r\n  from { opacity: 0; }\r\n  to { opacity: 1; }\r\n}\r\n@keyframes wa-dropCardScale {\r\n  from { opacity: 0; transform: scale(0.95); }\r\n  to { opacity: 1; transform: scale(1); }\r\n}\r\n@keyframes wa-menuFade {\r\n  from { opacity: 0; transform: translateY(-4px); }\r\n  to { opacity: 1; transform: translateY(0); }\r\n}\r\n@keyframes wa-checkPop {\r\n  0% { transform: scale(0); opacity: 0; }\r\n  60% { transform: scale(1.15); opacity: 1; }\r\n  100% { transform: scale(1); opacity: 1; }\r\n}\r\n@keyframes wa-tickPulse {\r\n  0%, 100% { opacity: 1; transform: scale(1); }\r\n  50% { opacity: 0.85; transform: scale(1.05); }\r\n}\r\n\r\n/* Status — pill discreto (sem backdrop-filter: evita fundo “cortado” com overflow / isolation no header) */\r\n.wa-status-pill {\r\n  min-height: 24px;\r\n  height: auto;\r\n  padding: 4px 11px;\r\n  box-sizing: border-box;\r\n\r\n  border-radius: 999px;\r\n\r\n  font-size: 11px;\r\n  font-weight: 600;\r\n  line-height: 1.2;\r\n\r\n  display: inline-flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  white-space: nowrap;\r\n\r\n  background: color-mix(in srgb, var(--wa-green) 12%, var(--wa-panel));\r\n  color: var(--wa-green);\r\n\r\n  border: 1px solid color-mix(in srgb, var(--wa-green) 24%, transparent);\r\n  box-shadow: inset 0 1px 0 color-mix(in srgb, #ffffff 18%, transparent);\r\n}\r\n\r\n/* Pill do cabeçalho: nunca encolher no flex (evita meia-lua / círculo cortado) */\r\n.wa-header-metaStrip .wa-status-pill--meta {\r\n  flex-shrink: 0;\r\n  width: max-content;\r\n  max-width: none;\r\n  min-width: min-content;\r\n  overflow: visible;\r\n  white-space: nowrap;\r\n}\r\n\r\n/* Aberta — verde escuro, pill compacta */\r\n.wa-status-pill--aberta,\r\n.wa-header-metaStrip .wa-status-pill--meta.wa-status-pill--aberta {\r\n  min-height: 20px;\r\n  padding: 2px 8px;\r\n  font-size: 10px;\r\n  font-weight: 600;\r\n  line-height: 1.2;\r\n  letter-spacing: 0.02em;\r\n  background: rgba(6, 95, 70, 0.22);\r\n  color: #047857;\r\n  border: 1px solid rgba(6, 95, 70, 0.38);\r\n  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.1);\r\n}\r\n\r\n[data-theme=\"dark\"] .wa-status-pill--aberta,\r\n[data-theme=\"dark\"] .wa-header-metaStrip .wa-status-pill--meta.wa-status-pill--aberta {\r\n  background: rgba(6, 78, 59, 0.55);\r\n  color: #6ee7b7;\r\n  border-color: rgba(16, 185, 129, 0.24);\r\n  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.05);\r\n}\r\n\r\n.wa-header-statusStack {\r\n  display: flex;\r\n  flex-direction: column;\r\n  align-items: center;\r\n  gap: 3px;\r\n  min-width: 0;\r\n  max-width: 100%;\r\n}\r\n\r\n.wa-header-metaStrip .wa-status-pill--pagamento-concluido-sub {\r\n  flex-shrink: 0;\r\n  max-width: 11rem;\r\n  overflow: visible;\r\n  white-space: nowrap;\r\n  font-size: 0.625rem;\r\n  font-weight: 600;\r\n  line-height: 1.2;\r\n  padding: 2px 10px 3px;\r\n  border-radius: 999px;\r\n  text-align: center;\r\n  color: #92400e;\r\n  border: 1px solid color-mix(in srgb, #ca8a04 42%, #fde047);\r\n  background: linear-gradient(\r\n    165deg,\r\n    color-mix(in srgb, #fffbeb 92%, #fef9c3) 0%,\r\n    color-mix(in srgb, #fef3c7 78%, #fde68a) 100%\r\n  );\r\n  box-shadow:\r\n    inset 0 1px 0 color-mix(in srgb, #fff 70%, transparent),\r\n    0 1px 4px -1px color-mix(in srgb, #ca8a04 26%, transparent);\r\n}\r\n\r\n[data-theme=\"dark\"] .wa-header-metaStrip .wa-status-pill--pagamento-concluido-sub {\r\n  color: #fef08a;\r\n  border-color: color-mix(in srgb, #eab308 48%, #fde047);\r\n  background: linear-gradient(\r\n    165deg,\r\n    color-mix(in srgb, #422006 70%, #713f12) 0%,\r\n    color-mix(in srgb, #78350f 62%, #854d0e) 100%\r\n  );\r\n  box-shadow:\r\n    inset 0 1px 0 color-mix(in srgb, #fff 12%, transparent),\r\n    0 0 10px -2px color-mix(in srgb, #eab308 32%, transparent);\r\n}\r\n\r\n.wa-header-right {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 4px;\r\n  flex-shrink: 0;\r\n  min-width: 0;\r\n}\r\n\r\n/* Linha de ferramentas + ações CRM — desktop em uma fileira; mobile em grid (ver @media) */\r\n.wa-header-innerRow {\r\n  display: flex;\r\n  flex-direction: row;\r\n  flex-wrap: wrap;\r\n  align-items: center;\r\n  gap: 4px;\r\n  min-width: 0;\r\n}\r\n\r\n.wa-header-iconsLine {\r\n  display: contents;\r\n}\r\n\r\n.wa-header-actionsRow {\r\n  display: flex;\r\n  align-items: center;\r\n  min-width: 0;\r\n}\r\n\r\n.wa-header-actionsRow .wa-actions {\r\n  min-width: 0;\r\n}\r\n\r\n/* CRM no mobile: ação principal + menu (⋯) com tags, histórico e demais ações */\r\n.wa-atendToolbar-prepend {\r\n  display: flex;\r\n  align-items: center;\r\n  flex-shrink: 0;\r\n  gap: 2px;\r\n}\r\n\r\n.wa-atendToolbar--compact {\r\n  display: flex;\r\n  flex-direction: row;\r\n  align-items: center;\r\n  gap: 8px;\r\n  position: relative;\r\n  flex-shrink: 0;\r\n}\r\n\r\n.wa-atendToolbar-primaryRow {\r\n  display: flex;\r\n  flex-direction: row;\r\n  flex-wrap: wrap;\r\n  align-items: center;\r\n  gap: 6px;\r\n  flex: 1 1 auto;\r\n  min-width: 0;\r\n}\r\n\r\n.wa-atendToolbar-overflowWrap {\r\n  position: relative;\r\n}\r\n\r\n.wa-header-moreWrap {\r\n  position: relative;\r\n  flex-shrink: 0;\r\n}\r\n\r\n.wa-header-moreDropdown {\r\n  top: calc(100% + 6px);\r\n  right: 0;\r\n  left: auto;\r\n  z-index: 50;\r\n}\r\n\r\n.wa-atendToolbar-backdrop {\r\n  position: fixed;\r\n  inset: 0;\r\n  z-index: 36;\r\n  background: rgba(0, 0, 0, 0.18);\r\n}\r\n\r\n[data-theme=\"dark\"] .wa-atendToolbar-backdrop {\r\n  background: rgba(0, 0, 0, 0.42);\r\n}\r\n\r\n.wa-atendToolbar-dropdown {\r\n  position: absolute;\r\n  top: calc(100% + 6px);\r\n  right: 0;\r\n  left: auto;\r\n  min-width: min(86vw, 272px);\r\n  max-width: min(94vw, 320px);\r\n  padding: 6px 0;\r\n  border-radius: 14px;\r\n  background: var(--ds-surface-1);\r\n  border: 1px solid var(--wa-panel-border);\r\n  box-shadow: 0 14px 44px rgba(0, 0, 0, 0.16);\r\n  z-index: 50;\r\n}\r\n\r\n/* Tablet/mobile: menu ⋯ renderizado em portal (evita ficar atrás do thread por overflow/isolation) */\r\n.wa-atendToolbar-backdrop--portal {\r\n  position: fixed;\r\n  inset: 0;\r\n  z-index: 120;\r\n}\r\n\r\n.wa-atendToolbar-dropdown--portal {\r\n  position: fixed;\r\n  left: auto;\r\n  z-index: 121;\r\n}\r\n\r\n.wa-atendToolbar-menuExtras {\r\n  display: flex;\r\n  flex-direction: column;\r\n  padding: 4px 6px 6px;\r\n  gap: 2px;\r\n}\r\n\r\n.wa-atendToolbar-menuDivider {\r\n  height: 1px;\r\n  margin: 4px 10px;\r\n  background: var(--wa-panel-border);\r\n  border: none;\r\n}\r\n\r\n.wa-atendToolbar-sheetBtn {\r\n  display: flex;\r\n  flex-direction: row;\r\n  align-items: center;\r\n  gap: 12px;\r\n  width: 100%;\r\n  min-height: 48px;\r\n  padding: 10px 12px;\r\n  border: none;\r\n  border-radius: 11px;\r\n  background: transparent;\r\n  color: var(--wa-text);\r\n  font-size: 15px;\r\n  font-weight: 500;\r\n  text-align: left;\r\n  cursor: pointer;\r\n  transition: background 0.15s ease;\r\n  touch-action: manipulation;\r\n}\r\n\r\n.wa-atendToolbar-sheetBtn:hover:not(:disabled) {\r\n  background: var(--ds-hover);\r\n}\r\n\r\n.wa-atendToolbar-sheetBtn:disabled {\r\n  opacity: 0.45;\r\n  cursor: not-allowed;\r\n}\r\n\r\n.wa-atendToolbar-sheetIcon {\r\n  display: inline-flex;\r\n  flex-shrink: 0;\r\n  color: var(--wa-text-muted);\r\n}\r\n\r\n.wa-atendToolbar-sheetLabel {\r\n  flex: 1;\r\n  min-width: 0;\r\n}\r\n\r\n.wa-atendToolbar-menuAction.wa-btn-primary,\r\n.wa-atendToolbar-menuAction.wa-btn-transferir,\r\n.wa-atendToolbar-menuAction.wa-btn-danger,\r\n.wa-atendToolbar-menuAction.wa-btn-secondary,\r\n.wa-atendToolbar-menuAction.wa-btn-aguardar-cliente {\r\n  display: flex !important;\r\n  align-items: center !important;\r\n  border: none !important;\r\n  height: auto !important;\r\n  min-height: 48px !important;\r\n  box-shadow: none !important;\r\n  justify-content: flex-start !important;\r\n  font-size: 15px !important;\r\n  font-weight: 600 !important;\r\n}\r\n\r\n.wa-atendToolbar-menuAction .wa-atendLabel--short {\r\n  display: none !important;\r\n}\r\n\r\n.wa-atendToolbar-menuAction .wa-atendLabel--long {\r\n  display: inline !important;\r\n}\r\n\r\n/* Botões circulares translúcidos — ícones pequenos */\r\n.wa-header-btn {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  gap: 6px;\r\n  width: 38px;\r\n  height: 38px;\r\n  min-width: 38px;\r\n  padding: 0;\r\n  border: none;\r\n  border-radius: 10px;\r\n  border: 1px solid color-mix(in srgb, var(--wa-panel-border) 78%, transparent);\r\n  background: color-mix(in srgb, var(--wa-panel) 78%, transparent);\r\n  color: var(--wa-text-muted);\r\n  font-size: 13px;\r\n  font-weight: 500;\r\n  cursor: pointer;\r\n  box-shadow: inset 0 1px 0 color-mix(in srgb, #ffffff 16%, transparent);\r\n  transition: background var(--ds-transition), color var(--ds-transition), transform 0.15s ease, border-color var(--ds-transition);\r\n}\r\n\r\n.wa-header-btn:hover {\r\n  background: color-mix(in srgb, var(--wa-green) 8%, var(--wa-panel));\r\n  border-color: color-mix(in srgb, var(--wa-green) 22%, var(--wa-panel-border));\r\n  color: var(--wa-text);\r\n  transform: translateY(-1px);\r\n}\r\n\r\n.wa-header-btn.isActive {\r\n  background: var(--ds-accent-soft);\r\n  color: var(--wa-green);\r\n}\r\n\r\n.wa-header-btn:disabled {\r\n  opacity: 0.5;\r\n  cursor: not-allowed;\r\n}\r\n\r\n.wa-msgSearchPanel {\r\n  position: absolute;\r\n  top: calc(56px + 10px);\r\n  right: 12px;\r\n  bottom: 12px;\r\n  z-index: 42;\r\n  display: flex;\r\n  flex-direction: column;\r\n  width: min(390px, calc(100% - 24px));\r\n  min-height: 0;\r\n  overflow: hidden;\r\n  border: 1px solid color-mix(in srgb, var(--wa-panel-border) 88%, transparent);\r\n  border-radius: 12px;\r\n  background: color-mix(in srgb, var(--wa-panel) 96%, #ffffff 4%);\r\n  box-shadow: 0 18px 52px rgba(15, 23, 42, 0.18);\r\n  animation: wa-panelAppear 0.16s ease-out;\r\n}\r\n\r\n.wa-msgSearch-head {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 10px;\r\n  min-height: 52px;\r\n  padding: 8px 12px;\r\n  border-bottom: 1px solid color-mix(in srgb, var(--wa-panel-border) 88%, transparent);\r\n  background: color-mix(in srgb, var(--wa-header-bg) 88%, var(--wa-panel) 12%);\r\n}\r\n\r\n.wa-msgSearch-close,\r\n.wa-msgSearch-clear {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  width: 34px;\r\n  height: 34px;\r\n  min-width: 34px;\r\n  border: none;\r\n  border-radius: 999px;\r\n  background: transparent;\r\n  color: var(--wa-text-muted);\r\n  cursor: pointer;\r\n}\r\n\r\n.wa-msgSearch-close:hover,\r\n.wa-msgSearch-clear:hover {\r\n  background: var(--ds-hover);\r\n  color: var(--wa-text);\r\n}\r\n\r\n.wa-msgSearch-title {\r\n  font-size: 15px;\r\n  font-weight: 650;\r\n  color: var(--wa-text);\r\n}\r\n\r\n.wa-msgSearch-box {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 10px;\r\n  margin: 14px 14px 10px;\r\n  padding: 0 12px;\r\n  min-height: 44px;\r\n  border: 1px solid color-mix(in srgb, var(--wa-green) 58%, var(--wa-panel-border));\r\n  border-radius: 999px;\r\n  color: var(--wa-text-muted);\r\n  background: color-mix(in srgb, var(--wa-bg) 74%, var(--wa-panel) 26%);\r\n  box-shadow: inset 0 1px 0 color-mix(in srgb, #ffffff 12%, transparent);\r\n}\r\n\r\n.wa-msgSearch-box:focus-within {\r\n  border-color: var(--wa-green);\r\n  box-shadow: 0 0 0 3px color-mix(in srgb, var(--wa-green) 14%, transparent);\r\n}\r\n\r\n.wa-msgSearch-box input {\r\n  flex: 1;\r\n  min-width: 0;\r\n  border: none;\r\n  outline: none;\r\n  background: transparent;\r\n  color: var(--wa-text);\r\n  font-size: 15px;\r\n  line-height: 1.4;\r\n}\r\n\r\n.wa-msgSearch-box input::placeholder {\r\n  color: var(--wa-text-muted);\r\n}\r\n\r\n.wa-msgSearch-results {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 2px;\r\n  flex: 1;\r\n  min-height: 0;\r\n  overflow: auto;\r\n  padding: 4px 8px 12px;\r\n}\r\n\r\n.wa-msgSearch-state {\r\n  padding: 28px 18px;\r\n  color: var(--wa-text-muted);\r\n  font-size: 14px;\r\n  text-align: center;\r\n}\r\n\r\n.wa-msgSearch-state.isError {\r\n  color: var(--ds-danger, #dc2626);\r\n}\r\n\r\n.wa-msgSearch-result {\r\n  display: grid;\r\n  grid-template-columns: 1fr;\r\n  gap: 4px;\r\n  width: 100%;\r\n  padding: 12px 14px;\r\n  border: none;\r\n  border-radius: 10px;\r\n  background: transparent;\r\n  color: var(--wa-text);\r\n  text-align: left;\r\n  cursor: pointer;\r\n}\r\n\r\n.wa-msgSearch-result:hover,\r\n.wa-msgSearch-result:focus-visible {\r\n  background: var(--ds-hover);\r\n  outline: none;\r\n}\r\n\r\n.wa-msgSearch-resultDate {\r\n  color: var(--wa-text-muted);\r\n  font-size: 12px;\r\n  font-weight: 600;\r\n}\r\n\r\n.wa-msgSearch-resultText {\r\n  color: var(--wa-text);\r\n  font-size: 14px;\r\n  line-height: 1.4;\r\n  overflow-wrap: anywhere;\r\n}\r\n\r\n.wa-msgSearch-match {\r\n  padding: 0 1px;\r\n  border-radius: 3px;\r\n  background: transparent;\r\n  color: var(--wa-green);\r\n  font-weight: 750;\r\n}\r\n\r\n.wa-msgSearch-resultMeta {\r\n  color: var(--wa-text-muted);\r\n  font-size: 12px;\r\n}\r\n\r\n.wa-msgSearch-more {\r\n  align-self: center;\r\n  margin: 10px 0 2px;\r\n  padding: 8px 14px;\r\n  border: 1px solid color-mix(in srgb, var(--wa-panel-border) 86%, transparent);\r\n  border-radius: 999px;\r\n  background: color-mix(in srgb, var(--wa-panel) 86%, transparent);\r\n  color: var(--wa-text);\r\n  cursor: pointer;\r\n}\r\n\r\n.wa-msgSearch-more:hover:not(:disabled) {\r\n  background: color-mix(in srgb, var(--wa-green) 9%, var(--wa-panel));\r\n}\r\n\r\n.wa-msgSearch-more:disabled {\r\n  opacity: 0.65;\r\n  cursor: wait;\r\n}\r\n\r\n@media (max-width: 640px) {\r\n  .wa-msgSearchPanel {\r\n    position: fixed;\r\n    inset: 0;\r\n    z-index: 80;\r\n    width: auto;\r\n    min-height: 100dvh;\r\n    border: none;\r\n    border-radius: 0;\r\n    box-shadow: none;\r\n  }\r\n\r\n  .wa-msgSearch-head {\r\n    min-height: 56px;\r\n    padding-left: max(12px, env(safe-area-inset-left));\r\n    padding-right: max(12px, env(safe-area-inset-right));\r\n  }\r\n\r\n  .wa-msgSearch-box {\r\n    margin-left: max(12px, env(safe-area-inset-left));\r\n    margin-right: max(12px, env(safe-area-inset-right));\r\n  }\r\n\r\n  .wa-msgSearch-results {\r\n    padding-bottom: max(18px, env(safe-area-inset-bottom));\r\n  }\r\n}\r\n\r\n.wa-header-btn-icon {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  gap: 6px;\r\n}\r\n\r\n.wa-header-btn-label {\r\n  display: none;\r\n}\r\n\r\n/* AtendimentoActions — botões compactos dentro de ícones circulares ou mínimos */\r\n/* ======================================================\r\n   AÇÕES CRM — PREMIUM SaaS (Kommo / Hubspot / Intercom)\r\n   compacto • elegante • tecnológico • discreto\r\n====================================================== */\r\n\r\n.wa-actions{\r\n  display:flex;\r\n  align-items:center;\r\n  gap:7px;\r\n}\r\n\r\n/* Texto completo no desktop; versão curta só em mobile (≤640px) */\r\n.wa-actions .wa-atendLabel--short {\r\n  display: none;\r\n}\r\n.wa-header-setorBtn .wa-setorBtn-label--short {\r\n  display: none;\r\n}\r\n\r\n/* -------------------------\r\n   BASE BOTÃO\r\n------------------------- */\r\n.wa-actions button{\r\n  height:34px;\r\n  padding:0 13px;\r\n\r\n  border-radius:8px;\r\n\r\n  font-size:13px;\r\n  font-weight:600;\r\n  letter-spacing: 0;\r\n\r\n  border:1px solid transparent;\r\n\r\n  display:inline-flex;\r\n  align-items:center;\r\n  gap:6px;\r\n\r\n  cursor:pointer;\r\n\r\n  background: color-mix(in srgb, var(--wa-panel) 72%, transparent);\r\n  color: var(--wa-text);\r\n  border-color: color-mix(in srgb, var(--wa-panel-border) 82%, transparent);\r\n  box-shadow: inset 0 1px 0 color-mix(in srgb, #ffffff 16%, transparent);\r\n\r\n  transition:\r\n    background .18s ease,\r\n    color .18s ease,\r\n    transform .12s ease,\r\n    border-color .18s ease,\r\n    box-shadow .18s ease;\r\n}\r\n\r\n/* micro animação tecnológica */\r\n.wa-actions button:hover:not(:disabled){\r\n  transform:translateY(-1px);\r\n  background: color-mix(in srgb, currentColor 7%, var(--wa-panel));\r\n  border-color: color-mix(in srgb, currentColor 18%, var(--wa-panel-border));\r\n}\r\n\r\n/* clique */\r\n.wa-actions button:active{\r\n  transform:scale(.96);\r\n}\r\n\r\n/* disabled */\r\n.wa-actions button:disabled{\r\n  opacity:.45;\r\n  cursor:not-allowed;\r\n}\r\n\r\n/* -------------------------\r\n   ASSUMIR / PRIMÁRIO (verde leve)\r\n------------------------- */\r\n.wa-actions .wa-btn-primary{\r\n  background: var(--ds-accent);\r\n  color: #fff;\r\n  border-color: var(--ds-accent);\r\n  box-shadow:\r\n    inset 0 1px 0 rgba(255, 255, 255, 0.2),\r\n    0 5px 16px -12px color-mix(in srgb, var(--ds-accent) 70%, transparent);\r\n  transition: background 0.12s ease, box-shadow 0.12s ease, border-color 0.12s ease;\r\n}\r\n\r\n.wa-actions .wa-btn-primary:hover:not(:disabled){\r\n  background: var(--ds-accent-hover);\r\n  border-color: var(--ds-accent-hover);\r\n  box-shadow:\r\n    inset 0 1px 0 rgba(255, 255, 255, 0.22),\r\n    0 8px 18px -12px color-mix(in srgb, var(--ds-accent) 80%, transparent);\r\n}\r\n\r\n/* -------------------------\r\n   ASSUMIR DESTAQUE (quando conversa não assumida) — leve\r\n------------------------- */\r\n.wa-actions .wa-btn-assumir-destaque{\r\n  background: color-mix(in srgb, var(--wa-green) 14%, var(--wa-panel));\r\n  color:var(--wa-green);\r\n  border:1px solid color-mix(in srgb, var(--wa-green) 36%, transparent);\r\n  box-shadow:\r\n    inset 0 1px 0 color-mix(in srgb, #ffffff 18%, transparent),\r\n    0 6px 16px -14px color-mix(in srgb, var(--wa-green) 70%, transparent);\r\n  animation:wa-assumir-pulse 3s ease-in-out infinite;\r\n}\r\n.wa-actions .wa-btn-assumir-destaque:hover:not(:disabled){\r\n  background: color-mix(in srgb, var(--wa-green) 18%, var(--wa-panel));\r\n  box-shadow:\r\n    inset 0 1px 0 color-mix(in srgb, #ffffff 18%, transparent),\r\n    0 8px 18px -13px color-mix(in srgb, var(--wa-green) 78%, transparent);\r\n}\r\n\r\n@keyframes wa-assumir-pulse{\r\n  0%,100%{ box-shadow: inset 0 1px 0 color-mix(in srgb, #ffffff 18%, transparent), 0 6px 16px -14px color-mix(in srgb, var(--wa-green) 70%, transparent); }\r\n  50%{ box-shadow: inset 0 1px 0 color-mix(in srgb, #ffffff 18%, transparent), 0 8px 20px -12px color-mix(in srgb, var(--wa-green) 82%, transparent); }\r\n}\r\n\r\n/* -------------------------\r\n   ENCERRAR / PERIGO (vermelho moderno)\r\n------------------------- */\r\n.wa-actions .wa-btn-danger{\r\n  background: var(--wa-action-red-soft);\r\n  color: var(--wa-action-red);\r\n  border-color: color-mix(in srgb, var(--wa-action-red) 26%, transparent);\r\n  transition: background 0.12s ease, box-shadow 0.12s ease, color 0.12s ease, border-color 0.12s ease;\r\n}\r\n\r\n.wa-actions .wa-btn-danger:hover:not(:disabled){\r\n  background: var(--wa-action-red);\r\n  color: #fff;\r\n  border-color: var(--wa-action-red);\r\n  box-shadow: 0 8px 18px -13px color-mix(in srgb, var(--wa-action-red) 78%, transparent);\r\n}\r\n\r\n/* -------------------------\r\n   TRANSFERIR (azul — ação de encaminhar)\r\n------------------------- */\r\n.wa-actions .wa-btn-transferir{\r\n  background: var(--wa-action-blue-soft);\r\n  color: var(--wa-action-blue);\r\n  border-color: color-mix(in srgb, var(--wa-action-blue) 24%, transparent);\r\n  transition: background 0.12s ease, box-shadow 0.12s ease, border-color 0.12s ease;\r\n}\r\n.wa-actions .wa-btn-transferir:hover:not(:disabled){\r\n  background: color-mix(in srgb, var(--wa-action-blue) 18%, var(--wa-panel));\r\n  border-color: color-mix(in srgb, var(--wa-action-blue) 38%, transparent);\r\n  box-shadow: 0 8px 18px -14px color-mix(in srgb, var(--wa-action-blue) 70%, transparent);\r\n}\r\n\r\n/* -------------------------\r\n   AGUARDAR CLIENTE (âmbar/laranja — pausa aguardando resposta)\r\n------------------------- */\r\n.wa-actions .wa-btn-aguardar-cliente{\r\n  background: var(--wa-action-amber-soft);\r\n  color: var(--wa-action-amber);\r\n  border-color: color-mix(in srgb, var(--wa-action-amber) 26%, transparent);\r\n  transition: background 0.14s ease, border-color 0.14s ease, box-shadow 0.14s ease;\r\n}\r\n.wa-actions .wa-btn-aguardar-cliente:hover:not(:disabled){\r\n  background: color-mix(in srgb, var(--wa-action-amber) 18%, var(--wa-panel));\r\n  border-color: color-mix(in srgb, var(--wa-action-amber) 38%, transparent);\r\n  box-shadow: 0 8px 18px -14px color-mix(in srgb, var(--wa-action-amber) 70%, transparent);\r\n}\r\n.wa-actions .wa-btn-aguardar-cliente:active:not(:disabled){\r\n  transform: translateY(0);\r\n}\r\n[data-theme=\"dark\"] .wa-actions .wa-btn-aguardar-cliente{\r\n  background: var(--wa-action-amber-soft);\r\n  color: var(--wa-action-amber);\r\n  border-color: color-mix(in srgb, var(--wa-action-amber) 30%, transparent);\r\n}\r\n[data-theme=\"dark\"] .wa-actions .wa-btn-aguardar-cliente:hover:not(:disabled){\r\n  background: color-mix(in srgb, var(--wa-action-amber) 20%, var(--wa-panel));\r\n  border-color: color-mix(in srgb, var(--wa-action-amber) 44%, transparent);\r\n}\r\n\r\n/* Ícone + texto nas ações de atendimento */\r\n.wa-atendBtn-icon {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  flex-shrink: 0;\r\n}\r\n.wa-atendBtn-icon svg {\r\n  display: block;\r\n}\r\n\r\n/* Mobile: Assumir — ação principal, maior e mais visível que Transf./Encerr. */\r\n.wa-atendToolbar--compact .wa-atendBtn--assumir-hero {\r\n  flex: 1 1 auto;\r\n  min-width: 88px;\r\n  max-width: 100%;\r\n  min-height: 42px !important;\r\n  height: 42px !important;\r\n  padding: 0 16px !important;\r\n  font-size: 13px !important;\r\n  font-weight: 700 !important;\r\n  border-radius: 10px !important;\r\n  line-height: 1.15 !important;\r\n  gap: 6px !important;\r\n  letter-spacing: 0.01em;\r\n  box-shadow:\r\n    0 6px 18px -10px color-mix(in srgb, var(--ds-accent) 72%, transparent),\r\n    inset 0 1px 0 rgba(255, 255, 255, 0.2);\r\n}\r\n.wa-atendToolbar--compact .wa-atendBtn--assumir-hero .wa-atendLabel--long {\r\n  display: inline;\r\n}\r\n.wa-atendToolbar--compact .wa-atendBtn--assumir-hero .wa-atendLabel--short {\r\n  display: none;\r\n}\r\n.wa-atendToolbar--compact .wa-atendBtn--assumir-hero .wa-atendBtn-icon svg {\r\n  width: 16px !important;\r\n  height: 16px !important;\r\n}\r\n.wa-atendToolbar--compact .wa-atendBtn--assumir-hero.wa-btn-assumir-destaque {\r\n  animation: wa-assumir-pulse 2.4s ease-in-out infinite;\r\n}\r\n\r\n/* Reabrir — ação principal quando atendimento finalizado (mesmo destaque do Assumir) */\r\n.wa-atendToolbar--compact .wa-atendBtn--reabrir-hero {\r\n  flex: 1 1 auto;\r\n  min-width: 120px;\r\n  max-width: 100%;\r\n}\r\n\r\n/* Reabrir — chip compacto (legado; não usado na barra principal) */\r\n.wa-atendToolbar--compact .wa-atendBtn--micro {\r\n  flex: 0 0 auto;\r\n  width: auto;\r\n  max-width: none;\r\n  min-height: 28px !important;\r\n  height: 28px !important;\r\n  padding: 0 7px !important;\r\n  font-size: 10px !important;\r\n  font-weight: 600 !important;\r\n  border-radius: 7px !important;\r\n  line-height: 1.1 !important;\r\n  gap: 4px !important;\r\n  letter-spacing: 0;\r\n  box-shadow: none;\r\n}\r\n.wa-atendToolbar--compact .wa-atendBtn--micro .wa-atendBtn-icon svg {\r\n  width: 12px;\r\n  height: 12px;\r\n}\r\n.wa-header.wa-header--atendMobile .wa-atendToolbar--compact .wa-atendBtn--micro {\r\n  min-height: 28px !important;\r\n  height: 28px !important;\r\n  padding: 0 7px !important;\r\n  font-size: 10px !important;\r\n  border-radius: 7px !important;\r\n}\r\n\r\n/* -------------------------\r\n   SECUNDÁRIO / REABRIR (neutro)\r\n------------------------- */\r\n.wa-actions .wa-btn-secondary{\r\n  background: color-mix(in srgb, var(--wa-panel) 72%, transparent);\r\n  color:var(--wa-text);\r\n  border-color: color-mix(in srgb, var(--wa-panel-border) 88%, transparent);\r\n  transition: background 0.12s ease;\r\n}\r\n.wa-actions .wa-btn-secondary:hover:not(:disabled){\r\n  background: color-mix(in srgb, currentColor 7%, var(--wa-panel));\r\n}\r\n/* Ícones estilo SaaS minimalista */\r\n\r\n.wa-iconBtn{\r\n  width:30px;\r\n  height:30px;\r\n\r\n  border-radius:50%;\r\n  border:none;\r\n\r\n  background:rgba(0,0,0,.03);\r\n  color:var(--wa-text-muted);\r\n\r\n  display:flex;\r\n  align-items:center;\r\n  justify-content:center;\r\n\r\n  cursor:pointer;\r\n\r\n  transition:\r\n    background .18s ease,\r\n    transform .12s ease,\r\n    color .18s ease;\r\n}\r\n\r\n.wa-iconBtn:hover:not(:disabled){\r\n  background:rgba(0,0,0,.08);\r\n  transform:translateY(-1px);\r\n  color:var(--wa-text);\r\n}\r\n\r\n.wa-iconBtn.isActive{\r\n  background:rgba(0,168,132,.12);\r\n  color:var(--wa-green);\r\n}\r\n\r\n/* Sobreposição ao abrir tags / transferir setor — só mobile (cabecalho é position:fixed z-index 35) */\r\n.wa-floatingSheet-backdrop {\r\n  display: none;\r\n}\r\n\r\n/* Painéis flutuantes — flat, sombra leve, entrada suave */\r\n.wa-tagsPanel {\r\n  position: absolute;\r\n  top: 64px;\r\n  right: 16px;\r\n  width: 260px;\r\n  max-width: 90vw;\r\n  background: var(--wa-glass-strong);\r\n  border-radius: 8px;\r\n  border: 1px solid color-mix(in srgb, var(--wa-panel-border) 82%, transparent);\r\n  box-shadow: 0 18px 46px -24px rgba(15, 23, 42, 0.44);\r\n  backdrop-filter: blur(16px);\r\n  /* Acima do cabecalho mobile fixo (35), abaixo de modais fullscreen */\r\n  z-index: 60;\r\n  display: flex;\r\n  flex-direction: column;\r\n  overflow: hidden;\r\n  animation: wa-panelAppear 0.2s ease-out;\r\n}\r\n\r\n[data-theme=\"dark\"] .wa-tagsPanel {\r\n  box-shadow: 0 12px 40px rgba(0, 0, 0, 0.45);\r\n}\r\n\r\n.wa-tagsPanel-head {\r\n  padding: 12px 14px;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  border-bottom: 1px solid color-mix(in srgb, var(--wa-panel-border) 78%, transparent);\r\n  background: color-mix(in srgb, var(--wa-header-bg) 72%, transparent);\r\n}\r\n\r\n.wa-tagsPanel-title {\r\n  font-size: 14px;\r\n  font-weight: 600;\r\n  color: var(--wa-text);\r\n}\r\n\r\n.wa-tagsPanel-body {\r\n  padding: 12px 14px 14px;\r\n}\r\n\r\n/* Painel de respostas salvas (atalho \"/\" no composer) */\r\n.wa-savedRepliesPanel {\r\n  position: absolute;\r\n  left: 0;\r\n  right: 0;\r\n  bottom: 100%;\r\n  margin-bottom: 6px;\r\n  max-height: min(240px, 42vh);\r\n  background: var(--wa-glass-strong);\r\n  border-radius: 8px;\r\n  border: 1px solid color-mix(in srgb, var(--wa-panel-border) 82%, transparent);\r\n  box-shadow: 0 18px 46px -24px rgba(15, 23, 42, 0.44);\r\n  backdrop-filter: blur(16px);\r\n  z-index: 62;\r\n  display: flex;\r\n  flex-direction: column;\r\n  overflow: hidden;\r\n  animation: wa-panelAppear 0.2s ease-out;\r\n}\r\n\r\n[data-theme=\"dark\"] .wa-savedRepliesPanel {\r\n  box-shadow: 0 12px 40px rgba(0, 0, 0, 0.45);\r\n}\r\n\r\n.wa-savedRepliesPanel-head {\r\n  padding: 10px 12px;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  gap: 8px;\r\n  border-bottom: 1px solid color-mix(in srgb, var(--wa-panel-border) 78%, transparent);\r\n  background: color-mix(in srgb, var(--wa-header-bg) 72%, transparent);\r\n}\r\n\r\n.wa-savedRepliesPanel-title {\r\n  font-size: 13px;\r\n  font-weight: 600;\r\n  color: var(--wa-text);\r\n}\r\n\r\n.wa-savedRepliesPanel-hint {\r\n  font-size: 11px;\r\n  white-space: nowrap;\r\n  overflow: hidden;\r\n  text-overflow: ellipsis;\r\n}\r\n\r\n.wa-savedRepliesPanel-body {\r\n  padding: 8px;\r\n  overflow-y: auto;\r\n  -webkit-overflow-scrolling: touch;\r\n}\r\n\r\n.wa-savedRepliesList {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 4px;\r\n}\r\n\r\n.wa-savedReplyItem {\r\n  display: flex;\r\n  flex-direction: column;\r\n  align-items: flex-start;\r\n  gap: 2px;\r\n  width: 100%;\r\n  text-align: left;\r\n  padding: 8px 10px;\r\n  border: none;\r\n  border-radius: 6px;\r\n  background: transparent;\r\n  color: var(--wa-text);\r\n  cursor: pointer;\r\n}\r\n\r\n.wa-savedReplyItem:hover,\r\n.wa-savedReplyItem.isActive {\r\n  background: color-mix(in srgb, var(--wa-accent) 14%, transparent);\r\n}\r\n\r\n.wa-savedReplyItem strong {\r\n  font-size: 13px;\r\n  font-weight: 600;\r\n}\r\n\r\n.wa-savedReplyItem-preview {\r\n  font-size: 12px;\r\n  line-height: 1.35;\r\n  display: -webkit-box;\r\n  -webkit-line-clamp: 2;\r\n  -webkit-box-orient: vertical;\r\n  overflow: hidden;\r\n}\r\n\r\n.wa-savedRepliesPanel-empty {\r\n  font-size: 13px;\r\n  line-height: 1.45;\r\n}\r\n\r\n.wa-savedRepliesPanel-empty p {\r\n  margin: 0 0 6px;\r\n}\r\n\r\n.wa-savedRepliesPanel-empty-hint {\r\n  font-size: 12px;\r\n  opacity: 0.9;\r\n}\r\n\r\n@media (max-width: 640px) {\r\n  .wa-savedRepliesPanel {\r\n    max-height: min(220px, 38vh);\r\n    margin-bottom: 4px;\r\n  }\r\n\r\n  .wa-savedRepliesPanel-hint {\r\n    display: none;\r\n  }\r\n}\r\n\r\n.wa-savedRepliesBtn {\r\n  flex-shrink: 0;\r\n}\r\n\r\n@media (max-width: 640px) {\r\n  .wa-savedRepliesBtn {\r\n    padding: 6px;\r\n  }\r\n}\r\n\r\n.wa-tagsPanel.wa-tagsPanel--setor {\r\n  min-width: 260px;\r\n}\r\n\r\n.wa-tagsList {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  gap: 8px;\r\n}\r\n\r\n.wa-tagChip {\r\n  padding: 6px 12px;\r\n  border-radius: 999px;\r\n  border: 1px solid color-mix(in srgb, var(--wa-panel-border) 84%, transparent);\r\n  background: color-mix(in srgb, var(--wa-panel) 76%, transparent);\r\n  color: var(--wa-text-muted);\r\n  font-size: 12px;\r\n  cursor: pointer;\r\n  display: inline-flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  transition: background 0.15s ease, border-color 0.15s ease, color 0.15s ease;\r\n}\r\n\r\n.wa-tagChip:hover:not(:disabled) {\r\n  background: color-mix(in srgb, var(--wa-green) 8%, var(--wa-panel));\r\n  border-color: color-mix(in srgb, var(--wa-green) 24%, var(--wa-panel-border));\r\n  color: var(--wa-text);\r\n}\r\n\r\n.wa-tagChip.isSelected {\r\n  background: rgba(0, 168, 132, 0.1);\r\n  border-color: rgba(0, 168, 132, 0.35);\r\n  color: var(--wa-green);\r\n}\r\n\r\n.wa-tagChip:disabled {\r\n  opacity: 0.6;\r\n  cursor: not-allowed;\r\n}\r\n\r\n.wa-tagItem {\r\n  padding: 10px 12px;\r\n  border-radius: 8px;\r\n  border: none;\r\n  background: transparent;\r\n  color: var(--wa-text);\r\n  font-size: 13px;\r\n  cursor: pointer;\r\n  text-align: left;\r\n  width: 100%;\r\n  transition: background 0.15s ease;\r\n}\r\n\r\n.wa-tagItem:hover:not(:disabled) {\r\n  background: var(--wa-header-bg);\r\n}\r\n\r\n.wa-tagItem--remover {\r\n  margin-top: 8px;\r\n  border-top: 1px solid rgba(0,0,0,.08);\r\n  padding-top: 12px;\r\n  color: #64748b;\r\n}\r\n.wa-tagItem--remover:hover:not(:disabled) {\r\n  color: #dc2626;\r\n  background: rgba(220,38,38,.06);\r\n}\r\n\r\n/* =========================================================\r\n   DROP OVERLAY (arrastar arquivo)\r\n========================================================= */\r\n\r\n.wa-dropOverlay {\r\n  position: absolute;\r\n  inset: 0;\r\n  background: rgba(239, 234, 226, 0.95);\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  z-index: 30;\r\n  border: 2px dashed rgba(0, 168, 132, 0.4);\r\n  border-radius: 0;\r\n  margin: 0;\r\n  animation: wa-dropOverlayFade 0.2s ease-out;\r\n}\r\n\r\n.wa-dropCard {\r\n  text-align: center;\r\n  padding: 32px 40px;\r\n  border-radius: 14px;\r\n  background: var(--wa-panel);\r\n  border: 1px solid var(--wa-panel-border);\r\n  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.06);\r\n  animation: wa-dropCardScale 0.25s cubic-bezier(0.34, 1.2, 0.64, 1);\r\n}\r\n\r\n.wa-dropTitle {\r\n  font-size: 16px;\r\n  font-weight: 600;\r\n  color: var(--wa-text);\r\n  margin-bottom: 8px;\r\n}\r\n\r\n.wa-dropSub {\r\n  font-size: 13px;\r\n  color: var(--wa-text-muted);\r\n}\r\n\r\n/* =========================================================\r\n   TIMELINE (histórico de atendimentos)\r\n========================================================= */\r\n\r\n.wa-timeline {\r\n  position: absolute;\r\n  top: 60px;\r\n  right: 0;\r\n  width: 320px;\r\n  max-width: 90vw;\r\n  height: calc(100% - 60px);\r\n  background: var(--wa-glass-strong);\r\n  border-left: 1px solid color-mix(in srgb, var(--wa-panel-border) 82%, transparent);\r\n  box-shadow: -18px 0 42px -30px rgba(15, 23, 42, 0.5);\r\n  backdrop-filter: blur(14px);\r\n  z-index: 20;\r\n  display: flex;\r\n  flex-direction: column;\r\n  overflow: hidden;\r\n  animation: wa-panelAppear 0.22s ease-out;\r\n}\r\n\r\n.wa-timeline-head {\r\n  padding: 14px 16px;\r\n  border-bottom: 1px solid color-mix(in srgb, var(--wa-panel-border) 78%, transparent);\r\n  background: color-mix(in srgb, var(--wa-header-bg) 72%, transparent);\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  flex-shrink: 0;\r\n}\r\n\r\n.wa-timeline-headLeft {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 2px;\r\n}\r\n\r\n.wa-timeline-title {\r\n  font-weight: 600;\r\n  font-size: 14px;\r\n  color: var(--wa-text);\r\n}\r\n\r\n.wa-timeline-sub {\r\n  font-size: 12px;\r\n  color: var(--wa-text-muted);\r\n}\r\n\r\n.wa-timeline-card {\r\n  padding: 12px 14px;\r\n  border-radius: 10px;\r\n  background: var(--wa-header-bg);\r\n  border: none;\r\n}\r\n\r\n.wa-timeline-row {\r\n  display: flex;\r\n  align-items: baseline;\r\n  gap: 10px;\r\n}\r\n\r\n.wa-timeline-time {\r\n  font-size: 12px;\r\n  font-weight: 500;\r\n  color: var(--wa-text-muted);\r\n  flex-shrink: 0;\r\n}\r\n\r\n.wa-timeline-label {\r\n  font-size: 13px;\r\n  color: var(--wa-text);\r\n}\r\n\r\n.wa-timeline-nota {\r\n  margin-top: 8px;\r\n  padding-top: 8px;\r\n  border-top: 1px solid var(--wa-panel-border);\r\n  font-size: 12px;\r\n  color: var(--wa-text-muted);\r\n  font-style: italic;\r\n}\r\n\r\n.wa-timeline-body {\r\n  flex: 1;\r\n  overflow: auto;\r\n  padding: 14px 16px;\r\n}\r\n\r\n.wa-timeline-list {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 10px;\r\n}\r\n\r\n.wa-muted {\r\n  color: var(--wa-text-muted);\r\n  font-size: 13px;\r\n}\r\n\r\n/* =========================================================\r\n   ÁREA DE MENSAGENS — fundo premium LIGHT/DARK + pattern sutil + glow\r\n========================================================= */\r\n\r\n@keyframes wa-glow-drift {\r\n  0%, 100% { transform: translate3d(0, 0, 0); opacity: var(--wa-glow-opacity); }\r\n  50% { transform: translate3d(0, -10px, 0); opacity: calc(var(--wa-glow-opacity) * 0.82); }\r\n}\r\n\r\n.wa-messages {\r\n  flex: 1;\r\n  overflow-y: auto;\r\n  overflow-x: hidden;\r\n  padding: 14px 22px 18px;\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 1px;\r\n  min-height: 0;\r\n  min-width: 0;\r\n  position: relative;\r\n  isolation: isolate;\r\n  background: var(--wa-bg);\r\n  box-shadow:\r\n    inset 0 1px 0 rgba(255, 255, 255, 0.035),\r\n    inset 0 42px 84px -78px rgba(255, 255, 255, 0.16),\r\n    inset 0 -48px 92px -82px rgba(0, 0, 0, 0.46);\r\n  scroll-behavior: auto;\r\n  /* Prioriza rolagem vertical no touch (menos “briga” com gestos / seleção nativa). */\r\n  touch-action: pan-y;\r\n  /* Evita seleção azul em Safari ao arrastar sobre o histórico (texto não é editável aqui). */\r\n  -webkit-user-select: none;\r\n  user-select: none;\r\n  /* Evita scroll anchoring do browser ao inserir bolhas no fim — causava “pulo” ao enviar. */\r\n  overflow-anchor: none;\r\n  /* Scroll tátil mais estável: menos “repasse” pro pai e momentum no iOS. */\r\n  overscroll-behavior-y: contain;\r\n  -webkit-overflow-scrolling: touch;\r\n}\r\n\r\n@media (prefers-reduced-motion: reduce) {\r\n  .wa-messages .wa-bubble.zap-message-enter {\r\n    animation: none !important;\r\n  }\r\n}\r\n\r\n@media (max-width: 640px) {\r\n  .wa-messages {\r\n    padding: 8px 12px 12px;\r\n    scroll-padding-bottom: max(12px, env(safe-area-inset-bottom, 0px));\r\n    scroll-padding-top: 8px;\r\n  }\r\n\r\n  .wa-messages-virtual-root {\r\n    touch-action: pan-y;\r\n  }\r\n\r\n  .wa-swipeReplyTrack {\r\n    touch-action: pan-y;\r\n  }\r\n\r\n  /* Glow animado no fundo custa GPU durante scroll tátil — estático no mobile. */\r\n  .wa-messages::after {\r\n    animation: none;\r\n  }\r\n\r\n  .wa-messages.is-scrolling {\r\n    will-change: auto;\r\n  }\r\n\r\n  .wa-messages.is-scrolling::before,\r\n  .wa-messages.is-scrolling::after {\r\n    opacity: calc(var(--wa-pattern-opacity, 0.06) * 0.65);\r\n    animation: none;\r\n  }\r\n\r\n  /* contain durante scroll tátil gerava jank nas bolhas virtualizadas */\r\n  .wa-messages-virtual-root > div,\r\n  .wa-messages.is-scrolling .wa-messages-virtual-root > div {\r\n    contain: none;\r\n  }\r\n}\r\n\r\n.wa-messages.is-scrolling .wa-bubble.zap-message-enter {\r\n  animation: none !important;\r\n  will-change: auto;\r\n}\r\n\r\n@media (min-width: 641px) {\r\n  .wa-messages.is-scrolling .wa-messages-virtual-root > div {\r\n    contain: layout style paint;\r\n  }\r\n}\r\n\r\n.wa-messages-virtual-root > div {\r\n  contain: layout style;\r\n  backface-visibility: hidden;\r\n}\r\n\r\n/* Bolhas = só gestos do app (copiar pelo menu). Sem isto, long press no iOS abre seleção nativa + menu azul. */\r\n.wa-messages .wa-bubble,\r\n.wa-messages .wa-bubble * {\r\n  -webkit-user-select: none;\r\n  user-select: none;\r\n  -webkit-touch-callout: none;\r\n}\r\n\r\n.wa-messages .wa-bubble img {\r\n  -webkit-user-drag: none;\r\n}\r\n\r\n/* Composer / rodapé: texto editável */\r\n.wa-shell .wa-footer textarea.wa-input,\r\n.wa-shell .wa-footer .wa-input,\r\n.wa-shell .wa-footer [contenteditable=\"true\"] {\r\n  -webkit-user-select: text;\r\n  user-select: text;\r\n  -webkit-touch-callout: default;\r\n}\r\n\r\n/* Placeholder / primeira linha — padding simétrico + line-height alinhados ao min-height ~44px (12+20+12) */\r\n.wa-shell .wa-footer textarea.wa-input {\r\n  padding: 12px 16px;\r\n  line-height: 20px;\r\n}\r\n\r\n.wa-shell .wa-footer textarea.wa-input::placeholder {\r\n  line-height: 20px;\r\n}\r\n\r\n/* Placeholder visível e centralizado (estilo WhatsApp); texto digitado volta ao alinhamento normal */\r\n.wa-shell .wa-footer textarea.wa-input:placeholder-shown {\r\n  text-align: center;\r\n}\r\n\r\n.wa-shell .wa-footer textarea.wa-input:not(:placeholder-shown) {\r\n  text-align: start;\r\n}\r\n\r\n.wa-shell .wa-footer textarea.wa-input::placeholder {\r\n  text-align: center;\r\n}\r\n\r\n/* z-index 0 (não -1): com -1 o padrão ficava atrás do próprio gradiente e sumia */\r\n.wa-messages::before {\r\n  content: \"\";\r\n  position: absolute;\r\n  inset: 0;\r\n  z-index: 0;\r\n  background-image: url(\"/wa-chat-pattern.svg\");\r\n  background-repeat: repeat;\r\n  background-size: var(--wa-pattern-size);\r\n  background-position: 0 0;\r\n  opacity: var(--wa-pattern-opacity);\r\n  mix-blend-mode: var(--wa-pattern-blend);\r\n  pointer-events: none;\r\n}\r\n\r\n.wa-messages::after {\r\n  content: \"\";\r\n  position: absolute;\r\n  inset: 0;\r\n  z-index: 0;\r\n  background-image: var(--wa-glow-1), var(--wa-glow-2), var(--wa-glow-3);\r\n  background-repeat: no-repeat;\r\n  background-position: 0 0, 100% 0, 0 0;\r\n  background-size: 100% 100%, 100% 100%, 100% 100%;\r\n  opacity: var(--wa-glow-opacity);\r\n  pointer-events: none;\r\n  animation: wa-glow-drift 36s ease-in-out infinite;\r\n}\r\n\r\n.wa-messages > * {\r\n  position: relative;\r\n  z-index: 1;\r\n}\r\n\r\n/* Conteúdo virtualizado: altura total definida pelo virtualizer; não encolher no flex column */\r\n.wa-messages-virtual-root {\r\n  flex-shrink: 0;\r\n}\r\n\r\n.wa-messages-static-root {\r\n  display: flex;\r\n  flex-direction: column;\r\n  width: 100%;\r\n  min-width: 0;\r\n  flex-shrink: 0;\r\n}\r\n\r\n.wa-messages-static-row {\r\n  width: 100%;\r\n  max-width: 100%;\r\n  min-width: 0;\r\n}\r\n\r\n.wa-messages::-webkit-scrollbar {\r\n  width: 5px;\r\n}\r\n\r\n.wa-messages::-webkit-scrollbar-track {\r\n  background: transparent;\r\n}\r\n\r\n.wa-messages::-webkit-scrollbar-thumb {\r\n  background: rgba(0, 0, 0, 0.08);\r\n  border-radius: 999px;\r\n  transition: background 0.15s ease;\r\n}\r\n\r\n.wa-messages::-webkit-scrollbar-thumb:hover {\r\n  background: rgba(0, 0, 0, 0.14);\r\n}\r\n\r\n[data-theme=\"dark\"] .wa-messages::-webkit-scrollbar-thumb {\r\n  background: rgba(255, 255, 255, 0.15);\r\n}\r\n[data-theme=\"dark\"] .wa-messages::-webkit-scrollbar-thumb:hover {\r\n  background: rgba(255, 255, 255, 0.22);\r\n}\r\n\r\n.wa-closedAttendance-banner {\r\n  position: sticky;\r\n  top: 0;\r\n  z-index: 4;\r\n  flex-shrink: 0;\r\n  width: 100%;\r\n  display: flex;\r\n  justify-content: center;\r\n  padding: 6px 12px 4px;\r\n  box-sizing: border-box;\r\n}\r\n\r\n.wa-closedAttendance-panel {\r\n  width: min(560px, calc(100% - 24px));\r\n  max-width: 600px;\r\n  min-height: 50px;\r\n  padding: 8px 12px;\r\n  border-radius: 10px;\r\n  background: color-mix(in srgb, var(--wa-glass-strong) 88%, var(--wa-panel));\r\n  color: var(--wa-text-muted);\r\n  border: 1px solid color-mix(in srgb, var(--wa-panel-border) 90%, transparent);\r\n  box-shadow: 0 4px 14px -10px rgba(15, 23, 42, 0.28);\r\n  display: flex;\r\n  flex-direction: row;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  gap: 10px;\r\n}\r\n\r\n.wa-closedAttendance-text {\r\n  flex: 1 1 auto;\r\n  min-width: 0;\r\n  margin: 0;\r\n  color: var(--wa-text);\r\n  font-size: 13px;\r\n  font-weight: 500;\r\n  line-height: 1.3;\r\n  white-space: nowrap;\r\n  overflow: hidden;\r\n  text-overflow: ellipsis;\r\n}\r\n\r\n.wa-closedAttendance-reopenBtn {\r\n  flex: 0 0 auto;\r\n  display: inline-flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  min-height: 32px;\r\n  padding: 0 12px;\r\n  border-radius: 8px;\r\n  border: 1px solid color-mix(in srgb, var(--wa-green) 38%, transparent);\r\n  background: color-mix(in srgb, var(--wa-green) 10%, var(--wa-panel));\r\n  color: var(--wa-green);\r\n  font-size: 12px;\r\n  font-weight: 600;\r\n  line-height: 1.2;\r\n  white-space: nowrap;\r\n  cursor: pointer;\r\n  transition: background 0.12s ease, border-color 0.12s ease;\r\n}\r\n\r\n.wa-closedAttendance-reopenBtn:hover:not(:disabled) {\r\n  background: color-mix(in srgb, var(--wa-green) 16%, var(--wa-panel));\r\n  border-color: color-mix(in srgb, var(--wa-green) 52%, transparent);\r\n}\r\n\r\n.wa-closedAttendance-reopenBtn:disabled {\r\n  opacity: 0.65;\r\n  cursor: not-allowed;\r\n}\r\n\r\n@media (max-width: 640px) {\r\n  .wa-closedAttendance-banner {\r\n    padding: 6px 12px 4px;\r\n  }\r\n\r\n  .wa-closedAttendance-panel {\r\n    width: calc(100% - 24px);\r\n    min-height: 48px;\r\n    padding: 7px 10px;\r\n    gap: 8px;\r\n  }\r\n\r\n  .wa-closedAttendance-text {\r\n    font-size: 12.5px;\r\n  }\r\n\r\n  .wa-closedAttendance-reopenBtn {\r\n    min-height: 30px;\r\n    padding: 0 10px;\r\n    font-size: 11.5px;\r\n  }\r\n}\r\n\r\n@media (max-width: 520px) {\r\n  .wa-messages-emptyCard--closed {\r\n    width: min(360px, calc(100vw - 32px));\r\n    padding: 20px 18px;\r\n  }\r\n}\r\n\r\n.wa-messages-empty {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  min-height: 200px;\r\n}\r\n\r\n.wa-messages-emptyCard {\r\n  padding: 20px 28px;\r\n  border-radius: 8px;\r\n  background: var(--wa-glass-strong);\r\n  color: var(--wa-text-muted);\r\n  font-size: 14px;\r\n  text-align: center;\r\n  border: 1px solid color-mix(in srgb, var(--wa-panel-border) 80%, transparent);\r\n  box-shadow: 0 12px 28px -22px rgba(15, 23, 42, 0.34);\r\n  display: flex;\r\n  flex-direction: column;\r\n  align-items: center;\r\n  gap: 12px;\r\n  max-width: 320px;\r\n}\r\n\r\n.wa-messages-emptyText {\r\n  margin: 0;\r\n  line-height: 1.45;\r\n}\r\n\r\n.wa-messages-emptyCard--blocked {\r\n  display: flex;\r\n  flex-direction: column;\r\n  align-items: center;\r\n  gap: 10px;\r\n  max-width: 320px;\r\n}\r\n\r\n.wa-messages-emptyCard--closed {\r\n  width: min(420px, calc(100vw - 40px));\r\n  max-width: 420px;\r\n  padding: 22px 24px;\r\n  gap: 14px;\r\n}\r\n\r\n.wa-messages-emptyCard--blocked strong {\r\n  color: var(--wa-text);\r\n  font-weight: 600;\r\n  line-height: 1.35;\r\n}\r\n\r\n.wa-messages-blocked-icon {\r\n  width: 40px;\r\n  height: 40px;\r\n  border-radius: 10px;\r\n  display: inline-flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  color: var(--wa-green);\r\n  background: color-mix(in srgb, var(--wa-green) 10%, transparent);\r\n  border: 0.5px solid var(--wa-green);\r\n}\r\n\r\n/* =========================================================\r\n   BOLHAS DE MENSAGEM — modernas, cantos 14–16px, sombra leve, tipografia 13–14px\r\n========================================================= */\r\n\r\n.wa-row {\r\n  display: flex;\r\n  width: 100%;\r\n  padding: 0;\r\n  min-width: 0;\r\n  max-width: 100%;\r\n  margin: 2px 0;\r\n}\r\n\r\n.wa-row + .wa-row {\r\n  margin-top: 2px;\r\n}\r\n\r\n.wa-row[data-group-start=\"1\"] {\r\n  margin-top: 14px;\r\n}\r\n\r\n/* Foto/vídeo + legenda em mensagem seguinte: cantos “colados” estilo WhatsApp */\r\n.wa-row.wa-row--captionBundleTop {\r\n  margin-bottom: 0;\r\n}\r\n\r\n.wa-row.wa-row--captionBundleTop + .wa-row.wa-row--captionBundleFollow {\r\n  margin-top: 0;\r\n}\r\n\r\n.wa-row.wa-row--captionBundleFollow {\r\n  margin-top: 0;\r\n}\r\n\r\n.wa-row-out.wa-row--captionBundleTop .wa-bubble-out {\r\n  border-bottom-right-radius: 5px;\r\n  border-bottom-left-radius: 5px;\r\n}\r\n\r\n.wa-row-out.wa-row--captionBundleFollow .wa-bubble-out {\r\n  border-top-right-radius: 5px;\r\n  border-top-left-radius: 5px;\r\n}\r\n\r\n.wa-row-in.wa-row--captionBundleTop .wa-bubble-in {\r\n  border-bottom-right-radius: 5px;\r\n  border-bottom-left-radius: 5px;\r\n}\r\n\r\n.wa-row-in.wa-row--captionBundleFollow .wa-bubble-in {\r\n  border-top-right-radius: 5px;\r\n  border-top-left-radius: 5px;\r\n}\r\n\r\n.wa-row-in {\r\n  justify-content: flex-start;\r\n  align-items: flex-end;\r\n}\r\n\r\n.wa-row-out {\r\n  justify-content: flex-end;\r\n  align-items: flex-end;\r\n}\r\n\r\n/* Com faixa de swipe (mobile): coluna com largura máxima preenche até o limite e a bolha cola à direita */\r\n.wa-row-out:has(> .wa-swipeReplyTrack) {\r\n  justify-content: flex-start;\r\n}\r\n\r\n/* Faixa do gesto “arrastar para responder” — pan-y preserva rolagem vertical da lista */\r\n.wa-swipeReplyTrack {\r\n  touch-action: pan-y;\r\n  box-sizing: border-box;\r\n  /* Coluna com largura máxima fixa; a bolha alinha dentro (evita “andar” à esquerda quando o texto cresce) */\r\n  max-width: min(78%, 420px);\r\n}\r\n\r\n.wa-row-out .wa-swipeReplyTrack {\r\n  flex: 1 1 auto;\r\n  min-width: 0;\r\n  max-width: min(78%, 420px);\r\n  margin-inline-start: auto;\r\n  margin-inline-end: 0;\r\n  display: flex;\r\n  flex-direction: row;\r\n  justify-content: flex-end;\r\n  align-items: flex-end;\r\n}\r\n\r\n/* Bolha encolhe à mídia — o track não pode crescer até o max só por flex (faixa vazia à direita da foto) */\r\n.wa-row-out .wa-swipeReplyTrack:has(.wa-bubble.image-message),\r\n.wa-row-out .wa-swipeReplyTrack:has(.wa-bubble.wa-bubble-video:has(.wa-bubble-caption)) {\r\n  flex: 0 1 auto;\r\n  width: fit-content;\r\n  max-width: min(78%, 420px);\r\n}\r\n\r\n.wa-row-in .wa-swipeReplyTrack:has(.wa-bubble.image-message),\r\n.wa-row-in .wa-swipeReplyTrack:has(.wa-bubble.wa-bubble-video:has(.wa-bubble-caption)) {\r\n  flex: 0 1 auto;\r\n  width: fit-content;\r\n  max-width: min(78%, 420px);\r\n}\r\n\r\n.wa-row-in .wa-swipeReplyTrack {\r\n  flex: 1 1 auto;\r\n  min-width: 0;\r\n  max-width: min(78%, 420px);\r\n  margin-inline-end: 0;\r\n  margin-inline-start: 0;\r\n  display: flex;\r\n  flex-direction: row;\r\n  justify-content: flex-start;\r\n  align-items: flex-end;\r\n}\r\n\r\n.wa-swipeReplyShift {\r\n  will-change: transform;\r\n  flex: 0 1 auto;\r\n  /* auto = não encolher abaixo do conteúdo (“Boa tarde” em uma linha) */\r\n  min-width: auto;\r\n  max-width: 100%;\r\n}\r\n\r\n.wa-row-out .wa-swipeReplyShift {\r\n  display: flex;\r\n  justify-content: flex-end;\r\n  align-items: flex-end;\r\n}\r\n\r\n.wa-row-in .wa-swipeReplyShift {\r\n  display: flex;\r\n  justify-content: flex-start;\r\n  align-items: flex-end;\r\n}\r\n\r\n\r\n.wa-swipeReplyShift.wa-swipeReplyShift--spring {\r\n  transition: transform 0.22s cubic-bezier(0.22, 0.82, 0.22, 1);\r\n}\r\n\r\n.wa-swipeReplyTrack:has(.wa-bubble.image-message) .wa-swipeReplyShift,\r\n.wa-swipeReplyTrack:has(.wa-bubble.wa-bubble-video:has(.wa-bubble-caption)) .wa-swipeReplyShift {\r\n  width: fit-content;\r\n  max-width: 100%;\r\n}\r\n\r\n/* Evita flex encolher a bolha abaixo da largura do texto (“Boa tarde” em duas linhas finas) */\r\n.wa-swipeReplyShift > .wa-bubble {\r\n  flex-shrink: 0;\r\n}\r\n\r\n.wa-row > .wa-bubble {\r\n  flex-shrink: 0;\r\n}\r\n\r\n/* =========================================================\r\n   BOLHAS (BUBBLES) — WhatsApp Web premium\r\n   Largura mínima confortável, máx 68%, padding generoso,\r\n   bordas suaves, nunca magrelos. Quebra de linha automática.\r\n========================================================= */\r\n\r\n/* =========================================================\r\n   BOLHAS DE MENSAGEM — estilo WhatsApp Web\r\n========================================================= */\r\n\r\n.wa-bubble {\r\n  position: relative;\r\n  display: inline-block;\r\n\r\n  /* Desktop: evita bolha largura da coluna inteira e força quebra de linha no texto. */\r\n  width: fit-content;\r\n  min-width: auto;\r\n  max-width: min(78%, 560px);\r\n\r\n  padding: 7px 42px 8px 11px;\r\n\r\n  border-radius: 8px;\r\n\r\n  box-shadow:\r\n    0 1px 1px rgba(15, 23, 42, 0.04),\r\n    0 6px 16px -15px rgba(15, 23, 42, 0.28);\r\n\r\n  line-height: 1.4;\r\n  font-size: 14px;\r\n\r\n  overflow-wrap: break-word;\r\n  word-break: normal;\r\n\r\n  box-sizing: border-box;\r\n\r\n  transition: box-shadow 0.15s ease, transform 0.15s ease, outline 0.15s ease, border-color 0.15s ease;\r\n}\r\n\r\n.wa-bubble:hover{\r\n  box-shadow:\r\n    0 2px 5px rgba(15, 23, 42, 0.08),\r\n    0 10px 22px -18px rgba(15, 23, 42, 0.32);\r\n  transform: translateY(-0.5px);\r\n  z-index:2;\r\n}\r\n\r\n[data-theme=\"dark\"] .wa-bubble {\r\n  box-shadow:\r\n    0 1px 1px rgba(0, 0, 0, 0.28),\r\n    0 14px 30px -25px rgba(0, 0, 0, 0.92),\r\n    inset 0 1px 0 rgba(255, 255, 255, 0.035);\r\n}\r\n\r\n[data-theme=\"dark\"] .wa-bubble:hover {\r\n  box-shadow:\r\n    0 2px 6px rgba(0, 0, 0, 0.28),\r\n    0 18px 36px -28px rgba(0, 0, 0, 0.96),\r\n    inset 0 1px 0 rgba(255, 255, 255, 0.045);\r\n}\r\n\r\n/* =========================================================\r\n   CORES IN / OUT\r\n========================================================= */\r\n\r\n.wa-bubble-in{\r\n  background: var(--wa-bubble-in);\r\n  border: 1px solid var(--wa-bubble-border-in);\r\n  border-top-left-radius: 4px;\r\n  color: var(--wa-text);\r\n}\r\n\r\n.wa-bubble-out{\r\n  background: var(--wa-bubble-out);\r\n  border: 1px solid var(--wa-bubble-border-out);\r\n  border-top-right-radius: 4px;\r\n  color: var(--wa-text);\r\n}\r\n\r\n[data-theme=\"dark\"] .wa-bubble-in {\r\n  background:\r\n    linear-gradient(180deg, color-mix(in srgb, var(--wa-bubble-in) 92%, #ffffff 8%), var(--wa-bubble-in));\r\n  border-color: var(--wa-bubble-border-in);\r\n}\r\n\r\n[data-theme=\"dark\"] .wa-bubble-out {\r\n  background:\r\n    linear-gradient(180deg, color-mix(in srgb, var(--wa-bubble-out) 92%, #ffffff 8%), var(--wa-bubble-out));\r\n  border-color: var(--wa-bubble-border-out);\r\n}\r\n\r\n/* Placeholder “apagada para todos” — texto discreto tipo WhatsApp */\r\n.wa-bubble.wa-bubble--revokedEveryone {\r\n  opacity: 0.94;\r\n}\r\n.wa-bubble.wa-bubble--revokedEveryone:hover {\r\n  opacity: 1;\r\n}\r\n.wa-bubble.wa-bubble--revokedEveryone .wa-bubble-text {\r\n  font-style: italic;\r\n  color: var(--wa-text-muted, rgba(17, 27, 33, 0.62));\r\n}\r\n\r\n[data-theme=\"dark\"] .wa-bubble.wa-bubble--revokedEveryone .wa-bubble-text {\r\n  color: rgba(233, 237, 239, 0.72);\r\n}\r\n\r\n.wa-bubble.wa-bubble--revokedEveryone .wa-bubble-caption,\r\n.wa-bubble.wa-bubble--revokedEveryone .wa-bubble-audioCaption {\r\n  font-style: italic;\r\n  color: var(--wa-text-muted, rgba(17, 27, 33, 0.62));\r\n  font-size: 0.92em;\r\n}\r\n\r\n[data-theme=\"dark\"] .wa-bubble.wa-bubble--revokedEveryone .wa-bubble-caption,\r\n[data-theme=\"dark\"] .wa-bubble.wa-bubble--revokedEveryone .wa-bubble-audioCaption {\r\n  color: rgba(233, 237, 239, 0.68);\r\n}\r\n\r\n/* =========================================================\r\n   CAUDA DA BOLHA\r\n========================================================= */\r\n\r\n.wa-bubble-in::after,\r\n.wa-bubble-out::after{\r\n  content:\"\";\r\n  position:absolute;\r\n  bottom:0;\r\n\r\n  width:8px;\r\n  height:9px;\r\n\r\n  pointer-events:none;\r\n}\r\n\r\n.wa-bubble-in::after{\r\n  left:-3px;\r\n  background:var(--wa-bubble-in);\r\n\r\n  clip-path:polygon(\r\n    100% 0,\r\n    0 100%,\r\n    100% 100%\r\n  );\r\n}\r\n\r\n.wa-bubble-out::after{\r\n  right:-3px;\r\n  background:var(--wa-bubble-out);\r\n\r\n  clip-path:polygon(\r\n    0 0,\r\n    0 100%,\r\n    100% 100%\r\n  );\r\n}\r\n\r\n/* =========================================================\r\n   CORPO DO BALÃO\r\n========================================================= */\r\n\r\n.wa-bubble-body{\r\n\r\n  width:auto;\r\n  max-width:100%;\r\n  min-width:0;\r\n\r\n  word-break:normal;\r\n  overflow-wrap:break-word;\r\n  white-space:pre-wrap;\r\n\r\n  padding-bottom:0;\r\n\r\n  display:flex;\r\n  flex-direction:column;\r\n  justify-content:flex-start;\r\n}\r\n\r\n/* =========================================================\r\n   TEXTO\r\n========================================================= */\r\n\r\n.wa-bubble-text{\r\n\r\n  font-size:14px;\r\n  line-height:1.38;\r\n\r\n  padding-right:0;\r\n\r\n  color:var(--wa-text);\r\n\r\n  word-break:normal;\r\n  overflow-wrap:break-word;\r\n  min-width:0;\r\n}\r\n\r\n/* =========================================================\r\n   REMETENTE (GRUPOS)\r\n========================================================= */\r\n\r\n.wa-bubble-remetente{\r\n\r\n  font-size:12px;\r\n  font-weight:500;\r\n\r\n  margin-bottom:2px;\r\n\r\n  color:#667781;\r\n}\r\n\r\n/* =========================================================\r\n   TEXTO + META\r\n========================================================= */\r\n\r\n.wa-bubble.hasInlineMeta{\r\n\r\n  min-width:auto;\r\n\r\n  padding:5px 36px 5px 8px;\r\n}\r\n\r\n/* Texto curto (\"oi\"): hora + ticks na mesma linha; texto longo: meta abaixo alinhada à direita */\r\n.wa-bubble-textInline{\r\n  display:flex;\r\n  flex-direction:row;\r\n  flex-wrap:wrap;\r\n  align-items:baseline;\r\n  gap:4px 6px;\r\n  min-width:0;\r\n}\r\n\r\n.wa-bubble-textInline > .wa-inlineMeta{\r\n  flex-shrink:0;\r\n  margin-left:2px;\r\n}\r\n\r\n.wa-bubble-textInline > .wa-link{\r\n  min-width:0;\r\n}\r\n\r\n/* =========================================================\r\n   META (HORA + TICKS)\r\n========================================================= */\r\n\r\n.wa-inlineMeta{\r\n  display:inline-flex;\r\n  align-items:center;\r\n  gap:2px;\r\n  flex-shrink:0;\r\n  font-size:10.5px;\r\n  color:var(--wa-text-light);\r\n  font-variant-numeric:tabular-nums;\r\n  white-space:nowrap;\r\n  line-height:1;\r\n}\r\n\r\n/* =========================================================\r\n   TICKS\r\n========================================================= */\r\n\r\n.wa-inlineMeta .wa-ticks{\r\n\r\n  display:inline-flex;\r\n\r\n  align-items:center;\r\n\r\n  line-height:1;\r\n\r\n  margin-left:2px;\r\n}\r\n\r\n.wa-inlineMeta .wa-ticksSvg,\r\n.wa-inlineMeta .wa-ticks svg{\r\n\r\n  width:14px;\r\n  height:11px;\r\n}\r\n\r\n/* =========================================================\r\n   LINKS\r\n========================================================= */\r\n\r\n.wa-bubble-text a{\r\n\r\n  color:#53bdeb;\r\n\r\n  text-decoration:none;\r\n}\r\n\r\n.wa-bubble-text a:hover{\r\n\r\n  text-decoration:underline;\r\n}\r\n\r\n/* =========================================================\r\n   EMOJIS\r\n========================================================= */\r\n\r\n.wa-bubble-text img.emoji{\r\n\r\n  width:20px;\r\n  height:20px;\r\n\r\n  vertical-align:-4px;\r\n}\r\n\r\n/* =========================================================\r\n   MENSAGENS LONGAS\r\n========================================================= */\r\n\r\n.wa-bubble-text p{\r\n\r\n  margin:0;\r\n}\r\n\r\n/* =========================================================\r\n   RESPONSIVO\r\n========================================================= */\r\n\r\n@media (max-width:768px){\r\n\r\n  .wa-swipeReplyTrack {\r\n    max-width: min(85%, 480px);\r\n  }\r\n\r\n  .wa-row-out .wa-swipeReplyTrack,\r\n  .wa-row-in .wa-swipeReplyTrack {\r\n    max-width: min(85%, 480px);\r\n  }\r\n\r\n  .wa-bubble{\r\n\r\n    font-size:16px;\r\n  }\r\n\r\n  .wa-bubble-text{\r\n\r\n    font-size:16px;\r\n  }\r\n\r\n  .wa-bubble-audioCaption {\r\n    font-size: 16px;\r\n  }\r\n}\r\n\r\n/* =========================================================\r\n   TABLET / IPAD (740–1024px) — atendimento: cabeçalho, composer e bolhas\r\n   Não altera mobile (≤640) nem desktop largo (>1024).\r\n========================================================= */\r\n@media (min-width: 740px) and (max-width: 1024px) {\r\n  .wa-header {\r\n    padding: 12px 12px 14px;\r\n    min-height: 72px;\r\n    gap: 8px;\r\n    align-items: center;\r\n    overflow-x: clip;\r\n    min-width: 0;\r\n  }\r\n\r\n  .wa-header-left {\r\n    gap: 10px;\r\n    min-width: 0;\r\n    flex: 1 1 0;\r\n  }\r\n\r\n  .wa-header-info {\r\n    min-width: 0;\r\n  }\r\n\r\n  .wa-header-name {\r\n    max-width: 100%;\r\n  }\r\n\r\n  /* Uma linha: status + setor + botão; rolagem horizontal se faltar largura (evita “Transferir setor” descendo sobre o thread) */\r\n  .wa-header-metaStrip {\r\n    flex-wrap: nowrap;\r\n    align-items: center;\r\n    gap: 6px;\r\n    overflow-x: auto;\r\n    overflow-y: visible;\r\n    max-width: 100%;\r\n    min-height: 30px;\r\n    padding-top: 3px;\r\n    padding-bottom: 3px;\r\n    box-sizing: border-box;\r\n    scrollbar-width: none;\r\n    -webkit-overflow-scrolling: touch;\r\n    /* Fade só no fim da faixa; não mascarar o início (pill “Aberta” colado à esquerda) */\r\n    mask-image: linear-gradient(to right, #000 0, #000 calc(100% - 14px), transparent calc(100% - 2px));\r\n    mask-size: 100% 100%;\r\n    mask-repeat: no-repeat;\r\n  }\r\n\r\n  [data-theme=\"dark\"] .wa-header-metaStrip {\r\n    mask-image: linear-gradient(to right, #000 0, #000 calc(100% - 14px)