ckdrop-filter: none;\r\n}\r\n[data-theme=\"dark\"] .wa-audioPlayer:hover {\r\n  border-color: var(--wa-audio-border-in);\r\n  box-shadow: 0 2px 8px rgba(0,0,0,.25);\r\n}\r\n[data-theme=\"dark\"] .wa-bubble-out .wa-audioPlayer {\r\n  background: var(--wa-audio-surface-out);\r\n  border-color: var(--wa-audio-border-out);\r\n}\r\n\r\n.wa-audioPlayBtn {\r\n  width: 44px;\r\n  height: 44px;\r\n  border-radius: 999px;\r\n  border: 1px solid rgba(0,0,0,.10);\r\n  background:\r\n    radial-gradient(120% 120% at 30% 20%, rgba(0,168,132,.22) 0%, rgba(0,168,132,.10) 35%, rgba(255,255,255,.75) 100%);\r\n  color: rgba(0, 92, 70, 0.95);\r\n  display:flex;\r\n  align-items:center;\r\n  justify-content:center;\r\n  cursor:pointer;\r\n  flex-shrink:0;\r\n  box-shadow: 0 10px 22px rgba(0,0,0,.10);\r\n  position: relative;\r\n  overflow: hidden;\r\n  transition:\r\n    transform 0.26s cubic-bezier(0.34, 1.45, 0.64, 1),\r\n    box-shadow 0.28s ease,\r\n    border-color 0.2s ease,\r\n    filter 0.2s ease;\r\n}\r\n.wa-bubble-out .wa-audioPlayBtn{\r\n  border-color: rgba(0,0,0,.08);\r\n}\r\n.wa-audioPlayBtn:hover:not(:disabled){\r\n  transform: translateY(-0.5px);\r\n  filter: saturate(1.05);\r\n}\r\n.wa-audioPlayBtn:active{ transform: scale(0.94); }\r\n.wa-audioPlayBtn.isPlaying {\r\n  box-shadow:\r\n    0 0 0 3px rgba(0, 168, 132, 0.14),\r\n    0 12px 28px rgba(0, 0, 0, 0.12);\r\n}\r\n.wa-audioPlayBtn:focus-visible{\r\n  outline: none;\r\n  box-shadow: 0 0 0 3px rgba(0,168,132,.22), 0 10px 22px rgba(0,0,0,.10);\r\n}\r\n\r\n.wa-audioPlayIcon{\r\n  position: absolute;\r\n  inset: 0;\r\n  display:flex;\r\n  align-items:center;\r\n  justify-content:center;\r\n  transition: opacity 0.24s ease, transform 0.32s cubic-bezier(0.34, 1.45, 0.64, 1);\r\n}\r\n.wa-audioPlayIcon--play{ opacity: 1; transform: scale(1); }\r\n.wa-audioPlayIcon--pause{ opacity: 0; transform: scale(.78); }\r\n.wa-audioPlayBtn.isPlaying .wa-audioPlayIcon--play{ opacity: 0; transform: scale(.78); }\r\n.wa-audioPlayBtn.isPlay