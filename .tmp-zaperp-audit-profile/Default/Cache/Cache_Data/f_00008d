n  outline: 2px solid rgba(0, 168, 132, 0.55);\r\n  box-shadow:\r\n    0 4px 20px rgba(0, 168, 132, 0.22),\r\n    0 2px 8px rgba(0, 0, 0, 0.12);\r\n}\r\n\r\n@keyframes wa-bubbleMenuLift {\r\n  from {\r\n    transform: scale(0.97);\r\n    opacity: 0.92;\r\n  }\r\n  to {\r\n    transform: scale(1);\r\n    opacity: 1;\r\n  }\r\n}\r\n\r\n.wa-bubble-badge {\r\n  font-size: 11px;\r\n  opacity: 0.75;\r\n  margin-left: 2px;\r\n}\r\n\r\n/* =========================================================\r\n   MODAL (Dados da mensagem)\r\n========================================================= */\r\n\r\n.wa-modalOverlay {\r\n  position: fixed;\r\n  inset: 0;\r\n  background: rgba(0, 0, 0, 0.36);\r\n  z-index: 10000;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  padding: 16px;\r\n  animation: wa-overlayFade 0.18s ease-out;\r\n}\r\n\r\n.wa-imageViewerOverlay {\r\n  background: rgba(0, 0, 0, 0.92);\r\n  animation: wa-overlayFade 0.2s ease-out;\r\n}\r\n\r\n.wa-imageViewer {\r\n  max-width: min(900px, 98vw);\r\n  max-height: min(90vh, 98vh);\r\n  border-radius: 12px;\r\n  overflow: hidden;\r\n  box-shadow: 0 24px 80px rgba(0, 0, 0, 0.85);\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n}\r\n\r\n.wa-imageViewer-img {\r\n  max-width: 100%;\r\n  max-height: 100%;\r\n  object-fit: contain;\r\n  display: block;\r\n}\r\n\r\n/* Media Viewer — foto/vídeo/figurinha/arquivo na mesma página (estilo WhatsApp) */\r\n.wa-mediaViewerOverlay {\r\n  background: rgba(0, 0, 0, 0.92);\r\n  cursor: default;\r\n  animation: wa-overlayFade 0.2s ease-out;\r\n}\r\n\r\n.wa-mediaViewer {\r\n  position: relative;\r\n  max-width: min(900px, 98vw);\r\n  max-height: min(90vh, 98vh);\r\n  border-radius: 12px;\r\n  overflow: hidden;\r\n  box-shadow: 0 24px 80px rgba(0, 0, 0, 0.85);\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  background: #000;\r\n}\r\n\r\n.wa-mediaViewer-actions {\r\n  position: absolute;\r\n  top: 12px;\r\n  right: 12px;\r\n  z-index: 12;\r\n  display: flex;\r\n  flex-direction: row;\r\n  align-items: center;\r\n  gap: 8px;\r\n}\r\n\r\n.wa-mediaViewer-print {\r\n  width: 40px;\r\n  height: 40px;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  border: none;\r\n  border-radius: 50%;\r\n  background: rgba(255, 255, 255, 0.2);\r\n  color: #fff;\r\n  cursor: pointer;\r\n  transition: background 0.2s, transform 0.2s ease, box-shadow 0.2s ease, opacity 0.2s ease;\r\n}\r\n\r\n.wa-mediaViewer-print:hover:not(:disabled) {\r\n  background: rgba(255, 255, 255, 0.35);\r\n  transform: scale(1.06);\r\n  box-shadow: 0 2px 12px rgba(0, 0, 0, 0.2);\r\n}\r\n\r\n.wa-mediaViewer-print:disabled {\r\n  opacity: 0.45;\r\n  cursor: not-allowed;\r\n}\r\n\r\n.wa-mediaViewer-close {\r\n  width: 40px;\r\n  height: 40px;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  border: none;\r\n  border-radius: 50%;\r\n  background: rgba(255, 255, 255, 0.2);\r\n  color: #fff;\r\n  cursor: pointer;\r\n  transition: background 0.2s, transform 0.2s ease, box-shadow 0.2s ease;\r\n}\r\n.wa-mediaViewer-close:hover {\r\n  background: rgba(255, 255, 255, 0.35);\r\n  transform: scale(1.06);\r\n  box-shadow: 0 2px 12px rgba(0, 0, 0, 0.2);\r\n}\r\n\r\n.wa-mediaViewer-videoWrap {\r\n  display: flex;\r\n  flex-direction: column;\r\n  align-items: center;\r\n  justify-content: center;\r\n  gap: 10px;\r\n  max-width: 100%;\r\n  max-height: min(90vh, 98vh);\r\n}\r\n\r\n.wa-mediaViewer-videoPrintHint {\r\n  margin: 0;\r\n  padding: 0 14px 8px;\r\n  font-size: 12px;\r\n  line-height: 1.4;\r\n  color: rgba(255, 255, 255, 0.72);\r\n  text-align: center;\r\n  max-width: min(420px, 92vw);\r\n}\r\n\r\n.wa-mediaViewer-img {\r\n  max-width: 100%;\r\n  max-height: calc(100vh - 80px);\r\n  object-fit: contain;\r\n  display: block;\r\n}\r\n\r\n.wa-mediaViewer-video {\r\n  max-width: 100%;\r\n  max-height: calc(100vh - 80px);\r\n  width: auto;\r\n  height: auto;\r\n  display: block;\r\n}\r\n\r\n.wa-mediaViewer-iframe {\r\n  width: min(90vw, 800px);\r\n  height: min(85vh, 700px);\r\n  border: none;\r\n  display: block;\r\n}\r\n\r\n.wa-mediaViewer-pdfState {\r\n  box-sizing: border-box;\r\n  display: flex;\r\n  flex-direction: column;\r\n  align-items: center;\r\n  justify-content: center;\r\n  gap: 12px;\r\n  padding: 24px;\r\n  color: #fff;\r\n  text-align: center;\r\n  background: rgba(0, 0, 0, 0.25);\r\n}\r\n\r\n.wa-mediaViewer-file {\r\n  display: flex;\r\n  flex-direction: column;\r\n  align-items: center;\r\n  gap: 16px;\r\n  padding: 32px;\r\n  color: #fff;\r\n}\r\n.wa-mediaViewer-fileIcon {\r\n  font-size: 48px;\r\n}\r\n.wa-mediaViewer-fileName {\r\n  font-size: 16px;\r\n  word-break: break-all;\r\n  text-align: center;\r\n}\r\n\r\n.wa-modal {\r\n  width: min(520px, 100%);\r\n  max-height: min(520px, 90vh);\r\n  overflow: auto;\r\n  background: var(--ds-bg-raised);\r\n  border: 1px solid var(--ds-border);\r\n  border-radius: var(--ds-radius-lg);\r\n  box-shadow: var(--ds-shadow-lg);\r\n  animation: wa-modalScale 0.22s cubic-bezier(0.34, 1.56, 0.64, 1);\r\n}\r\n\r\n/* Modal de transferência (atendentes) */\r\n.wa-transferModal{\r\n  width: min(420px, 100%);\r\n}\r\n.wa-transferSearch {\r\n  width: 100%;\r\n  height: 38px;\r\n  padding: 0 12px;\r\n  border-radius: var(--ds-radius-lg);\r\n  border: 1px solid var(--ds-border);\r\n  background: var(--ds-input-bg);\r\n  color: var(--wa-text);\r\n  font-size: 13px;\r\n  outline: none;\r\n}\r\n.wa-transferSearch:focus {\r\n  box-shadow: 0 0 0 2px var(--ds-focus-ring);\r\n  border-color: var(--ds-accent-soft);\r\n}\r\n.wa-transferList{\r\n  display: grid;\r\n  gap: 6px;\r\n  max-height: 260px;\r\n  overflow: auto;\r\n  padding-right: 2px;\r\n}\r\n.wa-transferItem {\r\n  width: 100%;\r\n  text-align: left;\r\n  border-radius: var(--ds-radius-lg);\r\n  border: 1px solid var(--ds-border);\r\n  background: var(--ds-hover);\r\n  padding: 10px 12px;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  gap: 10px;\r\n  cursor: pointer;\r\n}\r\n.wa-transferItem:hover:not(:disabled) {\r\n  background: var(--ds-hover-strong);\r\n}\r\n.wa-transferItem:disabled{\r\n  opacity: .55;\r\n  cursor: not-allowed;\r\n}\r\n.wa-transferItem.isMe{\r\n  border-color: rgba(14,165,233,.22);\r\n  background: rgba(14,165,233,.06);\r\n}\r\n.wa-transferName{\r\n  font-size: 13px;\r\n  font-weight: 650;\r\n  color: var(--wa-text);\r\n  overflow: hidden;\r\n  text-overflow: ellipsis;\r\n  white-space: nowrap;\r\n}\r\n.wa-transferBadge{\r\n  font-size: 11px;\r\n  font-weight: 700;\r\n  color: #0284c7;\r\n  background: rgba(14,165,233,.14);\r\n  border: 1px solid rgba(14,165,233,.22);\r\n  padding: 2px 8px;\r\n  border-radius: 999px;\r\n  flex: 0 0 auto;\r\n}\r\n.wa-transferEmpty{\r\n  font-size: 12px;\r\n  color: var(--wa-text-muted);\r\n  padding: 8px 2px;\r\n}\r\n.wa-transferFooter{\r\n  display:flex;\r\n  justify-content:flex-end;\r\n}\r\n\r\n.wa-modal-head {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  gap: 12px;\r\n  padding: 12px 14px;\r\n  border-bottom: 1px solid var(--ds-border);\r\n}\r\n\r\n.wa-modal-title {\r\n  font-size: 14px;\r\n  font-weight: 700;\r\n  color: var(--wa-text);\r\n}\r\n\r\n.wa-modal-body {\r\n  padding: 12px 14px 14px;\r\n  display: grid;\r\n  gap: 10px;\r\n}\r\n\r\n.wa-modal-row {\r\n  display: grid;\r\n  grid-template-columns: 120px 1fr;\r\n  gap: 10px;\r\n  align-items: start;\r\n}\r\n\r\n.wa-modal-row.wa-modal-row--hint {\r\n  grid-template-columns: 1fr;\r\n  font-size: 13px;\r\n  line-height: 1.4;\r\n  color: var(--wa-text-muted);\r\n}\r\n\r\n.wa-modal-row.wa-modal-row--actions {\r\n  display: flex;\r\n  justify-content: flex-end;\r\n  flex-wrap: wrap;\r\n  gap: 8px;\r\n  padding-top: 4px;\r\n}\r\n\r\n.wa-modal-label {\r\n  font-size: 12px;\r\n  color: var(--wa-text-muted);\r\n}\r\n\r\n.wa-modal-value {\r\n  font-size: 13px;\r\n  color: var(--wa-text);\r\n  word-break: break-word;\r\n}\r\n\r\n.wa-mono {\r\n  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, \"Liberation Mono\", \"Courier New\", monospace;\r\n  font-size: 12px;\r\n}\r\n\r\n@media (max-width: 520px) {\r\n  .wa-modal-row { grid-template-columns: 1fr; }\r\n}\r\n\r\n/* =========================================================\r\n   SELEÇÃO / BARRAS (fixada e seleção)\r\n========================================================= */\r\n\r\n.wa-selectChk {\r\n  width: 24px;\r\n  height: 24px;\r\n  border-radius: 999px;\r\n  border: 1px solid rgba(0,0,0,.18);\r\n  background: rgba(255,255,255,.85);\r\n  color: var(--wa-text);\r\n  cursor: pointer;\r\n  display: inline-flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  font-size: 13px;\r\n  line-height: 1;\r\n  margin: 8px 8px 0 0;\r\n  flex-shrink: 0;\r\n  transition: border-color 0.15s ease, background 0.15s ease, color 0.15s ease, transform 0.12s ease;\r\n}\r\n.wa-selectChk:hover {\r\n  transform: scale(1.06);\r\n}\r\n.wa-selectChk:active {\r\n  transform: scale(0.94);\r\n}\r\n\r\n.wa-selectChk.isOn {\r\n  border-color: rgba(0,168,132,.55);\r\n  background: rgba(0,168,132,.10);\r\n  color: var(--wa-green);\r\n}\r\n\r\n.wa-bubble.isSelected {\r\n  outline: 2px solid rgba(0, 168, 132, 0.42);\r\n  box-shadow: 0 2px 14px rgba(0, 168, 132, 0.18);\r\n  animation: wa-bubbleSelectedIn 0.24s cubic-bezier(0.22, 0.82, 0.22, 1);\r\n  transition: outline 0.15s ease, box-shadow 0.15s ease;\r\n}\r\n\r\n@keyframes wa-bubbleSelectedIn {\r\n  from {\r\n    transform: scale(0.985);\r\n  }\r\n  to {\r\n    transform: scale(1);\r\n  }\r\n}\r\n\r\n/* Modo seleção: escurece e embassa o fundo do histórico (mensagens selecionadas permanecem legíveis por z-index) */\r\n.wa-messages.wa-messages--selectDim > .wa-messages-selectDim {\r\n  position: absolute;\r\n  inset: 0;\r\n  z-index: 0;\r\n  background: rgba(17, 27, 33, 0.38);\r\n  backdrop-filter: blur(3px);\r\n  -webkit-backdrop-filter: blur(3px);\r\n  pointer-events: none;\r\n}\r\n\r\n[data-theme=\"dark\"] .wa-messages.wa-messages--selectDim > .wa-messages-selectDim {\r\n  background: rgba(0, 0, 0, 0.45);\r\n}\r\n\r\n.wa-messages.wa-messages--selectDim > .wa-selectBar {\r\n  position: sticky;\r\n  top: 0;\r\n  z-index: 6;\r\n}\r\n\r\n.wa-messages.wa-messages--selectDim .wa-row:has(.wa-bubble.isSelected) {\r\n  z-index: 2;\r\n}\r\n\r\n.wa-selectBar,\r\n.wa-pinBar {\r\n  position: sticky;\r\n  top: 0;\r\n  z-index: 3;\r\n  margin: 0 0 8px 0;\r\n  padding: 10px 12px;\r\n  border-radius: 12px;\r\n  background: rgba(255, 255, 255, 0.92);\r\n  border: 1px solid rgba(0,0,0,.06);\r\n  box-shadow: var(--wa-shadow-subtle);\r\n  backdrop-filter: blur(8px);\r\n  /* Superfície sempre clara: texto escuro (tema escuro usa --wa-text claro no resto da tela) */\r\n  color: #0f172a;\r\n}\r\n\r\n.wa-selectBar {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  gap: 10px;\r\n}\r\n\r\n.wa-selectBar-left {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 10px;\r\n  min-width: 0;\r\n}\r\n\r\n.wa-selectBar-count {\r\n  font-size: 13px;\r\n  color: #475569;\r\n  white-space: nowrap;\r\n}\r\n\r\n.wa-selectBar-actions {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: flex-end;\r\n  gap: 8px;\r\n  flex-shrink: 0;\r\n  flex-wrap: wrap;\r\n}\r\n\r\n/* Encaminhar + Apagar: mesma largura base no desktop (evita “faixa” verde enorme). */\r\n.wa-selectBar--forwardIntent .wa-selectBar-actions {\r\n  flex: 1 1 auto;\r\n  min-width: 0;\r\n  max-width: min(100%, 360px);\r\n  gap: 10px;\r\n}\r\n\r\n.wa-selectBar--forwardIntent .wa-selectBar-actions .wa-btn-primary,\r\n.wa-selectBar--forwardIntent .wa-selectBar-actions .wa-btn-danger {\r\n  flex: 1 1 0%;\r\n  min-width: 0;\r\n  min-height: 40px;\r\n  justify-content: center;\r\n  font-weight: 600;\r\n  padding-left: 12px;\r\n  padding-right: 12px;\r\n}\r\n\r\n.wa-selectBar .wa-btn-ghost {\r\n  color: #0f172a;\r\n  background: rgba(15, 23, 42, 0.07);\r\n  border: 1px solid rgba(15, 23, 42, 0.1);\r\n  font-weight: 600;\r\n}\r\n\r\n.wa-selectBar .wa-btn-ghost:hover:not(:disabled) {\r\n  background: rgba(15, 23, 42, 0.11);\r\n  border-color: rgba(15, 23, 42, 0.14);\r\n}\r\n\r\n.wa-selectBar--compactUx {\r\n  padding: 10px 12px;\r\n  border-radius: 14px;\r\n  box-shadow: 0 4px 24px rgba(0, 0, 0, 0.08);\r\n}\r\n\r\n.wa-selectBar-close {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  width: 40px;\r\n  height: 40px;\r\n  padding: 0;\r\n  border: 1px solid rgba(15, 23, 42, 0.12);\r\n  border-radius: 50%;\r\n  background: rgba(15, 23, 42, 0.08);\r\n  color: #0f172a;\r\n  cursor: pointer;\r\n  flex-shrink: 0;\r\n  transition: background 0.15s ease, transform 0.12s ease, border-color 0.15s ease;\r\n}\r\n\r\n.wa-selectBar-close:hover {\r\n  background: rgba(15, 23, 42, 0.12);\r\n  border-color: rgba(15, 23, 42, 0.18);\r\n}\r\n\r\n.wa-selectBar-close:active {\r\n  transform: scale(0.94);\r\n}\r\n\r\n.wa-selectBar-forwardFab {\r\n  min-height: 44px;\r\n  padding: 10px 18px !important;\r\n  border-radius: 999px !important;\r\n  display: inline-flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  gap: 8px;\r\n}\r\n\r\n.wa-selectBar-forwardFab svg {\r\n  flex-shrink: 0;\r\n}\r\n\r\n.wa-selectBar-forwardText {\r\n  margin-left: 2px;\r\n  overflow: hidden;\r\n  text-overflow: ellipsis;\r\n  white-space: nowrap;\r\n  min-width: 0;\r\n}\r\n\r\n/* Apagar ao lado de Encaminhar: contraste sólido (evita rosa “lavado”). */\r\n.wa-selectBar--forwardIntent .wa-selectBar-actions .wa-btn-danger {\r\n  background: #c5342d;\r\n  color: #fff;\r\n  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.12);\r\n}\r\n.wa-selectBar--forwardIntent .wa-selectBar-actions .wa-btn-danger:hover:not(:disabled) {\r\n  background: #ae2e28;\r\n  filter: none;\r\n}\r\n.wa-selectBar--forwardIntent .wa-selectBar-actions .wa-btn-danger:active:not(:disabled) {\r\n  background: #9c2924;\r\n}\r\n.wa-selectBar--forwardIntent .wa-selectBar-actions .wa-btn-danger:disabled {\r\n  opacity: 0.55;\r\n}\r\n\r\n.wa-pinBar {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 10px;\r\n  cursor: pointer;\r\n}\r\n\r\n.wa-pinBar-ic {\r\n  opacity: .8;\r\n}\r\n\r\n.wa-pinBar-text {\r\n  font-size: 13px;\r\n  color: #0f172a;\r\n  overflow: hidden;\r\n  text-overflow: ellipsis;\r\n  white-space: nowrap;\r\n  flex: 1;\r\n  min-width: 0;\r\n}\r\n\r\n.wa-pinBar-hint {\r\n  font-size: 12px;\r\n  color: #64748b;\r\n  white-space: nowrap;\r\n}\r\n\r\n/* Botão danger (reutilizado em barras) */\r\n.wa-btn-danger {\r\n  background: rgba(180, 35, 24, 0.10);\r\n  color: #b42318;\r\n}\r\n.wa-btn-danger:hover:not(:disabled) {\r\n  background: rgba(180, 35, 24, 0.16);\r\n}\r\n\r\n/* =========================================================\r\n   RESPONDER (barra acima do input)\r\n========================================================= */\r\n\r\n.wa-replyBar {\r\n  flex: 0 0 auto;\r\n  padding: 10px 12px;\r\n  background: var(--wa-header-bg);\r\n  border-top: 1px solid var(--wa-panel-border);\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 10px;\r\n  animation: wa-replyBarSlide 0.2s ease-out;\r\n}\r\n\r\n.wa-replyBar-bar{\r\n  width: 4px;\r\n  height: 34px;\r\n  border-radius: 999px;\r\n  background: rgba(0,168,132,.75);\r\n  flex: 0 0 auto;\r\n}\r\n\r\n.wa-replyBar-thumb {\r\n  width: 42px;\r\n  height: 42px;\r\n  border-radius: 6px;\r\n  object-fit: cover;\r\n  flex-shrink: 0;\r\n  background: rgba(0, 0, 0, 0.06);\r\n  align-self: center;\r\n}\r\n\r\n.wa-replyBar-left {\r\n  min-width: 0;\r\n  flex: 1;\r\n}\r\n\r\n.wa-replyBar-title {\r\n  font-size: 12px;\r\n  font-weight: 700;\r\n  color: rgba(0, 168, 132, 0.95);\r\n  line-height: 1.15;\r\n}\r\n\r\n.wa-replyBar-text {\r\n  font-size: 12px;\r\n  color: var(--wa-text-muted);\r\n  overflow: hidden;\r\n  text-overflow: ellipsis;\r\n  white-space: nowrap;\r\n  max-width: 100%;\r\n  margin-top: 2px;\r\n}\r\n\r\n/* =========================================================\r\n   CITAÇÃO / REPLY — harmonizado estilo WhatsApp\r\n========================================================= */\r\n.wa-replyCtx {\r\n  display: flex;\r\n  flex-direction: row;\r\n  align-items: stretch;\r\n  gap: 0;\r\n  margin: 0 0 5px;\r\n  padding: 0;\r\n  border-radius: 7px;\r\n  overflow: hidden;\r\n  background: rgba(0, 0, 0, 0.05);\r\n  border: none;\r\n  box-shadow: none;\r\n  cursor: pointer;\r\n  min-width: 0;\r\n  max-width: 100%;\r\n  transition: background 0.12s ease;\r\n}\r\n.wa-replyCtx:hover {\r\n  background: rgba(0, 0, 0, 0.07);\r\n}\r\n.wa-replyCtx.isOut {\r\n  background: rgba(0, 0, 0, 0.07);\r\n}\r\n.wa-replyCtx.isOut:hover {\r\n  background: rgba(0, 0, 0, 0.09);\r\n}\r\n/* barra lateral — acento fino integrado ao balão */\r\n.wa-replyCtx-bar {\r\n  width: 4px;\r\n  min-width: 4px;\r\n  border-radius: 7px 0 0 7px;\r\n  background: #667781;\r\n  flex-shrink: 0;\r\n}\r\n.wa-bubble-in .wa-replyCtx.isIn .wa-replyCtx-bar {\r\n  background: var(--wa-green, #00a884);\r\n}\r\n.wa-replyCtx.isOut .wa-replyCtx-bar {\r\n  background: var(--wa-status-blue, #53bdeb);\r\n}\r\n.wa-replyCtx-content {\r\n  flex: 1;\r\n  padding: 5px 8px 5px 6px;\r\n  min-width: 0;\r\n  display: flex;\r\n  flex-direction: row;\r\n  align-items: center;\r\n  gap: 7px;\r\n}\r\n.wa-replyCtx-thumb {\r\n  display: block;\r\n  width: 38px;\r\n  height: 38px;\r\n  border-radius: 5px;\r\n  object-fit: cover;\r\n  flex-shrink: 0;\r\n  background: rgba(0, 0, 0, 0.08);\r\n  align-self: center;\r\n}\r\n.wa-replyCtx-textStack {\r\n  flex: 1;\r\n  min-width: 0;\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 1px;\r\n  justify-content: center;\r\n}\r\n@media (min-width: 1025px) {\r\n  .wa-replyCtx-thumb {\r\n    width: 40px;\r\n    height: 40px;\r\n  }\r\n}\r\n.wa-replyCtx-name {\r\n  font-size: 12.5px;\r\n  font-weight: 600;\r\n  line-height: 1.15;\r\n  color: #667781;\r\n  white-space: nowrap;\r\n  overflow: hidden;\r\n  text-overflow: ellipsis;\r\n}\r\n.wa-bubble-in .wa-replyCtx.isIn .wa-replyCtx-name {\r\n  color: var(--wa-green, #00a884);\r\n}\r\n.wa-replyCtx.isOut .wa-replyCtx-name {\r\n  color: #1d6f8f;\r\n}\r\n.wa-replyCtx-snippet {\r\n  font-size: 12px;\r\n  line-height: 1.25;\r\n  color: var(--wa-text-muted);\r\n  overflow: hidden;\r\n  text-overflow: ellipsis;\r\n  white-space: nowrap;\r\n  max-width: 100%;\r\n}\r\n.wa-replyCtx.isOut .wa-replyCtx-snippet {\r\n  color: rgba(17, 27, 33, 0.68);\r\n}\r\n/* Dark mode — citação integrada ao balão, sem “caixa dentro da caixa” */\r\n[data-theme=\"dark\"] .wa-replyCtx {\r\n  background: rgba(0, 0, 0, 0.2);\r\n  border: none;\r\n}\r\n[data-theme=\"dark\"] .wa-replyCtx:hover {\r\n  background: rgba(0, 0, 0, 0.26);\r\n}\r\n[data-theme=\"dark\"] .wa-replyCtx.isOut {\r\n  background: rgba(0, 0, 0, 0.14);\r\n}\r\n[data-theme=\"dark\"] .wa-replyCtx.isOut:hover {\r\n  background: rgba(0, 0, 0, 0.18);\r\n}\r\n[data-theme=\"dark\"] .wa-bubble-in .wa-replyCtx.isIn .wa-replyCtx-name {\r\n  color: #53bdeb;\r\n}\r\n[data-theme=\"dark\"] .wa-bubble-in .wa-replyCtx.isIn .wa-replyCtx-bar {\r\n  background: #53bdeb;\r\n}\r\n[data-theme=\"dark\"] .wa-replyCtx.isOut .wa-replyCtx-name {\r\n  color: rgba(255, 255, 255, 0.92);\r\n}\r\n[data-theme=\"dark\"] .wa-replyCtx-snippet {\r\n  color: rgba(233, 237, 239, 0.72);\r\n}\r\n[data-theme=\"dark\"] .wa-replyCtx.isOut .wa-replyCtx-snippet {\r\n  color: rgba(255, 255, 255, 0.78);\r\n}\r\n[data-theme=\"dark\"] .wa-replyCtx.isOut .wa-replyCtx-bar {\r\n  background: var(--ds-accent, #00a884);\r\n}\r\n\r\n@media (max-width: 640px) {\r\n  .wa-replyCtx {\r\n    margin-bottom: 4px;\r\n    border-radius: 6px;\r\n  }\r\n  .wa-replyCtx-content {\r\n    padding: 4px 7px 4px 5px;\r\n    gap: 6px;\r\n  }\r\n  .wa-replyCtx-thumb {\r\n    width: 34px;\r\n    height: 34px;\r\n    border-radius: 4px;\r\n  }\r\n  .wa-replyCtx-name {\r\n    font-size: 12px;\r\n  }\r\n  .wa-replyCtx-snippet {\r\n    font-size: 11.5px;\r\n  }\r\n\r\n  /* Mídia com citação: padding mínimo da foto não deve espremer o reply */\r\n  .wa-bubble.image-message:has(.wa-replyCtx),\r\n  .wa-bubble.wa-bubble-video:has(.wa-replyCtx),\r\n  .wa-bubble.wa-bubble-audio:has(.wa-replyCtx),\r\n  .wa-bubble.wa-bubble-fileWrap:has(.wa-replyCtx) {\r\n    padding: 6px 7px 7px;\r\n  }\r\n}\r\n\r\n/* Nome do atendente acima da mensagem enviada pelo sistema — discreto, premium */\r\n.wa-bubble-atendente {\r\n  font-size: 10px;\r\n  font-weight: 500;\r\n  letter-spacing: 0.02em;\r\n  color: #0b5d4c;\r\n  opacity: 0.7;\r\n  margin-bottom: 4px;\r\n  line-height: 1.2;\r\n  max-width: 100%;\r\n  white-space: normal;\r\n  overflow: visible;\r\n  word-break: break-word;\r\n  overflow-wrap: anywhere;\r\n}\r\n.wa-bubble-out:hover .wa-bubble-atendente {\r\n  opacity: 0.9;\r\n}\r\n[data-theme=\"dark\"] .wa-bubble-atendente {\r\n  color: rgba(255, 255, 255, 0.85);\r\n  opacity: 0.65;\r\n}\r\n[data-theme=\"dark\"] .wa-bubble-out:hover .wa-bubble-atendente {\r\n  opacity: 0.9;\r\n}\r\n\r\n/* highlight ao scroll para mensagem citada (reply) — inovador: glow + leve breathe */\r\n.highlight-reply {\r\n  animation: flash-reply 1.5s ease-out;\r\n}\r\n@keyframes flash-reply {\r\n  0% { box-shadow: 0 0 0 2px var(--wa-green, #00a884); transform: translateY(-0.5px); }\r\n  20% { box-shadow: 0 0 0 4px var(--wa-green, #00a884); transform: translateY(-0.5px) scale(1.01); }\r\n  50% { box-shadow: 0 0 0 3px var(--wa-green, #00a884); transform: translateY(-0.5px) scale(1.01); }\r\n  100% { box-shadow: none; transform: none; }\r\n}\r\n\r\n/* =========================================================\r\n   ENCAMINHAR (painel)\r\n========================================================= */\r\n\r\n.wa-forwardHint {\r\n  padding: 6px 4px 10px;\r\n}\r\n\r\n.wa-forwardPreview {\r\n  font-size: 13px;\r\n  color: var(--wa-text);\r\n  font-weight: 600;\r\n  margin-bottom: 2px;\r\n  line-height: 1.35;\r\n}\r\n\r\n/* Passos curtos — mais legível no celular que um parágrafo longo */\r\n.wa-forwardSteps {\r\n  margin: 10px 0 0;\r\n  padding: 0 0 0 1.25rem;\r\n  font-size: 13px;\r\n  color: var(--wa-text-muted);\r\n  line-height: 1.5;\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 8px;\r\n}\r\n\r\n.wa-forwardSteps li::marker {\r\n  color: var(--wa-green, #00a884);\r\n  font-weight: 700;\r\n}\r\n\r\n.wa-forwardSteps strong {\r\n  color: var(--wa-text);\r\n  font-weight: 650;\r\n}\r\n\r\n/* Modal de encaminhar (mais confiável que painel flutuante) */\r\n.wa-forwardModal {\r\n  width: min(720px, calc(100vw - 24px));\r\n  max-height: min(78vh, 680px);\r\n  display: flex;\r\n  flex-direction: column;\r\n  min-height: 0;\r\n}\r\n\r\n.wa-forwardSheetHandle {\r\n  width: 40px;\r\n  height: 5px;\r\n  border-radius: 999px;\r\n  background: rgba(0, 0, 0, 0.12);\r\n  margin: 10px auto 0;\r\n  flex-shrink: 0;\r\n}\r\n\r\n@media (min-width: 561px) {\r\n  .wa-forwardModal .wa-forwardSheetHandle {\r\n    display: none;\r\n  }\r\n}\r\n\r\n[data-theme=\"dark\"] .wa-forwardSheetHandle {\r\n  background: rgba(255, 255, 255, 0.22);\r\n}\r\n.wa-forwardBody {\r\n  overflow: auto;\r\n  flex: 1 1 auto;\r\n  min-height: 0;\r\n}\r\n.wa-forwardSection {\r\n  margin-top: 6px;\r\n}\r\n.wa-forwardSectionTitle {\r\n  font-size: 12px;\r\n  font-weight: 700;\r\n  color: var(--wa-text-muted);\r\n  text-transform: uppercase;\r\n  letter-spacing: 0.04em;\r\n  margin: 10px 2px 8px;\r\n}\r\n\r\n.wa-forwardSearch {\r\n  margin: 6px 0 10px;\r\n}\r\n\r\n.wa-forwardList {\r\n  display: grid;\r\n  gap: 8px;\r\n}\r\n\r\n.wa-forwardItem {\r\n  border: 1px solid rgba(0,0,0,.06);\r\n  background: rgba(0,0,0,.02);\r\n  border-radius: 12px;\r\n  padding: 10px 12px;\r\n  text-align: left;\r\n  cursor: pointer;\r\n}\r\n\r\n[data-theme=\"dark\"] .wa-forwardItem {\r\n  background: rgba(255, 255, 255, 0.05);\r\n  border-color: rgba(255, 255, 255, 0.09);\r\n}\r\n\r\n.wa-forwardItem:hover {\r\n  background: rgba(0,0,0,.04);\r\n}\r\n\r\n[data-theme=\"dark\"] .wa-forwardItem:hover {\r\n  background: rgba(255, 255, 255, 0.08);\r\n}\r\n\r\n.wa-forwardItem-name {\r\n  font-size: 13px;\r\n  font-weight: 600;\r\n  color: var(--wa-text);\r\n  overflow: hidden;\r\n  text-overflow: ellipsis;\r\n  white-space: nowrap;\r\n}\r\n\r\n.wa-forwardItem-sub {\r\n  margin-top: 2px;\r\n  font-size: 12px;\r\n  color: var(--wa-text-muted);\r\n  overflow: hidden;\r\n  text-overflow: ellipsis;\r\n  white-space: nowrap;\r\n}\r\n\r\n.wa-forwardItem-atendente {\r\n  margin-top: 4px;\r\n  font-size: 11px;\r\n  font-weight: 600;\r\n  color: var(--wa-text-muted);\r\n  overflow: hidden;\r\n  text-overflow: ellipsis;\r\n  white-space: nowrap;\r\n}\r\n\r\n.wa-forwardItem-atendente--empty {\r\n  font-weight: 500;\r\n  opacity: 0.85;\r\n}\r\n\r\n.wa-forwardHeadLeft {\r\n  min-width: 0;\r\n  flex: 1;\r\n}\r\n\r\n.wa-forwardHeadCounter {\r\n  margin-top: 4px;\r\n  font-size: 12px;\r\n  color: var(--wa-text-muted);\r\n  font-weight: 500;\r\n}\r\n\r\n.wa-forwardSectionHead {\r\n  display: flex;\r\n  align-items: baseline;\r\n  justify-content: space-between;\r\n  gap: 8px;\r\n  margin: 10px 2px 8px;\r\n}\r\n\r\n.wa-forwardSectionHead .wa-forwardSectionTitle {\r\n  margin: 0;\r\n}\r\n\r\n.wa-forwardSectionCap {\r\n  font-size: 11px;\r\n  font-weight: 600;\r\n  color: var(--wa-text-muted);\r\n  white-space: nowrap;\r\n}\r\n\r\n.wa-forwardMaxHint {\r\n  margin: 0 0 8px 2px;\r\n  font-size: 12px;\r\n  color: #c2410c;\r\n  font-weight: 600;\r\n}\r\n\r\n[data-theme=\"dark\"] .wa-forwardMaxHint {\r\n  color: #fb923c;\r\n}\r\n\r\n.wa-forwardItem--row {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 8px;\r\n  padding: 8px 10px;\r\n}\r\n\r\n.wa-forwardItem-rowMain {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 8px;\r\n  flex: 1 1 0%;\r\n  min-width: 0;\r\n}\r\n\r\n.wa-forwardItem--row.isSelected {\r\n  border-color: rgba(0, 168, 132, 0.45);\r\n  background: rgba(0, 168, 132, 0.08);\r\n}\r\n\r\n[data-theme=\"dark\"] .wa-forwardItem--row.isSelected {\r\n  border-color: rgba(0, 212, 170, 0.42);\r\n  background: rgba(0, 168, 132, 0.14);\r\n}\r\n\r\n.wa-forwardItem-checkLabel {\r\n  flex-shrink: 0;\r\n  display: flex;\r\n  align-items: center;\r\n  cursor: pointer;\r\n}\r\n\r\n.wa-forwardItem-check {\r\n  width: 18px;\r\n  height: 18px;\r\n  cursor: pointer;\r\n  accent-color: var(--wa-green, #00a884);\r\n}\r\n\r\n.wa-forwardItem-main {\r\n  flex: 1 1 0%;\r\n  min-width: 0;\r\n  border: none;\r\n  background: transparent;\r\n  text-align: left;\r\n  padding: 0;\r\n  cursor: pointer;\r\n  font: inherit;\r\n  color: inherit;\r\n  border-radius: 8px;\r\n}\r\n\r\n.wa-forwardItem-main:disabled {\r\n  cursor: not-allowed;\r\n  opacity: 0.7;\r\n}\r\n\r\n.wa-forwardItem-solo {\r\n  flex-shrink: 0;\r\n  font-size: 11px;\r\n  padding: 6px 8px;\r\n  white-space: nowrap;\r\n}\r\n\r\n.wa-forwardFooter {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: flex-end;\r\n  flex-wrap: wrap;\r\n  gap: 10px;\r\n  padding: 12px 16px 16px;\r\n  border-top: 1px solid var(--wa-panel-border);\r\n  background: var(--wa-header-bg, var(--wa-panel));\r\n  flex-shrink: 0;\r\n}\r\n\r\n.wa-forwardModal .wa-modal-head {\r\n  align-items: flex-start;\r\n}\r\n\r\n/* Barra de seleção + encaminhar: no celular empilha ações para não “espremender” */\r\n@media (max-width: 640px) {\r\n  .wa-selectBar--forwardIntent {\r\n    flex-direction: column;\r\n    align-items: stretch;\r\n    gap: 12px;\r\n    padding: 12px 14px;\r\n  }\r\n\r\n  .wa-selectBar--forwardIntent .wa-selectBar-left {\r\n    width: 100%;\r\n    justify-content: space-between;\r\n  }\r\n\r\n  .wa-selectBar--forwardIntent .wa-selectBar-count {\r\n    font-size: 14px;\r\n    font-weight: 600;\r\n    color: #334155;\r\n  }\r\n\r\n  .wa-selectBar--forwardIntent .wa-selectBar-actions {\r\n    width: 100%;\r\n    max-width: none;\r\n    justify-content: stretch;\r\n    gap: 10px;\r\n  }\r\n\r\n  .wa-selectBar--forwardIntent .wa-selectBar-actions .wa-btn {\r\n    flex: 1 1 0%;\r\n    min-height: 46px;\r\n    font-size: 14px;\r\n    font-weight: 600;\r\n    justify-content: center;\r\n  }\r\n}\r\n\r\n/* Encaminhar — mobile: sheet em tela cheia, lista tocável, texto quebra */\r\n@media (max-width: 560px) {\r\n  .wa-forwardOverlay {\r\n    align-items: stretch;\r\n    justify-content: flex-end;\r\n    padding: 0;\r\n    padding-bottom: env(safe-area-inset-bottom, 0px);\r\n  }\r\n\r\n  .wa-forwardOverlay .wa-modal.wa-forwardModal {\r\n    width: 100%;\r\n    max-width: none;\r\n    max-height: min(94vh, 94dvh, 100%);\r\n    margin: 0;\r\n    border-radius: 16px 16px 0 0;\r\n    align-self: flex-end;\r\n    display: flex;\r\n    flex-direction: column;\r\n    min-height: 0;\r\n    overflow: hidden;\r\n    box-sizing: border-box;\r\n    box-shadow: 0 -8px 40px rgba(0, 0, 0, 0.18);\r\n  }\r\n\r\n  .wa-forwardOverlay .wa-forwardSheetHandle {\r\n    margin-top: 8px;\r\n    margin-bottom: 2px;\r\n  }\r\n\r\n  .wa-forwardOverlay .wa-forwardModal .wa-modal-head {\r\n    flex-shrink: 0;\r\n    padding: 8px 14px 12px;\r\n    padding-top: max(6px, env(safe-area-inset-top, 0px));\r\n    border-bottom-color: rgba(0, 0, 0, 0.06);\r\n  }\r\n\r\n  [data-theme=\"dark\"] .wa-forwardOverlay .wa-forwardModal .wa-modal-head {\r\n    border-bottom-color: rgba(255, 255, 255, 0.08);\r\n  }\r\n\r\n  .wa-forwardOverlay .wa-modal-title {\r\n    font-size: 17px;\r\n    font-weight: 750;\r\n    letter-spacing: -0.02em;\r\n  }\r\n\r\n  .wa-forwardOverlay .wa-forwardHeadCounter {\r\n    display: inline-flex;\r\n    align-self: flex-start;\r\n    margin-top: 8px;\r\n    padding: 5px 11px;\r\n    border-radius: 999px;\r\n    font-size: 12px;\r\n    font-weight: 650;\r\n    background: rgba(0, 168, 132, 0.11);\r\n    color: #0d5c4a;\r\n    border: 1px solid rgba(0, 168, 132, 0.22);\r\n  }\r\n\r\n  [data-theme=\"dark\"] .wa-forwardOverlay .wa-forwardHeadCounter {\r\n    background: rgba(0, 168, 132, 0.18);\r\n    color: rgba(232, 245, 241, 0.95);\r\n    border-color: rgba(0, 212, 170, 0.28);\r\n  }\r\n\r\n  .wa-forwardOverlay .wa-forwardModal .wa-modal-body.wa-forwardBody {\r\n    flex: 1 1 auto;\r\n    min-height: 0;\r\n    overflow-x: hidden;\r\n    overflow-y: auto;\r\n    -webkit-overflow-scrolling: touch;\r\n    overscroll-behavior: contain;\r\n    display: flex;\r\n    flex-direction: column;\r\n    gap: 8px;\r\n    padding: 10px 12px max(12px, env(safe-area-inset-bottom, 0px));\r\n    box-sizing: border-box;\r\n  }\r\n\r\n  .wa-forwardOverlay .wa-forwardHint {\r\n    flex-shrink: 0;\r\n    padding: 2px 0 8px;\r\n  }\r\n\r\n  .wa-forwardOverlay .wa-forwardPreview {\r\n    font-size: 14px;\r\n    line-height: 1.4;\r\n    word-break: break-word;\r\n    white-space: normal;\r\n    padding: 11px 12px;\r\n    border-radius: 12px;\r\n    background: rgba(0, 0, 0, 0.04);\r\n    border: 1px solid rgba(0, 0, 0, 0.06);\r\n    box-sizing: border-box;\r\n    display: -webkit-box;\r\n    -webkit-line-clamp: 3;\r\n    line-clamp: 3;\r\n    -webkit-box-orient: vertical;\r\n    overflow: hidden;\r\n  }\r\n\r\n  [data-theme=\"dark\"] .wa-forwardOverlay .wa-forwardPreview {\r\n    background: rgba(255, 255, 255, 0.06);\r\n    border-color: rgba(255, 255, 255, 0.1);\r\n  }\r\n\r\n  .wa-forwardOverlay .wa-forwardSteps {\r\n    font-size: 13px;\r\n    gap: 10px;\r\n    margin-top: 12px;\r\n    padding-left: 1.15rem;\r\n  }\r\n\r\n  .wa-forwardOverlay .wa-forwardSearch {\r\n    width: 100%;\r\n    max-width: 100%;\r\n    margin: 4px 0 8px;\r\n    box-sizing: border-box;\r\n    min-height: 44px;\r\n    padding: 10px 12px;\r\n    font-size: 16px; /* evita zoom iOS em focus */\r\n  }\r\n\r\n  .wa-forwardOverlay .wa-forwardSection {\r\n    margin-top: 10px;\r\n    min-width: 0;\r\n    padding: 10px 12px 12px;\r\n    border-radius: 14px;\r\n    background: rgba(0, 0, 0, 0.025);\r\n    border: 1px solid rgba(0, 0, 0, 0.06);\r\n    box-sizing: border-box;\r\n  }\r\n\r\n  [data-theme=\"dark\"] .wa-forwardOverlay .wa-forwardSection {\r\n    background: rgba(255, 255, 255, 0.04);\r\n    border-color: rgba(255, 255, 255, 0.08);\r\n  }\r\n\r\n  .wa-forwardOverlay .wa-forwardSectionTitle {\r\n    margin: 0 0 8px;\r\n    font-size: 11px;\r\n    letter-spacing: 0.06em;\r\n  }\r\n\r\n  .wa-forwardOverlay .wa-forwardSectionHead {\r\n    margin: 0 0 8px;\r\n  }\r\n\r\n  .wa-forwardOverlay .wa-forwardList {\r\n    gap: 10px;\r\n    width: 100%;\r\n    min-width: 0;\r\n  }\r\n\r\n  .wa-forwardOverlay .wa-forwardItem {\r\n    width: 100%;\r\n    max-width: 100%;\r\n    box-sizing: border-box;\r\n    min-height: 48px;\r\n    padding: 12px 14px;\r\n    border-radius: 14px;\r\n    -webkit-tap-highlight-color: transparent;\r\n    touch-action: manipulation;\r\n  }\r\n\r\n  .wa-forwardOverlay .wa-forwardItem--row {\r\n    flex-direction: column;\r\n    align-items: stretch;\r\n    gap: 12px;\r\n  }\r\n\r\n  .wa-forwardOverlay .wa-forwardItem-rowMain {\r\n    align-items: flex-start;\r\n    width: 100%;\r\n    gap: 10px;\r\n  }\r\n\r\n  .wa-forwardOverlay .wa-forwardItem-checkLabel {\r\n    padding-top: 2px;\r\n  }\r\n\r\n  .wa-forwardOverlay .wa-forwardItem-check {\r\n    width: 22px;\r\n    height: 22px;\r\n  }\r\n\r\n  .wa-forwardOverlay .wa-forwardItem-solo {\r\n    width: 100%;\r\n    align-self: stretch;\r\n    margin: 0;\r\n    padding: 11px 14px;\r\n    font-size: 14px;\r\n    font-weight: 650;\r\n    border-radius: 12px;\r\n    border: 1px solid rgba(0, 168, 132, 0.38);\r\n    background: rgba(0, 168, 132, 0.09);\r\n    color: #0b5d4c;\r\n    box-sizing: border-box;\r\n    min-height: 48px;\r\n  }\r\n\r\n  .wa-forwardOverlay .wa-forwardItem-solo:hover:not(:disabled) {\r\n    background: rgba(0, 168, 132, 0.14);\r\n    filter: none;\r\n  }\r\n\r\n  [data-theme=\"dark\"] .wa-forwardOverlay .wa-forwardItem-solo {\r\n    border-color: rgba(0, 212, 170, 0.4);\r\n    background: rgba(0, 168, 132, 0.16);\r\n    color: rgba(210, 245, 235, 0.98);\r\n  }\r\n\r\n  .wa-forwardOverlay .wa-forwardFooter {\r\n    flex-direction: column-reverse;\r\n    align-items: stretch;\r\n    gap: 10px;\r\n    padding: 12px 14px max(14px, calc(12px + env(safe-area-inset-bottom, 0px)));\r\n  }\r\n\r\n  .wa-forwardOverlay .wa-forwardFooter .wa-btn {\r\n    width: 100%;\r\n    justify-content: center;\r\n    min-height: 48px;\r\n    font-size: 15px;\r\n    font-weight: 650;\r\n    box-sizing: border-box;\r\n  }\r\n\r\n  .wa-forwardOverlay .wa-forwardItem-name {\r\n    font-size: 15px;\r\n    line-height: 1.35;\r\n    white-space: normal;\r\n    word-break: break-word;\r\n    overflow: visible;\r\n    text-overflow: unset;\r\n  }\r\n\r\n  .wa-forwardOverlay .wa-forwardItem-sub {\r\n    margin-top: 4px;\r\n    font-size: 13px;\r\n    line-height: 1.35;\r\n    white-space: normal;\r\n    word-break: break-word;\r\n    overflow: visible;\r\n    text-overflow: unset;\r\n  }\r\n\r\n  .wa-forwardOverlay .wa-forwardItem-atendente,\r\n  .wa-forwardOverlay .wa-forwardItem-atendente--empty {\r\n    margin-top: 6px;\r\n    font-size: 12px;\r\n    line-height: 1.35;\r\n    white-space: normal;\r\n    word-break: break-word;\r\n    overflow: visible;\r\n    text-overflow: unset;\r\n  }\r\n\r\n  .wa-forwardOverlay .wa-muted {\r\n    padding-left: 2px !important;\r\n    padding-right: 2px !important;\r\n    font-size: 13px;\r\n    line-height: 1.4;\r\n    word-break: break-word;\r\n  }\r\n}\r\n\r\n/* Telas muito estreitas: margem zero lateral no sheet */\r\n@media (max-width: 380px) {\r\n  .wa-forwardOverlay .wa-modal.wa-forwardModal {\r\n    border-radius: 12px 12px 0 0;\r\n  }\r\n\r\n  .wa-forwardOverlay .wa-forwardModal .wa-modal-body.wa-forwardBody {\r\n    padding-left: 10px;\r\n    padding-right: 10px;\r\n  }\r\n}\r\n\r\n/* =========================================================\r\n   SEPARADOR DE DATA\r\n========================================================= */\r\n\r\n.wa-daySep {\r\n  display: flex;\r\n  justify-content: center;\r\n  padding: 10px 0;\r\n}\r\n\r\n.wa-daySep-pill {\r\n  padding: 5px 12px;\r\n  border-radius: 8px;\r\n  font-size: 11px;\r\n  font-weight: 650;\r\n  color: var(--ds-text-muted);\r\n  background: color-mix(in srgb, var(--wa-panel) 72%, transparent);\r\n  border: 1px solid color-mix(in srgb, var(--wa-panel-border) 78%, transparent);\r\n  box-shadow:\r\n    inset 0 1px 0 color-mix(in srgb, #ffffff 16%, transparent),\r\n    0 6px 18px -15px rgba(15, 23, 42, 0.36);\r\n  animation: wa-dayPillFade 0.3s ease-out;\r\n}\r\n\r\n/* =========================================================\r\n   PENDING FILE (pré-envio de arquivo)\r\n========================================================= */\r\n\r\n.wa-pending {\r\n  order: 3; /* dentro de .wa-shell: fica junto do composer (embaixo) */\r\n  flex: 0 0 auto;\r\n  padding: 8px 12px;\r\n  background: var(--wa-header-bg);\r\n  border-top: 1px solid var(--wa-panel-border);\r\n  flex-shrink: 0;\r\n}\r\n\r\n.wa-pending-card {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  gap: 16px;\r\n  padding: 12px 16px;\r\n  border-radius: var(--wa-radius);\r\n  background: var(--wa-panel);\r\n  border: 1px solid var(--wa-panel-border);\r\n  box-shadow: var(--wa-shadow-subtle);\r\n}\r\n\r\n.wa-pending-left {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 12px;\r\n  min-width: 0;\r\n}\r\n\r\n.wa-pending-img {\r\n  width: 48px;\r\n  height: 48px;\r\n  object-fit: cover;\r\n  border-radius: var(--wa-radius-sm);\r\n  flex-shrink: 0;\r\n}\r\n\r\n.wa-pending-fileIcon {\r\n  width: 48px;\r\n  height: 48px;\r\n  border-radius: var(--wa-radius-sm);\r\n  background: var(--wa-header-bg);\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  font-size: 22px;\r\n  flex-shrink: 0;\r\n}\r\n\r\n.wa-pending-meta {\r\n  min-width: 0;\r\n}\r\n\r\n.wa-pending-name {\r\n  font-weight: 500;\r\n  font-size: 14px;\r\n  color: var(--wa-text);\r\n  overflow: hidden;\r\n  text-overflow: ellipsis;\r\n  white-space: nowrap;\r\n}\r\n\r\n.wa-pending-sub {\r\n  font-size: 12px;\r\n  color: var(--wa-text-muted);\r\n  margin-top: 2px;\r\n}\r\n\r\n.wa-dotSep {\r\n  margin: 0 6px;\r\n  opacity: 0.7;\r\n}\r\n\r\n.wa-pending-right {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 10px;\r\n  flex-shrink: 0;\r\n}\r\n\r\n.wa-btn {\r\n  padding: 8px 16px;\r\n  border-radius: var(--wa-radius-sm);\r\n  font-weight: 500;\r\n  font-size: 13px;\r\n  cursor: pointer;\r\n  border: none;\r\n  transition: background 0.12s ease, opacity 0.12s ease, filter 0.12s ease, transform 0.08s ease;\r\n}\r\n\r\n.wa-btn:disabled {\r\n  opacity: 0.6;\r\n  cursor: not-allowed;\r\n}\r\n\r\n.wa-btn-ghost {\r\n  background: rgba(0, 0, 0, 0.04);\r\n  color: var(--wa-text);\r\n}\r\n\r\n.wa-btn-ghost:hover:not(:disabled) {\r\n  background: rgba(0, 0, 0, 0.08);\r\n}\r\n\r\n.wa-btn-primary {\r\n  background: var(--wa-green-send);\r\n  color: #fff;\r\n}\r\n\r\n.wa-btn-primary:hover:not(:disabled) {\r\n  filter: brightness(1.04);\r\n}\r\n\r\n.wa-btn-primary:active:not(:disabled) {\r\n  filter: brightness(0.98);\r\n}\r\n\r\n/* =========================================================\r\n   MEDIA PREVIEW — overlay estilo WhatsApp para foto/vídeo\r\n   antes de enviar, com campo de legenda opcional.\r\n========================================================= */\r\n\r\n.wa-mediaPreview {\r\n  /* Cobre toda a viewport, igual ao WhatsApp Web/Mobile: preview de mídia\r\n     ocupa a tela inteira com header próprio (Cancelar) e composer com legenda. */\r\n  position: fixed;\r\n  inset: 0;\r\n  z-index: 90;\r\n  display: flex;\r\n  flex-direction: column;\r\n  background: #0b141a;\r\n  color: #e9edef;\r\n  overflow: hidden;\r\n  animation: wa-mediaPreview-fadeIn 0.16s ease-out;\r\n}\r\n\r\n/* Variante: PDF / áudio / outros — fundo um pouco mais claro, cartão central */\r\n.wa-mediaPreview--file {\r\n  background: linear-gradient(180deg, #1a2329 0%, #0b141a 45%);\r\n}\r\n\r\n.wa-fileSendPreview-card {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 16px;\r\n  max-width: 100%;\r\n  padding: 20px 22px;\r\n  border-radius: 16px;\r\n  background: rgba(255, 255, 255, 0.06);\r\n  border: 1px solid rgba(255, 255, 255, 0.1);\r\n  box-shadow: 0 8px 28px rgba(0, 0, 0, 0.35);\r\n}\r\n\r\n.wa-fileSendPreview-icon {\r\n  font-size: 40px;\r\n  line-height: 1;\r\n  flex-shrink: 0;\r\n}\r\n\r\n.wa-fileSendPreview-meta {\r\n  min-width: 0;\r\n  text-align: left;\r\n}\r\n\r\n.wa-fileSendPreview-name {\r\n  font-size: 15px;\r\n  font-weight: 600;\r\n  color: #e9edef;\r\n  word-break: break-word;\r\n}\r\n\r\n.wa-fileSendPreview-sub {\r\n  margin-top: 6px;\r\n  font-size: 13px;\r\n  color: rgba(233, 237, 239, 0.65);\r\n}\r\n\r\n@keyframes wa-mediaPreview-fadeIn {\r\n  from { opacity: 0; }\r\n  to { opacity: 1; }\r\n}\r\n\r\n.wa-mediaPreview-head {\r\n  flex: 0 0 auto;\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 8px;\r\n  padding: 10px 14px;\r\n  padding-top: max(10px, env(safe-area-inset-top, 0));\r\n  padding-left: calc(14px + env(safe-area-inset-left, 0));\r\n  padding-right: calc(14px + env(safe-area-inset-right, 0));\r\n  background: linear-gradient(180deg, rgba(0, 0, 0, 0.42), rgba(0, 0, 0, 0));\r\n  min-height: 52px;\r\n}\r\n\r\n.wa-mediaPreview-close {\r\n  width: 40px;\r\n  height: 40px;\r\n  min-width: 40px;\r\n  min-height: 40px;\r\n  border-radius: 50%;\r\n  border: none;\r\n  background: rgba(255, 255, 255, 0.08);\r\n  color: #e9edef;\r\n  display: inline-flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  cursor: pointer;\r\n  transition: background 0.15s ease;\r\n}\r\n\r\n.wa-mediaPreview-close:hover:not(:disabled) {\r\n  background: rgba(255, 255, 255, 0.16);\r\n}\r\n\r\n.wa-mediaPreview-close:disabled {\r\n  opacity: 0.55;\r\n  cursor: not-allowed;\r\n}\r\n\r\n.wa-mediaPreview-title {\r\n  flex: 1;\r\n  text-align: center;\r\n  font-size: 15px;\r\n  font-weight: 600;\r\n  letter-spacing: 0.01em;\r\n  color: #e9edef;\r\n  white-space: nowrap;\r\n  overflow: hidden;\r\n  text-overflow: ellipsis;\r\n}\r\n\r\n.wa-mediaPreview-spacer {\r\n  width: 40px;\r\n  height: 40px;\r\n  flex: 0