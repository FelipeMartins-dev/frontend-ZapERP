r\n  position: absolute;\r\n  right: 6px;\r\n  bottom: 4px;\r\n  top: auto;\r\n  transform: none;\r\n  display: inline-flex;\r\n  align-items: center;\r\n  justify-content: flex-end;\r\n  gap: 2px;\r\n  height: 12px;\r\n  line-height: 1;\r\n  white-space: nowrap;\r\n  pointer-events: none;\r\n}\r\n\r\n/* Para mídias sem faixa de legenda: meta no canto superior direito.\r\n   Imagem/vídeo com legenda usa meta no rodapé (regras específicas acima em :has(.wa-bubble-caption)). */\r\n.wa-bubble.wa-bubble-media.image-message:not(:has(.wa-bubble-caption)) .wa-bubble-meta,\r\n.wa-bubble.wa-bubble-media.sticker-message .wa-bubble-meta,\r\n.wa-bubble.sticker-message .wa-bubble-meta,\r\n.wa-bubble-video:not(:has(.wa-bubble-caption)) .wa-bubble-meta {\r\n  top: 5px;\r\n  bottom: auto;\r\n  right: 5px;\r\n  transform: none;\r\n  background: rgba(0, 0, 0, 0.30);\r\n  color: #fff;\r\n  border-radius: 8px;\r\n  padding: 2px 5px;\r\n  gap: 4px;\r\n}\r\n\r\n/* Áudio: menu fica no canto superior direito, hora permanece no rodapé */\r\n.wa-bubble-audio .wa-bubble-meta,\r\n.wa-bubble.audio-message .wa-bubble-meta {\r\n  top: 5px;\r\n  bottom: auto;\r\n  right: 5px;\r\n  transform: none;\r\n  padding: 0;\r\n  background: none;\r\n  gap: 4px;\r\n}\r\n\r\n/* =========================================\r\n   META CONTAINER (hora + ticks + menu)\r\n========================================= */\r\n\r\n.wa-bubble-meta{\r\n  position:absolute;\r\n  right:6px;\r\n  bottom:4px;\r\n  top:auto;\r\n  transform:none;\r\n  display:flex;\r\n  align-items:center;\r\n  gap:2px;\r\n  font-size:10.5px;\r\n  line-height:1;\r\n  white-space:nowrap;\r\n  pointer-events:none;\r\n}\r\n\r\n\r\n/* =========================================\r\n   META LADO ESQUERDO (hora + duração audio)\r\n========================================= */\r\n\r\n.wa-bubble-metaLeft{\r\n  display:inline-flex;\r\n  align-items:center;\r\n  gap:3px;\r\n  min-width:0;\r\n}\r\n\r\n\r\n/* horário */\r\n\r\n.wa-bubble-time{\r\n  font-size:10.5px