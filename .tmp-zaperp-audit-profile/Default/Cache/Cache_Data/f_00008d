genérico (≤480px) */\r\n  .wa-bubble.wa-bubble-media.image-message,\r\n  .wa-bubble.wa-bubble-media.image-message.hasInlineMeta {\r\n    max-width: min(calc(100vw - 14px), 420px, 96%);\r\n    padding: 2px 3px 3px 3px;\r\n    border-radius: 12px;\r\n    overflow: hidden;\r\n  }\r\n\r\n  .wa-bubble.wa-bubble-video:has(.wa-bubble-caption) {\r\n    max-width: min(calc(100vw - 14px), 420px, 96%);\r\n    padding: 2px 3px 3px 3px;\r\n    border-radius: 12px;\r\n    overflow: hidden;\r\n  }\r\n\r\n  .wa-bubble.image-message .wa-bubble-mediaStack,\r\n  .wa-bubble.image-message .wa-bubble-imgLink,\r\n  .wa-bubble.image-message .wa-bubble-img,\r\n  .wa-bubble.image-message .wa-bubble-caption {\r\n    max-width: min(calc(100vw - 14px), 420px);\r\n  }\r\n\r\n  .wa-bubble.image-message .wa-bubble-img.is-loading {\r\n    min-width: min(calc(100vw - 44px), 230px);\r\n    min-height: 200px;\r\n  }\r\n\r\n  .wa-bubble-meta { font-size: 10px; gap: 2px; padding: 0 8px; }\r\n\r\n  .wa-ticks { font-size: 11px; }\r\n\r\n  .wa-daySep { padding: 12px 0; }\r\n\r\n  .wa-daySep-pill {\r\n    padding: 7px 14px;\r\n    font-size: 12px;\r\n    font-weight: 600;\r\n  }\r\n\r\n  .wa-footer {\r\n    /* main-content já reserva safe-area-inset-bottom quando a conversa está\r\n       aberta no mobile — não acumular para evitar faixa em branco abaixo dos\r\n       botões e do campo de digitação. */\r\n    padding: 8px 10px 10px;\r\n    padding-left: calc(10px + env(safe-area-inset-left, 0));\r\n    padding-right: calc(10px + env(safe-area-inset-right, 0));\r\n    gap: 6px;\r\n    align-items: flex-end;\r\n  }\r\n\r\n  main.main-content--crm .wa-footer {\r\n    padding-bottom: 8px;\r\n  }\r\n\r\n  .wa-footer .wa-iconBtn {\r\n    width: 44px;\r\n    height: 44px;\r\n    min-width: 44px;\r\n    min-height: 44px;\r\n  }\r\n\r\n  .wa-footer .wa-attachPlus svg,\r\n  .wa-footer .wa-cameraQuickBtn svg,\r\n  .wa-footer .wa-micBtn svg {\r\n    width: 22px;\r\n    height: 22px;\r\n  }\r\n\r\n  .wa-footer-right { gap: 6px; align-items: flex-end; }\r\n\r\n  .wa-input {\r\n    min-height: 46px;\r\n    max-height: min(120px, calc(var(--wa-visual-height, 100vh) * 0.26));\r\n    min-width: 48px;\r\n    padding: 12px 13px;\r\n    font-size: 16px;\r\n    line-height: 22px;\r\n    border-radius: 22px;\r\n    box-sizing: border-box;\r\n  }\r\n\r\n  .wa-input::placeholder {\r\n    font-size: 14px;\r\n    line-height: 1.45;\r\n    opacity: 0.88;\r\n  }\r\n\r\n  .wa-shell .wa-footer textarea.wa-input {\r\n    padding: 12px 13px;\r\n    line-height: 22px;\r\n  }\r\n\r\n  .wa-shell .wa-footer textarea.wa-input::placeholder {\r\n    font-size: 14px;\r\n    line-height: 1.45;\r\n  }\r\n\r\n  .wa-sendBtn,\r\n  .wa-micBtn {\r\n    width: 44px;\r\n    height: 44px;\r\n    min-width: 44px;\r\n    min-height: 44px;\r\n  }\r\n}\r\n\r\n/* Mobile muito estreito: prioriza leitura e toque, sem encolher controles */\r\n@media (max-width: 400px) {\r\n  .wa-shell { overflow-x: hidden; }\r\n\r\n  .wa-messages { overflow-x: hidden; }\r\n\r\n  .wa-header-name {\r\n    max-width: 100%;\r\n    font-size: 12px;\r\n    font-weight: 700;\r\n    white-space: nowrap;\r\n    overflow: hidden;\r\n    text-overflow: ellipsis;\r\n    word-break: normal;\r\n    min-width: 0;\r\n  }\r\n\r\n  .wa-bubble { padding: 12px 13px 13px; font-size: 17px; }\r\n\r\n  .wa-bubble-text { font-size: 17px; }\r\n\r\n  .wa-bubble-caption { font-size: 15px; }\r\n\r\n  .wa-footer {\r\n    /* Igual ≤480px: main-content já cobre safe-area, não empilhar aqui. */\r\n    padding: 7px 8px 9px;\r\n    padding-left: calc(8px + env(safe-area-inset-left, 0));\r\n    padding-right: calc(8px + env(safe-area-inset-right, 0));\r\n    gap: 5px;\r\n    align-items: flex-end;\r\n  }\r\n\r\n  main.main-content--crm .wa-footer {\r\n    padding-bottom: 8px;\r\n  }\r\n\r\n  .wa-footer .wa-iconBtn {\r\n    width: 42px;\r\n    height: 42px;\r\n    min-width: 42px;\r\n    min-height: 42px;\r\n  }\r\n\r\n  .wa-footer .wa-attachPlus svg,\r\n  .wa-footer .wa-cameraQuickBtn svg,\r\n  .wa-footer .wa-micBtn svg {\r\n    width: 21px;\r\n    height: 21px;\r\n  }\r\n\r\n  .wa-footer-right {\r\n    gap: 5px;\r\n  }\r\n\r\n  .wa-input {\r\n    min-width: 0;\r\n    flex: 1 1 0%;\r\n    min-height: 42px;\r\n    max-height: min(108px, calc(var(--wa-visual-height, 100vh) * 0.24));\r\n    padding: 8px 12px;\r\n    font-size: 16px;\r\n    line-height: 20px;\r\n  }\r\n\r\n  .wa-input::placeholder {\r\n    font-size: 16px;\r\n    line-height: 20px;\r\n  }\r\n\r\n  .wa-shell .wa-footer textarea.wa-input {\r\n    padding: 10px 12px;\r\n    line-height: 20px;\r\n  }\r\n\r\n  .wa-sendBtn,\r\n  .wa-micBtn {\r\n    width: 42px;\r\n    height: 42px;\r\n    min-width: 42px;\r\n    min-height: 42px;\r\n  }\r\n}\r\n\r\n/* ----- Enviar conversa ao CRM (header) — verde sólido ----- */\r\n.wa-crmSendBtn {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: 6px;\r\n  padding: 0 10px 0 8px !important;\r\n  min-width: auto !important;\r\n  width: auto !important;\r\n  height: 36px !important;\r\n  border-radius: 10px !important;\r\n  border: 1px solid transparent !important;\r\n  background: var(--wa-accent, #059669) !important;\r\n  color: #fff !important;\r\n  font-size: 12px !important;\r\n  font-weight: 700 !important;\r\n  letter-spacing: 0.02em;\r\n  transition: background 0.15s ease, box-shadow 0.15s ease, transform 0.12s ease;\r\n}\r\n\r\n.wa-crmSendBtn:hover:not(:disabled) {\r\n  background: color-mix(in srgb, var(--wa-accent, #059669) 88%, #000) !important;\r\n  box-shadow: 0 4px 14px color-mix(in srgb, var(--wa-accent, #059669) 42%, transparent) !important;\r\n}\r\n\r\n.wa-crmSendBtn:disabled {\r\n  opacity: 0.55;\r\n  cursor: not-allowed;\r\n}\r\n\r\n.wa-crmSendBtn--successPulse {\r\n  border-color: transparent !important;\r\n  color: #fff !important;\r\n  animation: waCrmSendSuccess 0.45s ease;\r\n}\r\n\r\n@keyframes waCrmSendSuccess {\r\n  0% {\r\n    transform: scale(0.98);\r\n  }\r\n  40% {\r\n    transform: scale(1.02);\r\n  }\r\n  100% {\r\n    transform: scale(1);\r\n  }\r\n}\r\n\r\n.wa-crmSendBtn-spinnerSvg {\r\n  display: block;\r\n  animation: waCrmSendSpin 0.7s linear infinite;\r\n}\r\n\r\n@keyframes waCrmSendSpin {\r\n  to {\r\n    transform: rotate(360deg);\r\n  }\r\n}\r\n\r\n.wa-crmSendBtn-icon {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n}\r\n\r\n.wa-crmSendBtn-label {\r\n  white-space: nowrap;\r\n}\r\n\r\n@media (max-width: 520px) {\r\n  .wa-crmSendBtn-label {\r\n    display: none;\r\n  }\r\n  .wa-crmSendBtn {\r\n    padding: 0 8px !important;\r\n  }\r\n}\r\n\r\n.wa-crmSendModal {\r\n  max-width: 420px;\r\n  width: calc(100vw - 32px);\r\n}\r\n\r\n.wa-crmSend-hint {\r\n  margin: 0 0 12px;\r\n  font-size: 13px;\r\n  line-height: 1.45;\r\n  color: var(--wa-text-muted, rgba(255, 255, 255, 0.55));\r\n}\r\n\r\n.wa-crmSend-label {\r\n  display: block;\r\n  font-size: 12px;\r\n  font-weight: 600;\r\n  margin-bottom: 6px;\r\n  color: var(--wa-text-secondary, rgba(255, 255, 255, 0.75));\r\n}\r\n\r\n.wa-crmSend-textarea {\r\n  width: 100%;\r\n  box-sizing: border-box;\r\n  min-height: 72px;\r\n  padding: 10px 12px;\r\n  border-radius: 10px;\r\n  border: 1px solid var(--wa-border, rgba(255, 255, 255, 0.12));\r\n  background: var(--wa-input-bg, rgba(0, 0, 0, 0.25));\r\n  color: inherit;\r\n  font-size: 14px;\r\n  font-family: inherit;\r\n  resize: vertical;\r\n}\r\n\r\n.wa-crmSend-textarea:focus {\r\n  outline: 2px solid color-mix(in srgb, var(--wa-accent, #00a884) 45%, transparent);\r\n  outline-offset: 1px;\r\n}\r\n\r\n.wa-crmSend-check {\r\n  display: flex;\r\n  align-items: flex-start;\r\n  gap: 10px;\r\n  margin-top: 12px;\r\n  font-size: 13px;\r\n  line-height: 1.4;\r\n  cursor: pointer;\r\n  color: var(--wa-text-secondary, rgba(255, 255, 255, 0.8));\r\n}\r\n\r\n.wa-crmSend-check input {\r\n  margin-top: 3px;\r\n  flex-shrink: 0;\r\n}\r\n\r\n.wa-productsQuickBtn {\r\n  font-size: 16px;\r\n}\r\n\r\n.wa-productsDrawer {\r\n  margin-left: auto;\r\n  height: 100%;\r\n  width: min(760px, 100vw);\r\n  background: var(--wa-panel);\r\n  border-left: 1px solid var(--wa-panel-border);\r\n  display: flex;\r\n  flex-direction: column;\r\n  padding: 14px;\r\n  gap: 12px;\r\n}\r\n\r\n.wa-productsDrawer-head {\r\n  display: flex;\r\n  align-items: flex-start;\r\n  justify-content: space-between;\r\n  gap: 12px;\r\n}\r\n\r\n.wa-productsDrawer-title {\r\n  margin: 0;\r\n  font-size: 18px;\r\n}\r\n\r\n.wa-productsDrawer-subtitle {\r\n  margin: 4px 0 0;\r\n  color: var(--wa-text-muted);\r\n  font-size: 13px;\r\n}\r\n\r\n.wa-productsToolbar {\r\n  display: grid;\r\n  grid-template-columns: 1fr auto;\r\n  gap: 12px;\r\n  align-items: center;\r\n}\r\n\r\n.wa-productsStockOnly {\r\n  display: inline-flex;\r\n  gap: 8px;\r\n  align-items: center;\r\n  font-size: 13px;\r\n  color: var(--wa-text-muted);\r\n}\r\n\r\n.wa-productsSyncCard {\r\n  border: 1px solid var(--wa-panel-border);\r\n  border-radius: 12px;\r\n  padding: 10px;\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 8px;\r\n  background: color-mix(in srgb, var(--wa-panel) 88%, #0ea5e9 12%);\r\n}\r\n\r\n.wa-productsSyncCard-top {\r\n  display: flex;\r\n  justify-content: space-between;\r\n  align-items: center;\r\n}\r\n\r\n.wa-productsSyncGrid {\r\n  display: grid;\r\n  grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));\r\n  gap: 6px 10px;\r\n  font-size: 12px;\r\n  color: var(--wa-text-muted);\r\n}\r\n\r\n.wa-productsSyncError,\r\n.wa-productsError {\r\n  border-radius: 10px;\r\n  border: 1px solid #f59e0b55;\r\n  background: #f59e0b1a;\r\n  color: #fbbf24;\r\n  padding: 10px;\r\n  font-size: 13px;\r\n}\r\n\r\n.wa-productsListWrap {\r\n  flex: 1;\r\n  min-height: 0;\r\n  overflow-y: auto;\r\n  border: 1px solid var(--wa-panel-border);\r\n  border-radius: 12px;\r\n  padding: 10px;\r\n}\r\n\r\n.wa-productsTable {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 10px;\r\n}\r\n\r\n.wa-productCard {\r\n  border: 1px solid var(--wa-panel-border);\r\n  bo