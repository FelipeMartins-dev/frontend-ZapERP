const __vite__css = "/* ==============================\n   LAYOUT E COMPONENTES\n   Tema definido em theme.css\n============================== */\n\n/* Atendimento Layout */\n.atendimento-layout {\n  height: 100vh;\n  height: 100dvh;\n  width: 100%;\n  display: grid;\n  /* Mais “WhatsApp Web”: sidebar um pouco maior, responsiva */\n  grid-template-columns: clamp(320px, 28vw, 380px) 1fr;\n  background: linear-gradient(135deg, var(--ds-bg-base) 0%, var(--ds-bg-raised) 100%);\n  overflow: hidden;\n  font-family: \"Segoe UI\", \"Inter\", system-ui, -apple-system, Roboto, sans-serif;\n  -webkit-font-smoothing: antialiased;\n  -moz-osx-font-smoothing: grayscale;\n}\n\n/* Tablet / iPad (641–1024px): equilíbia sidebar legível e área do chat (mobile usa regra própria abaixo) */\n@media (min-width: 641px) and (max-width: 1024px) {\n  .atendimento-layout {\n    grid-template-columns: minmax(292px, min(37vw, 356px)) minmax(0, 1fr);\n  }\n}\n\n/* Refino 740–1024px: prioriza largura útil do painel de mensagens */\n@media (min-width: 740px) and (max-width: 1024px) {\n  .atendimento-layout {\n    grid-template-columns: minmax(300px, min(34vw, 332px)) minmax(0, 1fr);\n  }\n}\n\n/* Mobile (<640px) — uma tela por vez, estilo WhatsApp */\n@media (max-width: 640px) {\n  .atendimento-layout {\n    grid-template-columns: 1fr;\n    grid-template-rows: 1fr;\n    width: 100%;\n    max-width: 100vw;\n    height: 100%;\n    min-height: 100dvh;\n    overflow: hidden;\n    padding: 0;\n    margin: 0;\n  }\n\n  .atendimento-layout .atendimento-sidebar {\n    display: flex;\n    width: 100%;\n    min-width: 0;\n  }\n\n  .atendimento-layout .atendimento-chat-area {\n    display: none;\n    width: 100%;\n    min-width: 0;\n  }\n\n  .atendimento-layout.conversation-open .atendimento-sidebar {\n    display: none;\n  }\n\n  .atendimento-layout.conversation-open .atendimento-chat-area {\n    display: flex;\n  }\n}\n\n/* Mobile estreito (480px) — 100% tela, safe-area lateral, visual WhatsApp\n   Sem padding-bottom extra: main-content já reserva barra inferior (56px) + safe-area;\n   evita faixa vazia duplicada entre composer e nav no PWA / standalone. */\n@media (max-width: 480px) {\n  .atendimento-layout {\n    width: 100%;\n    max-width: 100vw;\n    height: 100%;\n    padding-left: env(safe-area-inset-left, 0);\n    padding-right: env(safe-area-inset-right, 0);\n  }\n\n  .atendimento-sidebar,\n  .atendimento-chat-area {\n    padding-left: env(safe-area-inset-left, 0);\n    padding-right: env(safe-area-inset-right, 0);\n  }\n}\n\n.atendimento-sidebar {\n  display: flex;\n  flex-direction: column;\n  min-height: 0;\n  overflow: hidden;\n  background: var(--ds-surface-1);\n  border-right: 1px solid var(--ds-border);\n  position: relative;\n  z-index: 2;\n}\n\n[data-theme=\"dark\"] .atendimento-sidebar {\n  background: #0d1117;\n}\n\n.atendimento-chat-area {\n  display: flex;\n  flex-direction: column;\n  min-height: 0;\n  overflow: hidden;\n  background: var(--ds-chat-bg);\n  position: relative;\n  isolation: isolate;\n}\n\n.atendimento-chat-area::before {\n  content: \"\";\n  position: absolute;\n  inset: 0;\n  z-index: 0;\n  pointer-events: none;\n  background:\n    radial-gradient(circle at 18% 10%, rgba(0, 168, 132, 0.12), transparent 32%),\n    radial-gradient(circle at 88% 18%, rgba(14, 165, 233, 0.09), transparent 34%),\n    linear-gradient(180deg, rgba(255, 255, 255, 0.035), transparent 38%, rgba(0, 0, 0, 0.18));\n  opacity: 0.62;\n}\n\n.atendimento-chat-area > * {\n  position: relative;\n  z-index: 1;\n}\n\n/* Mobile: sidebar e chat-area preenchem 100% da tela fixa */\n@media (max-width: 640px) {\n  .atendimento-sidebar,\n  .atendimento-chat-area {\n    height: 100%;\n    min-height: 0;\n  }\n\n  /* Shell da conversa ocupa toda a área e mostra o cabeçalho no topo */\n  .atendimento-chat-area > * {\n    flex: 1 1 0%;\n    min-height: 0;\n    display: flex;\n    flex-direction: column;\n  }\n}\n\n/* ==============================\n   ANIMAÇÕES SUAVES (PRO)\n============================== */\n\n@keyframes waFadeUp {\n  from { opacity: 0; transform: translateY(6px); }\n  to { opacity: 1; transform: translateY(0); }\n}\n\n@keyframes waPop {\n  0% { transform: scale(0.98); opacity: 0; }\n  100% { transform: scale(1); opacity: 1; }\n}\n\n@keyframes waPulse {\n  0% { opacity: .55; }\n  50% { opacity: 1; }\n  100% { opacity: .55; }\n}\n\n/* ==============================\n   RESET\n============================== */\n\n* {\n  box-sizing: border-box;\n}\n\n/* Transições leves — WhatsApp: rápidas, suaves, sistema fluido */\n:where(button, a, input, textarea, select, [role=\"button\"]) {\n  transition:\n    background var(--ds-transition, 0.12s ease),\n    color var(--ds-transition, 0.12s ease),\n    border-color var(--ds-transition, 0.12s ease),\n    box-shadow var(--ds-transition, 0.12s ease),\n    transform var(--ds-transition-fast, 0.08s ease),\n    opacity var(--ds-transition, 0.12s ease);\n  -webkit-tap-highlight-color: transparent;\n}\n\n/* Feedback de clique — leve, tipo WhatsApp (não poluído) */\n:where(button, [role=\"button\"]):active:not(:disabled) {\n  transform: scale(0.98);\n}\n\n:where(button, a, input, textarea, select, [role=\"button\"]):focus-visible {\n  outline: 2px solid var(--ds-focus-ring);\n  outline-offset: 2px;\n}\n\n@media (prefers-reduced-motion: reduce) {\n  :where(button, a, input, textarea, select, [role=\"button\"]) {\n    transition-duration: 0s !important;\n  }\n  :where(button, [role=\"button\"]):active:not(:disabled) {\n    transform: none;\n  }\n}\n\nbody {\n  margin: 0;\n  font-family: \"Segoe UI\", \"Inter\", system-ui, -apple-system, Roboto, sans-serif;\n  background: var(--bg-app);\n  color: var(--text);\n  -webkit-font-smoothing: antialiased;\n  -moz-osx-font-smoothing: grayscale;\n}\n\n/* Mobile: scroll da página liberado no CRM; “app fullscreen” só no Atendimento */\n@media (max-width: 640px) {\n  html {\n    overflow-x: hidden;\n  }\n\n  body {\n    width: 100%;\n    max-width: 100vw;\n    overflow-x: hidden;\n    min-height: 100vh;\n    min-height: 100dvh;\n    -webkit-overflow-scrolling: touch;\n  }\n\n  html:has(.atendimento-layout),\n  body:has(.atendimento-layout) {\n    height: 100%;\n    overflow: hidden;\n    overscroll-behavior: none;\n  }\n\n  body:has(.atendimento-layout) #root {\n    height: 100%;\n    min-height: 0;\n    overflow: hidden;\n  }\n\n  #root {\n    min-height: 0;\n  }\n}\n\n@media (max-width: 480px) {\n  html,\n  body {\n    min-height: 100vh;\n    min-height: 100dvh;\n  }\n}\n\n/* ==============================\n   LAYOUT\n============================== */\n\n.app-layout {\n  display: flex;\n  height: 100vh;\n}\n\n/* Melhor suporte a mobile (barra do navegador) */\n@supports (height: 100dvh) {\n  .app-layout {\n    height: 100dvh;\n  }\n  .atendimento-layout {\n    height: 100dvh;\n  }\n  .login-wrap {\n    min-height: 100dvh;\n  }\n}\n\n/* SIDEBAR — Premium, consistente com Design System */\n.sidebar {\n  width: 64px;\n  background: var(--ds-surface-1);\n  border-right: 1px solid var(--ds-border);\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  padding: 12px 0;\n  gap: 4px;\n}\n\n.sidebar-spacer {\n  flex: 1;\n  min-height: 12px;\n}\n\n.sidebar-nav-item,\n.sidebar-logout,\n.sidebar-theme-toggle {\n  width: 40px;\n  height: 40px;\n  border-radius: var(--ds-radius-md);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  color: var(--ds-text-secondary);\n  background: transparent;\n  border: none;\n  cursor: pointer;\n  text-decoration: none;\n  transition: background 0.12s ease, color 0.12s ease, transform 0.08s ease;\n}\n\n.sidebar-nav-item:hover,\n.sidebar-logout:hover,\n.sidebar-theme-toggle:hover {\n  background: var(--ds-hover);\n  color: var(--ds-text-primary);\n}\n\n.sidebar-nav-item:active,\n.sidebar-logout:active,\n.sidebar-theme-toggle:active {\n  transform: scale(0.96);\n}\n\n.sidebar-nav-item.active {\n  background: var(--ds-accent-soft);\n  color: var(--ds-accent);\n}\n\n/* Bolinha verde “app notification” — quando MainLayout passa unreadDot (ex.: atendimento no mobile, chat interno). */\n.sidebar-nav-iconWrap {\n  position: relative;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  flex-shrink: 0;\n}\n\n.sidebar-nav-unreadDot {\n  position: absolute;\n  top: -3px;\n  right: -4px;\n  width: 9px;\n  height: 9px;\n  border-radius: 50%;\n  pointer-events: none;\n  background: radial-gradient(circle at 35% 28%, #6ee7b7, #059669);\n  box-shadow:\n    0 0 0 2px var(--ds-surface-1),\n    0 2px 6px rgba(5, 150, 105, 0.45);\n  animation: zapUnreadDotPulse 2.5s ease-in-out infinite;\n}\n\n@keyframes zapUnreadDotPulse {\n  0%,\n  100% {\n    opacity: 1;\n    transform: scale(1);\n  }\n  50% {\n    opacity: 0.9;\n    transform: scale(1.06);\n  }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .sidebar-nav-unreadDot {\n    animation: none;\n  }\n}\n\n[data-theme=\"dark\"] .sidebar-nav-unreadDot {\n  background: radial-gradient(circle at 35% 28%, #4ade80, #166534);\n  box-shadow:\n    0 0 0 2px var(--ds-surface-1),\n    0 2px 10px rgba(34, 197, 94, 0.35);\n}\n\n@media (max-width: 768px) {\n  .app-layout--crm .sidebar-nav-unreadDot {\n    top: -2px;\n    right: -3px;\n    width: 8px;\n    height: 8px;\n  }\n}\n\n.sidebar-logout:hover {\n  background: var(--ds-hover);\n}\n\n/* CONTEÚDO */\n.main-content {\n  flex: 1;\n  min-height: 0;\n  background: var(--bg-surface);\n  overflow-y: auto;\n  overflow-x: hidden;\n}\n\n/* Chat interno: evita rolagem dupla no main e preenche a área útil */\n.main-content:has(.internal-chat-root) {\n  overflow: hidden;\n  display: flex;\n  flex-direction: column;\n}\n\n.main-content .internal-chat-root {\n  flex: 1 1 0%;\n  min-height: 0;\n}\n\n/* ==============================\n   CRM — Sidebar compacta (só ícones no canto)\n============================== */\n\n.sidebar--compact {\n  width: 56px;\n  min-width: 56px;\n  align-items: center;\n  padding: 12px 0;\n  gap: 4px;\n}\n\n.sidebar-brand-compact {\n  width: 40px;\n  height: 40px;\n  border-radius: 10px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  margin-bottom: 8px;\n  background: transparent;\n  color: inherit;\n}\n\n.sidebar-brand-compact .zpl-mark {\n  width: 32px;\n  height: 32px;\n}\n\n.sidebar-brand-compact .zpl-svg {\n  width: 24px;\n  height: 24px;\n}\n\n.sidebar-brand-icon {\n  font-size: 18px;\n  font-weight: 700;\n}\n\n.sidebar-nav--compact {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  gap: 2px;\n}\n\n.sidebar-nav--compact .sidebar-nav-item {\n  width: 40px;\n  height: 40px;\n  justify-content: center;\n  padding: 0;\n  border-radius: 10px;\n}\n\n.sidebar-nav--compact .sidebar-nav-label {\n  display: none;\n}\n\n.sidebar-nav--compact .sidebar-nav-icon {\n  margin: 0;\n}\n\n.sidebar-footer--compact {\n  flex-direction: column;\n  align-items: center;\n  gap: 6px;\n  padding-top: 8px;\n  border-top: 1px solid var(--ds-border);\n}\n\n.sidebar-badge-compact {\n  width: 28px;\n  height: 28px;\n  border-radius: var(--ds-radius);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  font-size: 12px;\n  font-weight: 700;\n  color: var(--ds-accent);\n  background: var(--ds-accent-soft);\n}\n\n/* ==============================\n   SIDEBAR V2 — ZapERP rail (52px, Tabler icons)\n============================== */\n\n.sidebar--v2 {\n  --sidebar-v2-bg: #f8f9fc;\n  --sidebar-v2-border: rgba(15, 23, 42, 0.08);\n  --sidebar-v2-icon: #5e6478;\n  --sidebar-v2-icon-hover-bg: #eef1f6;\n  --sidebar-v2-icon-hover: #3d4558;\n  --sidebar-v2-active-bg: rgba(0, 168, 132, 0.14);\n  --sidebar-v2-active-color: #059669;\n  --sidebar-v2-divider-color: rgba(15, 23, 42, 0.1);\n  --sidebar-v2-unread-ring: #f8f9fc;\n\n  width: 52px;\n  min-width: 52px;\n  background: var(--sidebar-v2-bg);\n  border-right: 1px solid var(--sidebar-v2-border);\n  padding: 10px 0 8px;\n  gap: 2px;\n}\n\n[data-theme=\"dark\"] .sidebar--v2 {\n  --sidebar-v2-bg: #0d1017;\n  --sidebar-v2-border: rgba(255, 255, 255, 0.06);\n  --sidebar-v2-icon: #4e5470;\n  --sidebar-v2-icon-hover-bg: #1a1e2d;\n  --sidebar-v2-icon-hover: #9095ae;\n  --sidebar-v2-active-bg: #1b3a3a;\n  --sidebar-v2-active-color: #2dd4aa;\n  --sidebar-v2-divider-color: rgba(255, 255, 255, 0.08);\n  --sidebar-v2-unread-ring: #0d1017;\n}\n\n.sidebar--v2 .sidebar-nav--v2 {\n  gap: 4px;\n}\n\n.sidebar--v2 .sidebar-nav-item,\n.sidebar--v2 .sidebar-logout,\n.sidebar--v2 .sidebar-theme-toggle {\n  width: 36px;\n  height: 36px;\n  border-radius: 10px;\n  color: var(--sidebar-v2-icon);\n  background: transparent;\n  transition: background 0.12s ease, color 0.12s ease;\n}\n\n.sidebar--v2 .sidebar-nav-item:hover,\n.sidebar--v2 .sidebar-logout:hover,\n.sidebar--v2 .sidebar-theme-toggle:hover {\n  background: var(--sidebar-v2-icon-hover-bg);\n  color: var(--sidebar-v2-icon-hover);\n}\n\n.sidebar--v2 .sidebar-nav-item.active {\n  background: var(--sidebar-v2-active-bg);\n  color: var(--sidebar-v2-active-color);\n}\n\n.sidebar--v2 .sidebar-nav-icon {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  width: 17px;\n  height: 17px;\n}\n\n.sidebar--v2 .sidebar-nav-icon svg {\n  width: 17px;\n  height: 17px;\n  display: block;\n}\n\n.sidebar--v2 .sidebar-nav-unreadDot {\n  box-shadow:\n    0 0 0 2px var(--sidebar-v2-unread-ring),\n    0 2px 6px rgba(45, 212, 170, 0.45);\n}\n\n.sidebar-footer--v2 {\n  width: 100%;\n  border-top: none;\n  padding-top: 0;\n  gap: 4px;\n}\n\n.sidebar-v2-divider {\n  width: calc(100% - 16px);\n  height: 1px;\n  margin: 2px 0 6px;\n  border: none;\n  background: var(--sidebar-v2-divider-color);\n  flex-shrink: 0;\n}\n\n.sidebar--v2 .sidebar-user-avatar {\n  width: 32px;\n  height: 32px;\n  border-radius: 8px;\n  background: #2f5af0;\n  color: #ffffff;\n  font-size: 13px;\n  font-weight: 700;\n  line-height: 1;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  flex-shrink: 0;\n  user-select: none;\n  cursor: default;\n}\n\n@media (max-width: 768px) {\n  .app-layout--crm .sidebar--v2 {\n    width: 100%;\n    min-width: 0;\n    background: var(--sidebar-v2-bg);\n    border-top: 1px solid var(--sidebar-v2-border);\n    border-right: none;\n  }\n\n  .app-layout--crm .sidebar--v2 .sidebar-v2-divider {\n    display: none;\n  }\n}\n\n/* ==============================\n   RESPONSIVIDADE MOBILE\n============================== */\n\n/* Breakpoint principal: tablet/mobile — sidebar vira barra inferior */\n@media (max-width: 768px) {\n  .app-layout {\n    flex-direction: column;\n    padding-bottom: 0;\n  }\n\n  .sidebar {\n    position: fixed;\n    bottom: 0;\n    left: 0;\n    right: 0;\n    width: 100%;\n    height: 56px;\n    min-height: 56px;\n    padding-bottom: env(safe-area-inset-bottom, 0);\n    flex-direction: row;\n    justify-content: space-around;\n    padding: 8px 8px calc(12px + env(safe-area-inset-bottom, 0));\n    border-right: none;\n    border-top: 1px solid var(--ds-border);\n    z-index: 100;\n    gap: 0;\n  }\n\n  /* Barra inferior: scroll horizontal para ver todos os itens + tema + Deslogar */\n  .app-layout--crm .sidebar--compact {\n    width: 100%;\n    height: auto;\n    min-height: 60px;\n    max-height: none;\n    flex-direction: row;\n    flex-wrap: nowrap;\n    align-items: stretch;\n    justify-content: flex-start;\n    gap: 8px;\n    padding: 6px 12px calc(10px + env(safe-area-inset-bottom, 0));\n    overflow-x: auto;\n    overflow-y: hidden;\n    overscroll-behavior-x: contain;\n    -webkit-overflow-scrolling: touch;\n    scrollbar-width: thin;\n    border-top: 1px solid rgba(0, 0, 0, 0.06);\n  }\n\n  .app-layout--crm .sidebar-nav--compact {\n    display: flex;\n    flex-direction: row;\n    flex: 0 0 auto;\n    flex-wrap: nowrap;\n    justify-content: flex-start;\n    align-items: stretch;\n    gap: 8px;\n    margin: 0;\n    min-width: min-content;\n  }\n\n  .app-layout--crm .sidebar-footer--compact {\n    display: flex;\n    flex-direction: row;\n    flex: 0 0 auto;\n    flex-shrink: 0;\n    flex-wrap: nowrap;\n    align-items: stretch;\n    gap: 8px;\n    padding-top: 0;\n    border-top: none;\n  }\n\n  /* Mobile: ícone + texto — largura fixa mínima para encaixar no scroll */\n  .app-layout--crm .sidebar-nav--compact .sidebar-nav-item,\n  .app-layout--crm .sidebar-footer--compact .sidebar-theme-toggle,\n  .app-layout--crm .sidebar-footer--compact .sidebar-logout {\n    width: auto;\n    height: auto;\n    min-height: 54px;\n    flex: 0 0 auto;\n    min-width: 56px;\n    max-width: 78px;\n    border-radius: 12px;\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    justify-content: center;\n    gap: 4px;\n    padding: 4px 2px;\n  }\n\n  .app-layout--crm .sidebar-nav--compact .sidebar-nav-label {\n    display: -webkit-box;\n    -webkit-box-orient: vertical;\n    -webkit-line-clamp: 2;\n    overflow: hidden;\n    font-size: 9px;\n    line-height: 1.1;\n    color: var(--ds-text-tertiary);\n    white-space: normal;\n    text-align: center;\n    max-width: 64px;\n    word-break: break-word;\n    hyphens: auto;\n  }\n\n  [data-theme=\"dark\"] .app-layout--crm .sidebar-nav--compact .sidebar-nav-label,\n  [data-theme=\"dark\"] .app-layout--crm .sidebar-footer--compact .sidebar-nav-label {\n    color: var(--ds-text-secondary);\n  }\n\n  .app-layout--crm .sidebar-brand-compact,\n  .app-layout--crm .sidebar-spacer,\n  .app-layout--crm .sidebar-badge-compact {\n    display: none;\n  }\n\n  /* Rótulo \"Deslogar\" / tema na barra inferior */\n  .app-layout--crm .sidebar-footer--compact .sidebar-nav-label {\n    display: -webkit-box;\n    -webkit-box-orient: vertical;\n    -webkit-line-clamp: 2;\n    overflow: hidden;\n    font-size: 9px;\n    line-height: 1.1;\n    color: var(--ds-text-tertiary);\n    white-space: normal;\n    text-align: center;\n    max-width: 56px;\n    word-break: break-word;\n    hyphens: auto;\n  }\n\n  .sidebar-spacer {\n    display: none;\n  }\n\n  .sidebar-nav-item,\n  .sidebar-logout,\n  .sidebar-theme-toggle {\n    width: 48px;\n    height: 48px;\n    flex: 0 0 auto;\n  }\n\n  /* Atendimento (lista visível): barra inferior um pouco mais alta para toque e leitura */\n  .app-layout:has(.atendimento-layout:not(.conversation-open)).app-layout--crm .sidebar-nav--compact .sidebar-nav-item,\n  .app-layout:has(.atendimento-layout:not(.conversation-open)).app-layout--crm .sidebar-footer--compact .sidebar-theme-toggle,\n  .app-layout:has(.atendimento-layout:not(.conversation-open)).app-layout--crm .sidebar-footer--compact .sidebar-logout {\n    min-height: 62px;\n    min-width: 62px;\n    max-width: 90px;\n    padding: 6px 4px;\n    gap: 5px;\n  }\n\n  .app-layout:has(.atendimento-layout:not(.conversation-open)).app-layout--crm .sidebar-nav--compact .sidebar-nav-label,\n  .app-layout:has(.atendimento-layout:not(.conversation-open)).app-layout--crm .sidebar-footer--compact .sidebar-nav-label {\n    font-size: 10px;\n    max-width: 74px;\n    line-height: 1.12;\n  }\n\n  .app-layout {\n    height: 100vh;\n    height: 100dvh;\n    min-height: 0;\n    overflow: hidden;\n  }\n\n  .main-content {\n    flex: 1;\n    min-height: 0;\n    overflow-y: auto;\n    overflow-x: hidden;\n    -webkit-overflow-scrolling: touch;\n    padding-bottom: calc(56px + env(safe-area-inset-bottom, 0));\n    padding-top: env(safe-area-inset-top, 0);\n    height: 100%;\n  }\n\n  /* Barra CRM com scroll pode ficar um pouco mais alta (ícone + 2 linhas de rótulo) */\n  .main-content.main-content--crm {\n    padding-bottom: calc(84px + env(safe-area-inset-bottom, 0));\n  }\n\n  /* Lista de atendimento: barra inferior um pouco mais alta — evita corte na última linha da lista */\n  .main-content.main-content--crm:has(.atendimento-layout:not(.conversation-open)) {\n    padding-bottom: calc(92px + env(safe-area-inset-bottom, 0));\n  }\n\n  /* Atendimento: rolagem só dentro do layout (lista + chat), não no main */\n  .main-content:has(.atendimento-layout) {\n    o