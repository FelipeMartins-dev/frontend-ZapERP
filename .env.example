# URL da API do backend (produção)
VITE_API_URL=https://zaperpapi.wmsistemas.inf.br

# Desenvolvimento local: copie `.env.development.local.example` → `.env.development.local`
# e use a MESMA porta do backend (`PORT` em backend/.env).
#
# Exemplos:
#   VITE_API_URL=http://localhost:3000
#   VITE_API_URL=http://localhost:5000
#
# Alternativa: só a porta (fallback quando VITE_API_URL estiver vazio no dev):
#   VITE_BACKEND_PORT=5000
#
# O proxy do Vite (/uploads, /media) segue automaticamente VITE_API_URL ou VITE_BACKEND_PORT.
# API + Socket.IO usam getApiBaseUrl() com a mesma regra.

# Cookies/sessão com CORS: só ative se o backend enviar Access-Control-Allow-Credentials e origin explícito
# VITE_WITH_CREDENTIALS=1

# Alertas de atendimento (rotas /config/alerta-sem-resposta no backend).
# Defina como 0/false enquanto o backend de producao ainda nao publicar essas rotas — evita 404 no console.
# VITE_ALERTA_SEM_RESPOSTA_ENABLED=0
