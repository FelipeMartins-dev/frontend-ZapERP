# URL da API do backend (produção)
VITE_API_URL=https://zaperpapi.wmsistemas.inf.br

# Desenvolvimento local: crie `.env.development.local` (gitignored) com:
# VITE_API_URL=http://localhost:3000
#
# Se VITE_API_URL não estiver definido e o frontend rodar em localhost,
# o app usa automaticamente http://localhost:3000 (PORT padrão do backend).

# Cookies/sessão com CORS: só ative se o backend enviar Access-Control-Allow-Credentials e origin explícito
# VITE_WITH_CREDENTIALS=1
